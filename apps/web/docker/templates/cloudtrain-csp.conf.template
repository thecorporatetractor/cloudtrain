# Content-Security-Policy. The CT_CSP_* variables add sources (space-separated,
# e.g. CT_CSP_CONNECT_SRC="https://api.labs.example.com wss://api.labs.example.com"
# when the API is on another origin); empty by default. No inline scripts or eval:
# index.html loads theme-init.js and runtime-config.js as files.
add_header Content-Security-Policy "default-src 'self'; script-src 'self' ${CT_CSP_SCRIPT_SRC}; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: ${CT_CSP_IMG_SRC}; font-src 'self' data:; connect-src 'self' ${CT_CSP_CONNECT_SRC}; frame-src 'self' ${CT_CSP_FRAME_SRC}; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
