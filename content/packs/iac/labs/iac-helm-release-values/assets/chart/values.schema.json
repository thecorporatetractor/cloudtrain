{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["title", "replicas", "farms"],
  "properties": {
    "title": {"type": "string", "minLength": 1},
    "replicas": {"type": "integer", "minimum": 1},
    "farms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "turbines", "capacityMw"],
        "properties": {
          "name": {"type": "string"},
          "turbines": {"type": "integer"},
          "capacityMw": {"type": "integer"}
        }
      }
    }
  }
}
