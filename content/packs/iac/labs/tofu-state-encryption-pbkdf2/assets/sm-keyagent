#!/bin/sh
# sm-keyagent: Saltmarsh's key agent for OpenTofu (external key provider protocol v1).
# Hands out the trading desk's current 256-bit state key from the agent's key store.
set -e
k=$(cat "$HOME/.config/sm-keyagent/key")
echo '{"magic":"OpenTofu-External-Key-Provider","version":1}'
INPUT=$(cat)
if [ "$(echo $INPUT)" = "null" ]; then
  printf '{"keys":{"encryption_key":"%s"},"meta":{"external_data":{"key_id":"trading-2026-10"}}}\n' "$k"
else
  printf '{"keys":{"encryption_key":"%s","decryption_key":"%s"},"meta":{"external_data":{"key_id":"trading-2026-10"}}}\n' "$k" "$k"
fi
