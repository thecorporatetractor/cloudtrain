# Quillmoor ledger etcd (single member). Installed by provision-etcd.sh.
[Unit]
Description=etcd key-value store (ledger)
Documentation=https://etcd.io/docs/
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
User=etcd
Group=etcd
ExecStart=/usr/local/bin/etcd \
  --name=ledger-etcd \
  --data-dir=/var/lib/etcd \
  --listen-client-urls=https://127.0.0.1:2379 \
  --advertise-client-urls=https://127.0.0.1:2379 \
  --listen-peer-urls=http://127.0.0.1:2380 \
  --initial-advertise-peer-urls=http://127.0.0.1:2380 \
  --initial-cluster=ledger-etcd=http://127.0.0.1:2380 \
  --client-cert-auth=true \
  --trusted-ca-file=/etc/qm-etcd/pki/ca.crt \
  --cert-file=/etc/qm-etcd/pki/server.crt \
  --key-file=/etc/qm-etcd/pki/server.key
Restart=on-failure
RestartSec=3
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
