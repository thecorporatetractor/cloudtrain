# waybill-api: prints and validates waybills for the depot scanners.
FROM registry.quillmoor.example/mirror/golang:1.25
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -o /usr/local/bin/waybill-api ./cmd/waybill-api
RUN apt-get update && apt-get install -y curl vim-tiny
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/waybill-api"]
