#!/bin/bash
# platform-board: render the departure board for one station from the timetable.
# Usage: platform-board STATION
station=${1:?usage: platform-board STATION}
src=/srv/timetable/today.csv
out="$HOME/boards/$station.board"
mkdir -p "$HOME/boards"
{
  printf '%-6s %-5s %s\n' TRAIN TIME PLATFORM
  awk -F, -v s="$station" '$2 == s {printf "%-6s %-5s %s\n", $1, $3, $4}' "$src" | sort -k2
} > "$out"
echo "board written to $out"
