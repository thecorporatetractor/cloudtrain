#!/bin/bash
# tr-fares-export: nightly fares export (training build). Takes about three hours:
# writes one batch of fares every 30 seconds to ~/exports/fares-<run>.partial and a
# progress line per batch on standard output.
run=${1:-nightly}
out="$HOME/exports/fares-$run.partial"
mkdir -p "$HOME/exports"
: > "$out"
for batch in $(seq 1 360); do
  printf 'batch %03d: %d fares\n' "$batch" $((batch * 37 % 900 + 100)) >> "$out"
  echo "tr-fares-export[$run]: batch $batch/360 written"
  sleep 30
done
mv "$out" "${out%.partial}.csv"
echo "tr-fares-export[$run]: done"
