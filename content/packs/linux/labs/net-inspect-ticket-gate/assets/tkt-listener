#!/usr/bin/python3
# Ticket-gate service stub (training build): binds the given sockets and idles.
# Usage: <name> tcp|udp ADDRESS PORT
import socket, sys, time
kind, addr, port = sys.argv[1], sys.argv[2], int(sys.argv[3])
s = socket.socket(socket.AF_INET, socket.SOCK_STREAM if kind == "tcp" else socket.SOCK_DGRAM)
s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
s.bind((addr, port))
if kind == "tcp":
    s.listen(8)
while True:
    time.sleep(3600)
