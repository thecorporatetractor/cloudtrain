#!/bin/bash
# tr-crewshift N: read a roster CSV (header + "duty,crew" rows) on stdin and print it
# with the crew column rotated down by N places. A row without a crew is an error:
# like the real tool, it has already printed the rows before it when it fails.
n=${1:?usage: tr-crewshift N}
IFS= read -r header || exit 4
duties=(); crews=()
while IFS=, read -r duty crew; do duties+=("$duty"); crews+=("$crew"); done
echo "$header"
c=${#crews[@]}
for ((i = 0; i < c; i++)); do
  j=$(( (i - n % c + c) % c ))
  if [ -z "${crews[$j]}" ]; then echo "tr-crewshift: row $((j + 2)) has no crew" >&2; exit 3; fi
  echo "${duties[$i]},${crews[$j]}"
done
