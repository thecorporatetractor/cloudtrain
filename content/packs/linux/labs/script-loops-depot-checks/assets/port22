#!/usr/bin/python3
# Training stub for depot hosts on ADDRESS:22.
#   port22 ADDRESS          accept connections, say hello, close
#   port22 ADDRESS silent   a host that never answers: the listen queue is kept full,
#                           so further connection attempts get no reply at all
import socket, sys, time
addr = sys.argv[1]
s = socket.socket(); s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
s.bind((addr, 22))
if len(sys.argv) > 2 and sys.argv[2] == "silent":
    s.listen(0)
    held = []
    for _ in range(3):
        c = socket.socket(); c.setblocking(False)
        try:
            c.connect((addr, 22))
        except BlockingIOError:
            pass
        held.append(c)
    while True:
        time.sleep(3600)
s.listen(16)
while True:
    c, _ = s.accept()
    try:
        c.sendall(b"SSH-2.0-TallowmereDepot\r\n")
    finally:
        c.close()
