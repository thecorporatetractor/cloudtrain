#!/bin/bash
# sb-unlock LEVEL PASSWORD: unlock the next signal-box level with the password of
# the level before it. The level appears in ~/signalbox/levelLEVEL.
lvl=${1:?usage: sb-unlock LEVEL PASSWORD}; pw=${2:?usage: sb-unlock LEVEL PASSWORD}
pack=/usr/local/share/signalbox/level$lvl.pack
[ -r "$pack" ] || { echo "sb-unlock: no level $lvl here" >&2; exit 2; }
dest="$HOME/signalbox/level$lvl"
tmp=$(mktemp -d)
if openssl enc -d -aes-256-cbc -pbkdf2 -pass "pass:$pw" -in "$pack" 2>/dev/null | tar -xf - -C "$tmp" 2>/dev/null; then
  rm -rf "$dest"; mkdir -p "$dest"; cp -a "$tmp"/. "$dest"/; rm -rf "$tmp"
  echo "Level $lvl unlocked: cd $dest and read README"
else
  rm -rf "$tmp"; echo "sb-unlock: wrong password for level $lvl" >&2; exit 1
fi
