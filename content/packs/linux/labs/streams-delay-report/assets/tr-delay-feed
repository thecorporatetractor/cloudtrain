#!/bin/bash
# tr-delay-feed: Tallowmere Rail delay-feed collector (training build).
# Prints one line per delayed service on stdout and a warning per unreadable
# station sensor on stderr. Feed data: /usr/share/tr-delay/feed.dat.
set -u
data=/usr/share/tr-delay/feed.dat
[ -r "$data" ] || { echo "tr-delay-feed: cannot read $data" >&2; exit 2; }
# Run record for the operations team (where stdout/stderr went).
out=$(readlink /proc/$$/fd/1) err=$(readlink /proc/$$/fd/2)
state="$HOME/.local/state/tr-delay"
mkdir -p "$state" 2>/dev/null && printf 'stdout=%s\nstderr=%s\n' "$out" "$err" > "$state/last-run" 2>/dev/null
while IFS='|' read -r kind a b c; do
  case $kind in
    D) printf '%s %-4s delayed %3s min at %s\n' "$(date -u -d @1791100800 +%F)" "$a" "$b" "$c" ;;
    W) printf 'WARN sensor %s at %s unreadable (%s)\n' "$a" "$b" "$c" >&2 ;;
  esac
done < "$data"
