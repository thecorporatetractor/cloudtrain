{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "cloudtrain chart values",
  "type": "object",
  "additionalProperties": false,
  "required": ["host"],
  "definitions": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "repository": { "type": "string", "minLength": 1 }, "tag": { "type": "string" }, "digest": { "type": "string", "pattern": "^(sha256:[0-9a-f]{64})?$" } }
    },
    "stringList": { "type": "array", "items": { "type": "string" } },
    "sources": { "type": "string", "pattern": "^[^\";\\\\]*$" }
  },
  "properties": {
    "host": {
      "type": "string",
      "description": "Public host name; the OIDC redirect URI is https://<host>/api/auth/callback.",
      "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?(:[0-9]+)?$"
    },
    "global": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "imageRegistry": { "type": "string", "minLength": 1 },
        "imageTag": { "type": "string" },
        "imagePullPolicy": { "enum": ["", "Always", "IfNotPresent", "Never"] },
        "imagePullSecrets": { "$ref": "#/definitions/stringList" }
      }
    },
    "imagePullSecrets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" },
        "registry": { "type": "string" },
        "username": { "type": "string" },
        "token": { "type": "string" }
      }
    },
    "exposure": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["ingress", "gatewayAPI", "none"] },
        "ingress": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "className": { "type": "string" },
            "annotations": { "type": "object" },
            "pathType": { "enum": ["Prefix", "ImplementationSpecific"] }
          }
        },
        "gatewayAPI": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "parentRefs": { "type": "array", "items": { "type": "object", "required": ["name"] } },
            "annotations": { "type": "object" },
            "timeouts": { "type": "object" },
            "createGateway": { "type": "boolean" },
            "gatewayClassName": { "type": "string" },
            "gatewayAnnotations": { "type": "object" }
          }
        }
      }
    },
    "tls": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "mode": { "enum": ["secret", "certManager", "external"] },
        "secretName": { "type": "string" },
        "certManager": { "type": "object", "properties": { "issuerRef": { "type": "object", "required": ["name"] } } }
      }
    },
    "gateway": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "replicas": { "type": "integer", "minimum": 0 },
        "image": { "$ref": "#/definitions/image" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "sessionsNamespace": { "type": "string", "minLength": 1 },
        "capacity": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "maxSessionsPerLearner": { "type": "integer", "minimum": 0 },
            "maxActiveSessions": { "type": "integer", "minimum": 0 },
            "examReserve": { "type": "integer", "minimum": 0 }
          }
        },
        "trustProxy": { "type": "string" },
        "corsOrigins": { "type": "array", "items": { "type": "string", "pattern": "^https?://[^/]+$" } },
        "logLevel": { "enum": ["trace", "debug", "info", "warn", "error", "fatal"] },
        "oidc": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "issuer": { "type": "string" }, "clientId": { "type": "string", "minLength": 1 } }
        },
        "keycloak": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "url": { "type": "string" }, "realm": { "type": "string" }, "adminClientId": { "type": "string" } }
        },
        "platformIdps": { "type": "string" },
        "smtp": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "host": { "type": "string" }, "port": { "type": "integer" }, "from": { "type": "string" } }
        },
        "existingSecret": { "type": "string" },
        "secrets": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "create": { "type": "boolean" },
            "oidcClientSecret": { "type": "string" },
            "keycloakAdminClientSecret": { "type": "string" },
            "sessionSecret": { "type": "string" },
            "gdprHmacKey": { "type": "string" },
            "databaseUrl": { "type": "string" },
            "databaseOwnerUrl": { "type": "string" },
            "generate": { "type": "boolean" }
          }
        },
        "migrate": { "type": "boolean" },
        "migrateRetry": { "type": "integer", "minimum": 0 },
        "migrateMutableTag": { "type": "boolean" },
        "clusterCapacity": { "type": "boolean" },
        "extraEnv": { "type": "array" },
        "resources": { "type": "object" },
        "service": { "type": "object", "properties": { "annotations": { "type": "object" } } },
        "podAnnotations": { "type": "object" },
        "nodeSelector": { "type": "object" },
        "tolerations": { "type": "array" },
        "affinity": { "type": "object" }
      }
    },
    "web": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "replicas": { "type": "integer", "minimum": 0 },
        "image": { "$ref": "#/definitions/image" },
        "port": { "type": "integer", "minimum": 1024, "maximum": 65535 },
        "runtimeConfig": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "apiBase": { "type": "string", "pattern": "^(|https?://[^/\"'<>\\\\]+)$" },
            "environment": { "type": "string", "pattern": "^[^\"'<>\\\\]*$" },
            "siteUrl": { "type": "string", "pattern": "^(|https?://[^/\"'<>\\\\]+)$" }
          }
        },
        "csp": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "scriptSrc": { "$ref": "#/definitions/sources" },
            "connectSrc": { "$ref": "#/definitions/sources" },
            "imgSrc": { "$ref": "#/definitions/sources" },
            "frameSrc": { "$ref": "#/definitions/sources" }
          }
        },
        "resources": { "type": "object" },
        "service": { "type": "object", "properties": { "annotations": { "type": "object" } } },
        "podAnnotations": { "type": "object" },
        "nodeSelector": { "type": "object" },
        "tolerations": { "type": "array" },
        "affinity": { "type": "object" }
      }
    },
    "orchestrator": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "image": { "$ref": "#/definitions/image" },
        "watchNamespace": { "type": "string" },
        "sessionSelector": { "type": "string" },
        "maxConcurrentReconciles": { "type": "integer", "minimum": 1 },
        "provisionTimeout": { "type": "string", "pattern": "^(|([0-9]+(\\.[0-9]+)?(h|m|s|ms))+)$" },
        "vmDisks": { "enum": ["persistent", "ephemeral"] },
        "storageClass": { "type": "string" },
        "networkMode": { "enum": ["primary", "secondary"] },
        "runtimeClass": { "type": "string" },
        "isolation": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "kubeletLimitsAttested": { "type": "boolean" },
            "profile": { "enum": ["dev", "production"], "description": "production fails closed: the chart refuses to render without orchestrator.sandboxes, the manager refuses to start without them, and every lab pod runs in a sandbox RuntimeClass or a user namespace (never with host users on the host kernel)." }
          }
        },
        "labNodes": {
          "type": "object", "additionalProperties": false,
          "description": "The dedicated lab node pool: every lab pod, KubeVirt VM and vcluster (control plane and synced pods) gets this node selector and these tolerations.",
          "properties": {
            "nodeSelector": { "type": "object", "additionalProperties": { "type": "string" } },
            "tolerations": { "type": "array", "items": { "type": "string", "pattern": "^[A-Za-z0-9./_-]+(=[A-Za-z0-9._-]*)?(:(NoSchedule|PreferNoSchedule|NoExecute))?$" }, "description": "key[=value][:Effect], e.g. cloudtrain.dev/labs=true:NoSchedule" },
            "vclusterExtraTolerationKeys": { "type": "array", "items": { "type": "string" }, "description": "More toleration keys pods in vcluster host namespaces may carry, e.g. ones the tier V RuntimeClass's scheduling adds." }
          }
        },
        "sandboxes": {
          "type": "object",
          "propertyNames": { "enum": ["A", "B", "C", "K", "V", "N"] },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["runtimeClass"],
            "properties": {
              "runtimeClass": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$", "maxLength": 253 },
              "fallback": { "enum": ["kubevirt", "fail"] },
              "requiredFeatures": { "type": "array", "items": { "enum": ["dummy", "gre", "bond", "vlan", "wireguard", "netem", "md"] } },
              "scaleFromZero": { "type": "boolean" }
            }
          }
        },
        "sandboxPreflightConfigMap": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$" },
        "tierRuntimeClasses": {
          "type": "object",
          "propertyNames": { "enum": ["A", "B", "C", "K", "V", "N"] },
          "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "vclusterPodSecurity": { "enum": ["baseline", "restricted"] },
        "failedSessionReleaseMinutes": { "type": "integer", "minimum": 0 },
        "nodePreflightConfigMap": { "type": "string" },
        "vclusterPodCIDRs": { "type": "array", "items": { "type": "string", "pattern": "^[0-9a-fA-F:.]+/[0-9]{1,3}$" } },
        "catalog": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "opentofu": { "type": "boolean" },
            "releaseOverlay": { "type": "string" },
            "overlays": { "type": "object", "additionalProperties": { "type": "string" } }
          }
        },
        "images": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "registry": { "type": "string" },
            "mirrors": { "type": "array", "items": { "type": "string", "pattern": "^[^=\\s,]+=[^=\\s,]+$" } },
            "pullSecrets": { "$ref": "#/definitions/stringList" }
          }
        },
        "rbac": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "admissionPolicy": { "type": "boolean" },
            "ovnCentral": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": { "type": "boolean" },
                "namespace": { "type": "string", "minLength": 1 },
                "selector": { "type": "string", "pattern": "^[^=\\s/]+=[^=\\s/]+$" }
              }
            }
          }
        },
        "extraArgs": { "$ref": "#/definitions/stringList" },
        "resources": { "type": "object" },
        "nodeSelector": { "type": "object" },
        "tolerations": { "type": "array" },
        "affinity": { "type": "object" }
      }
    },
    "sessions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "createNamespace": { "type": "boolean" },
        "podSecurity": { "enum": ["privileged", "baseline", "restricted"] },
        "limitRange": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "defaultRequest": { "type": "object", "additionalProperties": { "type": ["string", "number"] } }
          }
        },
        "quota": { "type": "object", "additionalProperties": { "type": ["string", "number"] } }
      }
    },
    "postgres": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "demo": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "enabled": { "type": "boolean" }, "image": { "type": "string" } }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "ingressNamespaceSelector": { "type": "object" },
        "labs": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "defaultDeny": { "type": "boolean", "description": "Network mode secondary only: deny all traffic of session-labelled pods that no per-session policy allows." },
            "denyCloudMetadata": { "type": "boolean", "description": "Cilium only: CiliumClusterwideNetworkPolicy denying egress from lab pods to 169.254.169.254 and 168.63.129.16." }
          }
        }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "enabled": { "type": "boolean" }, "maxUnavailable": { "type": ["integer", "string"] } }
    },
    "imageVerification": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "requireDigests": { "type": "boolean" },
        "issuer": { "type": "string", "minLength": 1 },
        "subjectRegExp": { "type": "string", "minLength": 1 },
        "extraGlobs": { "$ref": "#/definitions/stringList" }
      }
    },
    "extraObjects": { "type": "array", "items": { "type": "object" } }
  }
}
