{
  "realm": "acme-idp",
  "displayName": "Acme Freight corporate login (fictional external IdP)",
  "enabled": true,
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "sslRequired": "external",
  "groups": [
    {
      "name": "acme-linehaul-leads",
      "path": "/acme-linehaul-leads"
    },
    {
      "name": "acme-terminal-it",
      "path": "/acme-terminal-it"
    },
    {
      "name": "acme-linehaul-ops",
      "path": "/acme-linehaul-ops"
    }
  ],
  "clients": [
    {
      "clientId": "cloudtrain-broker",
      "name": "CloudTrain (Keycloak broker)",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "acme-broker-dev-only-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:8180/realms/cloudtrain/broker/acme-idp/endpoint*"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:8180/*"
      },
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "profile",
        "roles",
        "basic",
        "email"
      ],
      "protocolMappers": [
        {
          "name": "app roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-client-role-mapper",
          "config": {
            "usermodel.clientRoleMapping.clientId": "cloudtrain-broker",
            "claim.name": "roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "roles": {
    "client": {
      "cloudtrain-broker": [
        {
          "name": "CloudTrain.Learner",
          "clientRole": true
        },
        {
          "name": "CloudTrain.Manager",
          "clientRole": true
        },
        {
          "name": "CloudTrain.Instructor",
          "clientRole": true
        },
        {
          "name": "CloudTrain.Author",
          "clientRole": true
        },
        {
          "name": "CloudTrain.OrgAdmin",
          "clientRole": true
        },
        {
          "name": "CloudTrain.PlatformAdmin",
          "clientRole": true
        }
      ]
    }
  },
