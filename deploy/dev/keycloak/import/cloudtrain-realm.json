{
  "realm": "cloudtrain",
  "displayName": "CloudTrain",
  "enabled": true,
  "organizationsEnabled": true,
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "rememberMe": true,
  "verifyEmail": false,
  "bruteForceProtected": true,
  "sslRequired": "external",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 28800,
  "ssoSessionMaxLifespan": 36000,
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "otpSupportedApplications": [
    "totpAppFreeOTPName",
    "totpAppGoogleName",
    "totpAppMicrosoftAuthenticatorName"
  ],
  "webAuthnPolicyPasswordlessRpEntityName": "CloudTrain",
  "webAuthnPolicyPasswordlessUserVerificationRequirement": "required",
  "webAuthnPolicyPasswordlessResidentKey": "Yes",
  "webAuthnPolicyPasswordlessPasskeysEnabled": true,
  "webAuthnPolicyRpEntityName": "CloudTrain",
  "requiredActions": [
    {
      "alias": "CONFIGURE_TOTP",
      "name": "Configure OTP",
      "providerId": "CONFIGURE_TOTP",
      "enabled": true,
      "defaultAction": false,
      "priority": 10,
      "config": {}
    },
    {
      "alias": "TERMS_AND_CONDITIONS",
      "name": "Terms and Conditions",
      "providerId": "TERMS_AND_CONDITIONS",
      "enabled": false,
      "defaultAction": false,
      "priority": 20,
      "config": {}
    },
    {
      "alias": "UPDATE_PASSWORD",
      "name": "Update Password",
      "providerId": "UPDATE_PASSWORD",
      "enabled": true,
      "defaultAction": false,
      "priority": 30,
      "config": {}
    },
    {
      "alias": "UPDATE_PROFILE",
      "name": "Update Profile",
      "providerId": "UPDATE_PROFILE",
      "enabled": true,
      "defaultAction": false,
      "priority": 40,
      "config": {}
    },
    {
      "alias": "VERIFY_EMAIL",
      "name": "Verify Email",
      "providerId": "VERIFY_EMAIL",
      "enabled": true,
      "defaultAction": false,
      "priority": 50,
      "config": {}
    },
    {
      "alias": "delete_account",
      "name": "Delete Account",
      "providerId": "delete_account",
      "enabled": false,
      "defaultAction": false,
      "priority": 60,
      "config": {}
    },
    {
      "alias": "webauthn-register",
      "name": "Webauthn Register",
      "providerId": "webauthn-register",
      "enabled": true,
      "defaultAction": false,
      "priority": 70,
      "config": {}
    },
    {
      "alias": "webauthn-register-passwordless",
      "name": "Webauthn Register Passwordless",
      "providerId": "webauthn-register-passwordless",
      "enabled": true,
      "defaultAction": false,
      "priority": 80,
      "config": {}
    },
    {
      "alias": "update_user_locale",
      "name": "Update User Locale",
      "providerId": "update_user_locale",
      "enabled": true,
      "defaultAction": false,
      "priority": 1000,
      "config": {}
    }
  ],
  "smtpServer": {
    "host": "mailpit",
    "port": "1025",
    "from": "no-reply@cloudtrain.local",
    "fromDisplayName": "CloudTrain (dev)"
  },
  "clients": [
    {
      "clientId": "cloudtrain-gateway",
      "name": "CloudTrain gateway (BFF)",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "gateway-dev-only-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": false,
      "redirectUris": [
        "http://localhost:8787/api/auth/callback",
        "http://127.0.0.1:8787/api/auth/callback",
        "http://localhost:5173/api/auth/callback"
      ],
      "webOrigins": [
        "+"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:8787/*##http://127.0.0.1:8787/*##http://localhost:5173/*",
        "backchannel.logout.url": "http://host.docker.internal:8787/api/auth/backchannel-logout",
        "backchannel.logout.session.required": "true",
        "backchannel.logout.revoke.offline.tokens": "false"
      },
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "profile",
        "roles",
        "basic",
        "email"
      ],
      "optionalClientScopes": [
        "organization",
        "offline_access"
      ],
      "protocolMappers": [
        {
          "name": "idp roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "idp_roles",
            "claim.name": "idp_roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "aggregate.attrs": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "idp groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "idp_groups",
            "claim.name": "idp_groups",
            "jsonType.label": "String",
            "multivalued": "true",
            "aggregate.attrs": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "identity provider",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usersessionmodel-note-mapper",
          "config": {
            "user.session.note": "identity_provider",
            "claim.name": "identity_provider",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "title",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "title",
            "claim.name": "title",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "false",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "cloudtrain-gateway-admin",
      "name": "CloudTrain gateway (Keycloak admin API)",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "gateway-admin-dev-only-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true
    }
  ],
  "identityProviders": [
    {
      "alias": "acme-idp",
      "displayName": "Acme Freight SSO",
      "providerId": "oidc",
      "enabled": true,
      "trustEmail": true,
      "storeToken": false,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "authorizationUrl": "http://localhost:8180/realms/acme-idp/protocol/openid-connect/auth",
        "tokenUrl": "http://localhost:8080/realms/acme-idp/protocol/openid-connect/token",
        "userInfoUrl": "http://localhost:8080/realms/acme-idp/protocol/openid-connect/userinfo",
        "jwksUrl": "http://localhost:8080/realms/acme-idp/protocol/openid-connect/certs",
        "logoutUrl": "http://localhost:8180/realms/acme-idp/protocol/openid-connect/logout",
        "issuer": "http://localhost:8180/realms/acme-idp",
        "clientId": "cloudtrain-broker",
        "clientSecret": "acme-broker-dev-only-secret",
        "clientAuthMethod": "client_secret_post",
        "defaultScope": "openid profile email",
        "validateSignature": "true",
        "useJwksUrl": "true",
        "pkceEnabled": "true",
        "pkceMethod": "S256",
        "syncMode": "FORCE",
        "backchannelSupported": "false"
      }
    }
  ],
  "identityProviderMappers": [
    {
      "name": "app roles",
      "identityProviderAlias": "acme-idp",
      "identityProviderMapper": "oidc-user-attribute-idp-mapper",
      "config": {
        "syncMode": "FORCE",
        "claim": "roles",
        "user.attribute": "idp_roles"
      }
    },
    {
      "name": "groups",
      "identityProviderAlias": "acme-idp",
      "identityProviderMapper": "oidc-user-attribute-idp-mapper",
      "config": {
        "syncMode": "FORCE",
        "claim": "groups",
        "user.attribute": "idp_groups"
      }
    }
  ],
