# deploy/site-vm settings. Copy to .env on the VM and `chmod 600 .env`. Never commit .env.
# Generate each secret with: openssl rand -base64 32 | tr -d '/+=' | cut -c1-32

# The website's host name (the apex); www.<SITE_HOST> redirects to it.
SITE_HOST=cloudtrain.app
# Let's Encrypt account address (expiry warnings only).
ACME_EMAIL=hello@cloudtrain.app

# The gateway image, pinned by digest. CI publishes ghcr.io/thecorporatetractor/cloudtrain/gateway
# on every push to main (tags: main, sha-<commit>).
GATEWAY_IMAGE=ghcr.io/thecorporatetractor/cloudtrain/gateway@sha256:f3293ff47a9c6f215f97bcd64bbc9b5c1a4f2a31dd523bc175ffe6fd1a7cf1ef

POSTGRES_PASSWORD=
CT_OWNER_PASSWORD=
CT_APP_PASSWORD=
# At least 16 characters.
CT_SESSION_SECRET=
# At least 32 characters. The key behind the subject hashes in the evidence ledger: losing or
# changing it unlinks earlier records from their subjects (docs/gdpr.md). The gateway refuses to start without it.
CT_GDPR_HMAC_KEY=

# Optional
# CT_WAITLIST_RATE_PER_HOUR=10
# CT_LOG_LEVEL=info
# Confirmation mails for privacy requests (the gateway's SMTP mailer).
# CT_SMTP_HOST=
# CT_SMTP_PORT=25
# CT_SMTP_FROM=CloudTrain <no-reply@cloudtrain.app>
# The evidence ledger in Azure Tables instead of Postgres (docs/gdpr.md):
# CT_GDPR_LEDGER_TABLE_URL=https://<account>.table.core.windows.net
# CT_GDPR_LEDGER_TABLE=gdprledger
# AZURE_CLIENT_ID=<client id of the user-assigned identity>
# Retention (docs/gdpr.md); 0 turns one off:
# CT_RETENTION_SWEEP_MS=21600000
# CT_RETENTION_WAITLIST_MONTHS=24
# CT_RETENTION_AUDIT_MONTHS=13
# CT_RETENTION_LEDGER_MONTHS=36
# CT_RETENTION_CLOSED_DAYS=90
# CT_RETENTION_INACTIVE_MONTHS=24
# CT_RETENTION_INACTIVE_WARNING_DAYS=30
# Older keys, comma-separated, after a rotation (docs/gdpr.md):
# CT_GDPR_HMAC_KEY_PREVIOUS=
