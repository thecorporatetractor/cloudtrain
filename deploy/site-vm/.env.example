# Copied to .env on the VM (chmod 600). None of these is a secret: the VM holds no secret but the
# origin certificate's key, in ./certs, next to Cloudflare's public origin pull CA. docs/deploy-site-vm.md explains each one.

# The apex, without a scheme. www redirects to it.
SITE_HOST=cloudtrain.app

# Leave unset: Caddy then refuses any connection without Cloudflare's client certificate. Only for the
# rollout in docs/deploy-site-vm.md, "Authenticated Origin Pulls", or local development:
# SITE_CLIENT_AUTH_MODE=verify_if_given

# The sidecar image, by digest: docker buildx imagetools inspect ghcr.io/thecorporatetractor/cloudtrain/site-proxy:main
SITE_PROXY_IMAGE=ghcr.io/thecorporatetractor/cloudtrain/site-proxy@sha256:REPLACE

# From the Terraform session.
# The public Function app's origin.
SITE_PROXY_FUNCTION_URL=https://REPLACE.azurewebsites.net
# The audience of its Entra app registration, e.g. api://<application id>.
SITE_PROXY_FUNCTION_AUDIENCE=api://REPLACE
# The client id of AZR-CLOUDTRAIN-MI, the VM's user-assigned identity.
SITE_PROXY_CLIENT_ID=REPLACE

# The owner's limits. Both are in memory and start over when the sidecar restarts.
SITE_PROXY_PER_IP_PER_HOUR=60
SITE_PROXY_GLOBAL_RPS=5
