# CloudTrain public website (deploy/site-vm): the static site, and three API routes handed to the
# sidecar. Behind Cloudflare in Full (strict) mode: TLS uses a Cloudflare origin certificate from
# mounted files, so there is no ACME and no port 80.
#
# Authenticated Origin Pulls: a connection without a client certificate from Cloudflare's origin pull
# CA is refused during the TLS handshake. It is what makes the sidecar's trust in CF-Connecting-IP
# safe. Fails closed: a missing CA file or an unknown mode stops Caddy from starting.
# docs/deploy-site-vm.md explains it, and the one rollout step that relaxes it.
{
	auto_https off
	admin off
	servers {
		protocols h1 h2
	}
}

(origin_tls) {
	tls /certs/origin.pem /certs/origin.key {
		client_auth {
			mode {$SITE_CLIENT_AUTH_MODE:require_and_verify}
			trust_pool file /certs/origin-pull-ca.pem
		}
	}
}

(security_headers) {
	# The same headers as the static build's _headers file (apps/web/scripts/site-hosting.mjs,
	# csp('') for a same-origin API), plus HSTS. A handler's headers do not reach an error page, so
	# handle_errors imports them too.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		-Server
	}
}

www.{$SITE_HOST}:443 {
	import origin_tls
	redir https://{$SITE_HOST}{uri} permanent
}

{$SITE_HOST}:443 {
	import origin_tls
	# Cloudflare compresses for the browser too; gzip here keeps the origin's memory low (zstd keeps large windows).
	encode gzip

	import security_headers

	# Only these reach the sidecar. Every other /api path, and any other method, is a 404 here.
	@api {
		method POST
		path /api/public/waitlist /api/public/privacy/requests /api/public/privacy/confirm
	}
	handle @api {
		request_body {
			max_size 16KB
		}
		reverse_proxy site-proxy:8080
	}
	handle /api/* {
		header Content-Type "application/json; charset=utf-8"
		respond `{"error":"Not found","code":"not_found"}` 404
	}

	handle {
		root * /srv/site
		@immutable path /assets/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"
		# The public documents: fetched by the pages, never a search result. robots.txt must not block
		# them (a crawler renders pages with them), so this says it instead.
		@data path /data/*
		header @data Cache-Control "public, max-age=300"
		header @data X-Robots-Tag noindex
		# Every page, and the files that name the current build, are revalidated on each load.
		@nocache not path /assets/* /data/* /brand/* /site/* /favicon.ico /manifest.webmanifest
		header @nocache Cache-Control no-cache

		# One URL per page: no trailing slash, no index.html.
		@slash path_regexp slash ^(.+)/$
		redir @slash {re.slash.1}{?query} permanent
		@homefile path /index.html
		redir @homefile /{?query} permanent
		@indexfile path_regexp indexfile ^(.+)/index\.html$
		redir @indexfile {re.indexfile.1}{?query} permanent

		# Build files for other hosts, the route manifest and the 404 page's own address.
		@internal path /_headers /_redirects /.nojekyll /staticwebapp.config.json /routes.json /shell.html /404.html /404
		error @internal 404

		# Website pages that coming-soon mode folds into the one landing page (HIDDEN_ROUTE_REDIRECTS in
		# apps/web/scripts/site-hosting.mjs): only while no page exists there, so a live build keeps them.
		@to_pricing {
			path /pricing
			not file {path}/index.html
		}
		redir @to_pricing /#pricing permanent
		@to_faq {
			path /faq /contact
			not file {path}/index.html
		}
		redir @to_faq /#faq permanent
		@to_what {
			path /about
			not file {path}/index.html
		}
		redir @to_what /#what permanent
		@to_labs {
			path /catalog /labs /learn
			not file {path}/index.html
		}
		redir @to_labs /learn/labs permanent

		# A known route is a directory with a page in it (routes.json lists them). Anything else that
		# is not a file is a 404 below: there is no fallback to an app shell.
		@landing path /
		rewrite @landing /index.html
		try_files {path} {path}/index.html
		file_server {
			disable_canonical_uris
		}
	}

	# Unknown paths: the branded page, noindex, with a real 404 status.
	handle_errors 404 {
		import security_headers
		root * /srv/site
		header Cache-Control no-cache
		rewrite * /404.html
		file_server
	}

	# The sidecar stopped or restarting (also the kill switch): the form shows its own message.
	handle_errors 502 503 504 {
		import security_headers
		header Content-Type "application/json; charset=utf-8"
		header Cache-Control no-store
		respond `{"error":"Not available right now, try again in a few minutes","code":"upstream"}` 503
	}

	# Without the request headers: CF-Connecting-IP is the visitor's address, and this log must not
	# hold it. The remote address in the log is Cloudflare's.
	log {
		output stdout
		format filter {
			wrap console
			fields {
				request>headers delete
				resp_headers delete
			}
		}
	}
}
