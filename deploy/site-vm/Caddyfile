# CloudTrain public website (deploy/site-vm): the static site, and three API routes handed to the
# sidecar. Behind Cloudflare in Full (strict) mode: TLS uses a Cloudflare origin certificate from
# mounted files, so there is no ACME and no port 80.
#
# Authenticated Origin Pulls: a connection without a client certificate from Cloudflare's origin pull
# CA is refused during the TLS handshake. It is what makes the sidecar's trust in CF-Connecting-IP
# safe. Fails closed: a missing CA file or an unknown mode stops Caddy from starting.
# docs/deploy-site-vm.md explains it, and the one rollout step that relaxes it.
{
	auto_https off
	admin off
	servers {
		protocols h1 h2
	}
}

(origin_tls) {
	tls /certs/origin.pem /certs/origin.key {
		client_auth {
			mode {$SITE_CLIENT_AUTH_MODE:require_and_verify}
			trust_pool file /certs/origin-pull-ca.pem
		}
	}
}

www.{$SITE_HOST}:443 {
	import origin_tls
	redir https://{$SITE_HOST}{uri} permanent
}

{$SITE_HOST}:443 {
	import origin_tls
	# Cloudflare compresses for the browser too; gzip here keeps the origin's memory low (zstd keeps large windows).
	encode gzip

	# The same headers as the static build's _headers file (apps/web/scripts/site-hosting.mjs,
	# csp('') for a same-origin API), plus HSTS.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		-Server
	}

	# Only these reach the sidecar. Every other /api path, and any other method, is a 404 here.
	@api {
		method POST
		path /api/public/waitlist /api/public/privacy/requests /api/public/privacy/confirm
	}
	handle @api {
		request_body {
			max_size 16KB
		}
		reverse_proxy site-proxy:8080
	}
	handle /api/* {
		header Content-Type "application/json; charset=utf-8"
		respond `{"error":"Not found","code":"not_found"}` 404
	}

	handle {
		root * /srv/site
		@immutable path /assets/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"
		@data path /data/*
		header @data Cache-Control "public, max-age=300"
		@nocache path / /index.html /shell.html /runtime-config.js /site-boot.js /theme-init.js
		header @nocache Cache-Control no-cache
		# Deep links get the app shell (index.html carries the prerendered landing page,
		# which only / serves).
		@landing path /
		rewrite @landing /index.html
		try_files {path} /shell.html
		file_server {
			disable_canonical_uris
		}
	}

	# The sidecar stopped or restarting (also the kill switch): the form shows its own message.
	handle_errors 502 503 504 {
		header Content-Type "application/json; charset=utf-8"
		header Cache-Control no-store
		respond `{"error":"Not available right now, try again in a few minutes","code":"upstream"}` 503
	}

	# Without the request headers: CF-Connecting-IP is the visitor's address, and this log must not
	# hold it. The remote address in the log is Cloudflare's.
	log {
		output stdout
		format filter {
			wrap console
			fields {
				request>headers delete
				resp_headers delete
			}
		}
	}
}
