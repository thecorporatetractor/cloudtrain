# CloudTrain local runtime: pinned versions (single source of truth).
# Sourced by deploy/scripts/*.sh and tools/images/*.sh, read by Taskfile.yml.
# Bump deliberately; record the reason in docs/dev-environment.md.

# --- CLIs (installed into ~/.local/bin by `task tools`) ---
KIND_VERSION=v0.33.0
TASK_VERSION=v3.54.0
VCLUSTER_VERSION=v0.37.2
VIRTCTL_VERSION=v1.9.1
JQ_VERSION=1.8.2
YQ_VERSION=v4.54.1

# --- Host (kind) cluster ---
CLUSTER_NAME=cloudtrain-dev
# KubeVirt 1.9 supports Kubernetes 1.34-1.36, so the host cluster stays on 1.36
# even though 1.37 is current (the lab clusters inside VMs use 1.37).
KIND_NODE_IMAGE=kindest/node:v1.36.4@sha256:099e049362a1526b2db71494e1947aae99bd16290d7c895f2b7ea312e3cbfaed

# --- Platform add-ons ---
KUBE_OVN_CHART_VERSION=v1.16.13
KUBEVIRT_VERSION=v1.9.1
CDI_VERSION=v1.66.1
MULTUS_VERSION=v4.3.1
# Fetched manifests are verified against these sha256 sums (deploy/scripts/lib.sh fetch_pinned).
# Multus is vendored with local patches in deploy/multus/; the sum is of the upstream file it came from.
MULTUS_MANIFEST_SHA256=24fb29530b760d28126bba76bd91fac8fd74100b53d9fc65943c223e3a82be30
KUBEVIRT_OPERATOR_SHA256=9ac45a436c49d32e6fc21d542bcb7600b970705297b9e6752f3ef9b0a1d292da
CDI_OPERATOR_SHA256=c7d92bd1b2ee1a3952a5990000437c08d58109f31c0bd48ab6188ec27a13e224
# Probe VMI disk for dev:verify-kvm (tag v1.9.1, pinned by digest)
CIRROS_CONTAINERDISK=quay.io/kubevirt/cirros-container-disk-demo:v1.9.1@sha256:ebdb8d8b9b480f6ee7664ed3fdde8428767664f507d98f94090edeff04d7ebf2

# --- Golden image (tools/images) ---
UBUNTU_RELEASE=noble
UBUNTU_SERIAL=20260926
UBUNTU_IMAGE_SHA256=6a81c37564db9b1ee84e141922625e1d7c5b389b99bb3c572e0243607d5bb4d2
# Kubernetes installed inside lab VMs (pkgs.k8s.io minor repo + exact patch)
LAB_K8S_MINOR=v1.37
LAB_K8S_VERSION=v1.37.1
# Lab CNI inside the kubeadm VMs: Calico (enforces NetworkPolicy, which labs grade).
# Upstream manifests/calico-vxlan.yaml, sha256-checked, then tools/images/build.sh sets
# the pool CIDR to the kubeadm podSubnet and VXLAN to Always.
CALICO_VERSION=v3.33.0
CALICO_MANIFEST_SHA256=202d70b43e38b60ebc60736c96e64e6de683053aab2e89da84ea9d904a9ef24c
LAB_POD_CIDR=10.244.0.0/16
# Node runtime packages inside the golden image (exact apt versions, installed as pkg=ver)
CONTAINERD_VERSION=2.4.1-2~ubuntu.24.04~noble
CRI_TOOLS_VERSION=1.37.0-1.1
KUBERNETES_CNI_VERSION=1.9.1-1.1
# Ubuntu archive packages come from this snapshot.ubuntu.com point in time (apt --snapshot)
UBUNTU_APT_SNAPSHOT=20261010T000000Z
# Repo signing keys: the downloaded key must have exactly this fingerprint
DOCKER_APT_KEY_FPR=9DC858229FC7DD38854AE2D88D81803C0EBFCD88
K8S_APT_KEY_FPR=DE15B14486CD377B9E876E1A234654DA9A296436
# Image digests (control plane per K8s version, Flannel, lab workload images):
# tools/images/lock/*.lock, refreshed with `task image:lock` after a version bump.
GOLDEN_IMAGE_REPO=cloudtrain/kubeadm-node

# --- Upgrade-lab node image (tools/images, catalog ref kubeadm:1.36) ---
# Installed release (held) is one minor behind LAB_K8S_VERSION; LAB_K8S_VERSION is
# staged offline (local apt repo + control-plane images) as the upgrade target.
UPGRADE_K8S_MINOR=v1.36
UPGRADE_K8S_VERSION=v1.36.5
UPGRADE_CRI_TOOLS_VERSION=1.36.0-1.1
UPGRADE_IMAGE_TAG=v1.36-upgrade

# --- etcd host image (catalog ref etcd-host:3.6) ---
ETCD_HOST_IMAGE=cloudtrain/etcd-host:3.6
ETCD_VERSION=v3.6.15
ETCD_TARBALL_SHA256=b51d86e6bff2168de5ba8cd631c0fe6c785c7a1b32b083079f5677d6b7e2772c

# --- Jumphost (learner workstation, catalog ref jumphost:1) ---
# kubectl is LAB_K8S_VERSION (sha256 from dl.k8s.io); etcdctl comes from ETCD_VERSION.
JUMPHOST_IMAGE=cloudtrain/jumphost:1
HELM_VERSION=v4.3.0
HELM_TARBALL_SHA256=86584a54def73570558f66f5111cc53dfed56689637ae32c1201205d494f54fb
YQ_BINARY_SHA256=8e34fc298390875de416e6a4afcb8cabeceb25d9aa8506c1a2f9353cf702ea5f
