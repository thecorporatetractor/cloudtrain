#!/bin/sh
# Spike (docs/kata-spike.md): leave an empty leaf cgroup "init" next to the cgroups systemd
# creates. On cgroup v2 kata-agent puts exec'd processes (kubectl exec, the orchestrator's
# setup/checks) into <container>/init/ when it exists (kata PR 10845, the dind convention);
# without it every exec fails with EBUSY once systemd has delegated controllers.
if [ -f /sys/fs/cgroup/cgroup.controllers ]; then mkdir -p /sys/fs/cgroup/init 2>/dev/null || true; fi
# Kata (privileged_without_host_devices): /dev is the container's own; add the guest's
# loop and device-mapper nodes so losetup/LVM labs work. Under runc these exist already.
for i in 0 1 2 3 4 5 6 7; do [ -e /dev/loop$i ] || mknod /dev/loop$i b 7 $i 2>/dev/null; done
[ -e /dev/loop-control ] || mknod /dev/loop-control c 10 237 2>/dev/null
mkdir -p /dev/mapper; [ -e /dev/mapper/control ] || mknod /dev/mapper/control c 10 236 2>/dev/null
exec /sbin/init "$@"
