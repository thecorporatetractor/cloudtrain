{
  "name": "@cloudtrain/lab-schema",
  "version": "0.1.0",
  "private": true,
  "license": "BUSL-1.1",
  "description": "CloudTrain Lab schema (cloudtrain.dev/v3): JSON Schema, generated TypeScript types and a validate function; plus the curriculum schema (cloudtrain.dev/v1 Curriculum).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./schema/lab.schema.json": "./schema/lab.schema.json",
    "./schema/curriculum.schema.json": "./schema/curriculum.schema.json"
  },
  "files": ["dist", "schema"],
  "scripts": {
    "gen": "node scripts/gen-types.mjs",
    "build": "node scripts/gen-types.mjs && tsc -p tsconfig.json",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "ajv": "^8.17.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "json-schema-to-typescript": "^15.0.4",
    "typescript": "^5.7.3"
  }
}
