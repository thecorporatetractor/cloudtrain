{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloudtrain.dev/schema/curriculum/v1",
  "title": "CloudTrain Curriculum (v1)",
  "description": "The whole curriculum as data: domains, every lab (built or proposed), learning paths and exam simulations. Single source of truth for content/curriculum.yaml; docs/curriculum.md is rendered from it.",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "envTiers", "frameworks", "images", "domains", "newSkills", "labs", "paths", "exams"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": { "const": "cloudtrain.dev/v1" },
    "kind": { "const": "Curriculum" },
    "metadata": {
      "type": "object",
      "required": ["version", "status", "updated"],
      "additionalProperties": false,
      "properties": {
        "version": { "type": "integer", "minimum": 1 },
        "status": { "enum": ["proposal", "approved"] },
        "updated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "summary": { "type": "string" },
        "conventions": { "type": "array", "items": { "type": "string" } }
      }
    },
    "envTiers": {
      "description": "Environment tiers a lab can run on.",
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/tier" },
      "additionalProperties": {
        "type": "object",
        "required": ["title", "substrate"],
        "additionalProperties": false,
        "properties": {
          "title": { "type": "string" },
          "substrate": { "type": "string" },
          "authenticFor": { "type": "string" }
        }
      }
    },
    "frameworks": {
      "description": "Alignment targets that do not (yet) have a file in content/frameworks. Objective refs '<id>:<objective>' resolve against these or content/frameworks/*.yaml.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "objectives"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "title": { "type": "string" },
          "body": { "type": "string", "description": "Certifying body, or 'CloudTrain' for internal frameworks." },
          "version": { "type": "string" },
          "weightsSource": { "enum": ["published", "cloudtrain", "none"] },
          "notes": { "type": "string" },
          "objectives": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "title"],
              "additionalProperties": false,
              "properties": {
                "id": { "$ref": "#/$defs/id" },
                "title": { "type": "string" },
                "weight": { "type": "number", "minimum": 0, "maximum": 100 }
              }
            }
          }
        }
      }
    },
    "images": {
      "description": "Proposed image catalog refs (not yet in deploy/images/catalog.yaml).",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["ref", "kind", "tier", "description"],
        "additionalProperties": false,
        "properties": {
          "ref": { "$ref": "#/$defs/imageRef" },
          "kind": { "enum": ["container", "containerDisk", "service"] },
          "tier": { "type": "string", "pattern": "^[ABCKVN](/[ABCKVN])*$" },
          "description": { "type": "string" },
          "status": { "enum": ["proposed", "spike", "available"] }
        }
      }
    },
    "domains": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "summary", "skillDomain", "owner", "competencies"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/$defs/domain" },
          "title": { "type": "string" },
          "summary": { "type": "string" },
          "skillDomain": { "type": "string", "description": "Skill-graph domain id (prefix of skill ids)." },
          "owner": { "type": "string" },
          "organisation": {
            "type": "object",
            "required": ["name"],
            "additionalProperties": false,
            "properties": { "name": { "type": "string" }, "summary": { "type": "string" } }
          },
          "notes": { "type": "string" },
          "licensingNote": {
            "type": "string",
            "description": "Licensing constraints on the tools this domain teaches (for example a source-available CLI), and what must be confirmed before offering the domain to external customers."
          },
          "competencies": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "title"],
              "additionalProperties": false,
              "properties": {
                "id": { "type": "string" },
                "title": { "type": "string" },
                "new": { "type": "boolean" }
              }
            }
          }
        }
      }
    },
    "newSkills": {
      "description": "Skills the curriculum needs that content/skills.yaml lacks. Merged into the skill graph after approval.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "domain", "competency"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(\\.[a-z0-9-]+){2}$" },
          "name": { "type": "string" },
          "domain": { "type": "string" },
          "competency": { "type": "string" },
          "requires": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "labs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/lab" }
    },
    "paths": {
      "type": "array",
      "items": { "$ref": "#/$defs/path" }
    },
    "exams": {
      "type": "array",
      "items": { "$ref": "#/$defs/exam" }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "tier": { "enum": ["A", "B", "C", "K", "V", "N"] },
    "domain": { "enum": ["kubernetes", "linux", "containers", "iac", "automation", "networking"] },
    "imageRef": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*:[a-z0-9][a-z0-9.-]*$" },
    "frameworkRef": { "type": "string", "pattern": "^[a-z0-9-]+:[a-z0-9-]+$" },
    "disclaimer": { "type": "string", "minLength": 40 },
    "lab": {
      "type": "object",
      "required": ["id", "domain", "title", "oneLine", "type", "difficulty", "minutes", "skills", "frameworks", "envTier", "images", "status", "owner"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "domain": { "$ref": "#/$defs/domain" },
        "title": { "type": "string", "maxLength": 80 },
        "oneLine": { "type": "string", "minLength": 30, "description": "The gradeable scenario in one sentence, set in the domain's fictional organisation." },
        "type": { "enum": ["learn", "do", "fix", "hack", "exam"], "description": "exam = exam task: fully graded, no hints, only drawn by exam simulations." },
        "difficulty": { "enum": ["easy", "medium", "hard"] },
        "minutes": { "type": "integer", "minimum": 1, "maximum": 240 },
        "skills": { "type": "array", "minItems": 1, "maxItems": 6, "items": { "type": "string" }, "uniqueItems": true },
        "frameworks": { "type": "array", "items": { "$ref": "#/$defs/frameworkRef" }, "uniqueItems": true },
        "envTier": { "$ref": "#/$defs/tier" },
        "images": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/imageRef" }, "uniqueItems": true },
        "status": { "enum": ["proposed", "built", "verified"] },
        "owner": { "type": "string" },
        "dependsOn": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
        "notes": { "type": "string" }
      }
    },
    "path": {
      "type": "object",
      "required": ["id", "domain", "title", "audience", "level", "prerequisites", "modules", "estimatedHours", "frameworks"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "domain": { "$ref": "#/$defs/domain" },
        "title": { "type": "string", "maxLength": 80 },
        "audience": { "type": "string" },
        "level": { "enum": ["beginner", "intermediate", "advanced"] },
        "prerequisites": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
        "estimatedHours": { "type": "number", "minimum": 0.5 },
        "frameworks": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9-]+(:[a-z0-9-]+)?$" }, "uniqueItems": true },
        "disclaimer": { "$ref": "#/$defs/disclaimer" },
        "status": { "enum": ["proposed", "deferred"] },
        "notes": { "type": "string" },
        "modules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "title", "labs"],
            "additionalProperties": false,
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "title": { "type": "string" },
              "labs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" } }
            }
          }
        }
      },
      "if": { "properties": { "frameworks": { "minItems": 1 } } },
      "then": { "required": ["disclaimer"] }
    },
    "exam": {
      "type": "object",
      "required": ["id", "title", "domain", "alignsTo", "disclaimer", "format", "durationMinutes", "passMark", "taskCount", "envTier", "environment", "blueprint", "rules", "retakePolicy", "scoreReport", "status", "owner"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "maxLength": 80 },
        "domain": {
          "oneOf": [
            { "$ref": "#/$defs/domain" },
            { "const": "cross-domain" }
          ]
        },
        "alignsTo": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "disclaimer": { "$ref": "#/$defs/disclaimer" },
        "format": { "enum": ["practical", "practical-simulation"], "description": "practical-simulation: the real exam is not (fully) hands-on; CloudTrain simulates its objectives as practical tasks." },
        "simulationNote": { "type": "string" },
        "description": { "type": "string" },
        "durationMinutes": { "type": "integer", "minimum": 15, "maximum": 480 },
        "passMark": { "type": "number", "minimum": 1, "maximum": 100 },
        "passMarkNote": { "type": "string" },
        "taskCount": { "type": "integer", "minimum": 1 },
        "envTier": { "$ref": "#/$defs/tier" },
        "environment": { "enum": ["shared", "per-task"] },
        "blueprint": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["objective", "weight", "tasks", "pool"],
            "additionalProperties": false,
            "properties": {
              "objective": { "$ref": "#/$defs/frameworkRef" },
              "weight": { "type": "number", "minimum": 0, "maximum": 100 },
              "tasks": { "type": "integer", "minimum": 0 },
              "pool": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true }
            }
          }
        },
        "rules": {
          "type": "object",
          "required": ["hints", "timer", "rebootBeforeGrade"],
          "additionalProperties": false,
          "properties": {
            "hints": { "const": false },
            "timer": { "enum": ["single", "per-task"] },
            "anyOrder": { "type": "boolean" },
            "flagForReview": { "type": "boolean" },
            "rebootBeforeGrade": { "type": "boolean" },
            "idempotencyRerun": { "type": "boolean", "description": "Re-run each task's spec.exam.rerun actions after the first grading pass and grade again (e.g. saved playbooks must report no changes). Default false." },
            "docsAllowed": { "type": "string" },
            "partialCredit": { "enum": ["per-check", "per-task", "none"] },
            "notes": { "type": "string" }
          }
        },
        "retakePolicy": {
          "type": "object",
          "required": ["freshDraw"],
          "additionalProperties": false,
          "properties": {
            "freeRetakes": { "type": "integer", "minimum": 0 },
            "cooldownHours": { "type": "integer", "minimum": 0 },
            "maxAttemptsPer30Days": { "type": "integer", "minimum": 1 },
            "freshDraw": { "type": "boolean" },
            "notes": { "type": "string" }
          }
        },
        "scoreReport": {
          "type": "object",
          "required": ["breakdown"],
          "additionalProperties": false,
          "properties": {
            "breakdown": { "type": "array", "minItems": 1, "items": { "enum": ["objective", "task", "skill", "domain"] } },
            "showsExpectedValues": { "type": "boolean" },
            "includes": { "type": "array", "items": { "type": "string" } }
          }
        },
        "status": { "enum": ["proposed", "built", "verified"] },
        "owner": { "type": "string" },
        "notes": { "type": "string" }
      },
      "if": { "properties": { "format": { "const": "practical-simulation" } } },
      "then": { "required": ["simulationNote"] }
    }
  }
}
