{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloudtrain.dev/schema/site/v1",
  "title": "CloudTrain Site (v1)",
  "description": "Configuration of the public website served by the same web app as the platform (apps/web) and the gateway (`GET /api/public/site`). Brand, copy, feature blocks, FAQ, contact, footer, legal placeholders, highlighted domains, theme token overrides, feature flags and plans. The default lives in content/site.yaml; a deployment replaces it with its own file (CT_SITE_CONFIG, e.g. a ConfigMap mount) without a code change.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "brand", "hero", "highlightDomains", "features", "howItWorks", "faq", "about", "contact", "footer", "legal", "flags"],
  "properties": {
    "apiVersion": { "const": "cloudtrain.dev/v1" },
    "kind": { "const": "Site" },
    "brand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "tagline"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 40, "description": "Product name shown in the header, titles and the footer." },
        "legalName": { "type": "string", "maxLength": 120, "description": "Legal entity for the copyright line; defaults to the brand name." },
        "tagline": { "type": "string", "minLength": 1, "maxLength": 160 },
        "logo": { "$ref": "#/$defs/href", "description": "URL or absolute path of a logo image (SVG or PNG) for the header. Absent: the built-in mark." },
        "logoDark": { "$ref": "#/$defs/href", "description": "Logo variant for the dark theme; defaults to `logo`." },
        "favicon": { "$ref": "#/$defs/href", "description": "URL or absolute path of the favicon. Absent: the built-in one." }
      }
    },
    "hero": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "subtitle"],
      "properties": {
        "eyebrow": { "type": "string", "maxLength": 80 },
        "title": { "type": "string", "minLength": 1, "maxLength": 140 },
        "subtitle": { "type": "string", "minLength": 1, "maxLength": 400 },
        "primaryCta": { "$ref": "#/$defs/cta" },
        "secondaryCta": { "$ref": "#/$defs/cta" },
        "note": { "type": "string", "maxLength": 200, "description": "Small print under the buttons (e.g. no credit card, SSO for teams)." }
      }
    },
    "highlightDomains": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/domain" },
      "description": "Domains shown on the landing page, in this order. Each must exist in the catalog."
    },
    "features": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": { "$ref": "#/$defs/featureBlock" },
      "description": "Value-proposition blocks on the landing page."
    },
    "howItWorks": {
      "type": "array",
      "minItems": 2,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "body"],
        "properties": {
          "title": { "type": "string", "minLength": 1, "maxLength": 80 },
          "body": { "type": "string", "minLength": 1, "maxLength": 400 }
        }
      },
      "description": "Numbered steps describing how a lab works."
    },
    "screenshots": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["image", "alt"],
        "properties": {
          "image": { "type": "string", "minLength": 1, "maxLength": 300, "pattern": "^(https?://|/)", "description": "Absolute path served by the web app (the default `/site/<name>.png` files are copies of README screenshots kept by apps/web/scripts/readme-shots.mjs) or a URL." },
          "alt": { "type": "string", "minLength": 1, "maxLength": 200 },
          "caption": { "type": "string", "maxLength": 200 }
        }
      }
    },
    "faq": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["q", "a"],
        "properties": {
          "q": { "type": "string", "minLength": 1, "maxLength": 200 },
          "a": { "type": "string", "minLength": 1, "maxLength": 1500 },
          "group": { "type": "string", "maxLength": 60, "description": "Optional heading the question is listed under." }
        }
      }
    },
    "about": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "paragraphs"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "paragraphs": { "type": "array", "minItems": 1, "maxItems": 12, "items": { "type": "string", "minLength": 1, "maxLength": 1500 } },
        "facts": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "value"],
            "properties": { "label": { "type": "string", "maxLength": 60 }, "value": { "type": "string", "maxLength": 120 } }
          }
        }
      }
    },
    "contact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["email"],
      "properties": {
        "title": { "type": "string", "maxLength": 120 },
        "intro": { "type": "string", "maxLength": 600 },
        "email": { "$ref": "#/$defs/email" },
        "salesEmail": { "$ref": "#/$defs/email" },
        "phone": { "type": "string", "maxLength": 40 },
        "address": { "type": "array", "maxItems": 6, "items": { "type": "string", "maxLength": 120 }, "description": "Postal address, one line per item." },
        "hours": { "type": "string", "maxLength": 160 },
        "links": { "type": "array", "maxItems": 8, "items": { "$ref": "#/$defs/link" } }
      }
    },
    "footer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["columns"],
      "properties": {
        "columns": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "links"],
            "properties": {
              "title": { "type": "string", "minLength": 1, "maxLength": 40 },
              "links": { "type": "array", "minItems": 1, "maxItems": 10, "items": { "$ref": "#/$defs/link" } }
            }
          }
        },
        "note": { "type": "string", "maxLength": 400, "description": "Short text under the columns (e.g. source-available notice)." }
      }
    },
    "legal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alignmentNotice", "terms", "privacy"],
      "properties": {
        "alignmentNotice": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600,
          "description": "Shown wherever frameworks are named (footer, catalog, pricing): the platform is not affiliated with the certifying bodies, trademarks belong to their owners, no certification is conferred."
        },
        "terms": { "$ref": "#/$defs/legalDocument" },
        "privacy": { "$ref": "#/$defs/legalDocument" }
      }
    },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "default": { "type": "string", "enum": ["dark", "light", "cream"], "description": "Theme for first-time visitors (the user's choice is remembered)." },
        "tokens": {
          "type": "object",
          "additionalProperties": false,
          "description": "Design-token overrides per theme (CSS custom properties from apps/web/src/styles/tokens.css, e.g. `--accent`). `all` applies to every theme first.",
          "properties": {
            "all": { "$ref": "#/$defs/tokenMap" },
            "dark": { "$ref": "#/$defs/tokenMap" },
            "light": { "$ref": "#/$defs/tokenMap" },
            "cream": { "$ref": "#/$defs/tokenMap" }
          }
        }
      }
    },
    "flags": {
      "type": "object",
      "additionalProperties": false,
      "required": ["showPricing", "showCatalog", "signupEnabled"],
      "properties": {
        "showPricing": { "type": "boolean", "description": "Pricing page and its navigation link." },
        "showCatalog": { "type": "boolean", "description": "Public read-only catalog (paths, courses, labs, exam simulations)." },
        "signupEnabled": { "type": "boolean", "description": "Self-service sign-up. Off: calls to action lead to sign-in or contact." },
        "showContactForm": { "type": "boolean", "default": false, "description": "Contact form on the contact page (needs a backend); off shows the contact details only." }
      }
    },
    "pricing": {
      "type": "object",
      "additionalProperties": false,
      "description": "Pricing page copy. Plans arrive in a later schema version.",
      "properties": {
        "headline": { "type": "string", "maxLength": 140 },
        "intro": { "type": "string", "maxLength": 600 },
        "placeholderNote": { "type": "string", "maxLength": 300, "description": "Shown while prices are placeholders." },
        "contactCta": { "$ref": "#/$defs/cta" }
      }
    }
  },
  "$defs": {
    "domain": { "type": "string", "enum": ["kubernetes", "linux", "containers", "iac", "automation", "networking"] },
    "href": { "type": "string", "minLength": 1, "maxLength": 500, "pattern": "^(https?://|/|mailto:|tel:)" },
    "email": { "type": "string", "maxLength": 200, "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$" },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "to"],
      "properties": {
        "label": { "type": "string", "minLength": 1, "maxLength": 60 },
        "to": { "$ref": "#/$defs/href", "description": "Internal path (`/pricing`) or URL." },
        "external": { "type": "boolean", "description": "Open in a new tab (defaults to true for http(s) URLs)." }
      }
    },
    "cta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "to"],
      "properties": {
        "label": { "type": "string", "minLength": 1, "maxLength": 40 },
        "to": { "$ref": "#/$defs/href" }
      }
    },
    "featureBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["icon", "title", "body"],
      "properties": {
        "icon": { "type": "string", "enum": ["server", "shield", "graduation", "flag", "users", "network", "boxes", "terminal", "timer", "check", "sparkles", "chart", "lock", "cloud", "route", "eye"] },
        "title": { "type": "string", "minLength": 1, "maxLength": 80 },
        "body": { "type": "string", "minLength": 1, "maxLength": 400 }
      }
    },
    "legalDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "updated", "placeholder", "sections"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "updated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "placeholder": { "type": "boolean", "description": "True while the text is a draft that has not passed legal review; the page says so." },
        "sections": {
          "type": "array",
          "minItems": 1,
          "maxItems": 40,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "paragraphs"],
            "properties": {
              "title": { "type": "string", "minLength": 1, "maxLength": 120 },
              "paragraphs": { "type": "array", "minItems": 1, "maxItems": 20, "items": { "type": "string", "minLength": 1, "maxLength": 2000 } }
            }
          }
        }
      }
    },
    "tokenMap": {
      "type": "object",
      "propertyNames": { "pattern": "^--[a-z][a-z0-9-]*$" },
      "additionalProperties": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[^;{}<>]*$" },
      "maxProperties": 60
    }
  }
}
