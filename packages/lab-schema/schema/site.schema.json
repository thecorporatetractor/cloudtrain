{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloudtrain.dev/schema/site/v1",
  "title": "CloudTrain Site (v1)",
  "description": "Configuration of the public website served by the same web app as the platform (apps/web) and the gateway (`GET /api/public/site`). Brand, copy, feature blocks, FAQ, contact, footer, legal placeholders, highlighted domains, theme token overrides, feature flags and plans. The default lives in content/site.yaml; a deployment replaces it with its own file (CT_SITE_CONFIG, e.g. a ConfigMap mount) without a code change.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "brand",
    "hero",
    "highlightDomains",
    "features",
    "howItWorks",
    "faq",
    "about",
    "contact",
    "footer",
    "legal",
    "flags"
  ],
  "properties": {
    "apiVersion": {
      "const": "cloudtrain.dev/v1"
    },
    "kind": {
      "const": "Site"
    },
    "brand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "tagline"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "description": "Product name shown in the header, titles and the footer."
        },
        "legalName": {
          "type": "string",
          "maxLength": 120,
          "description": "Legal entity for the copyright line; defaults to the brand name."
        },
        "tagline": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "logo": {
          "$ref": "#/$defs/href",
          "description": "URL or absolute path of a logo image (SVG or PNG) for the header. Absent: the built-in mark."
        },
        "logoDark": {
          "$ref": "#/$defs/href",
          "description": "Logo variant for the dark theme; defaults to `logo`."
        },
        "favicon": {
          "$ref": "#/$defs/href",
          "description": "URL or absolute path of the favicon. Absent: the built-in one."
        }
      }
    },
    "hero": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "subtitle"
      ],
      "properties": {
        "eyebrow": {
          "type": "string",
          "maxLength": 80
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140
        },
        "subtitle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        },
        "primaryCta": {
          "$ref": "#/$defs/cta"
        },
        "secondaryCta": {
          "$ref": "#/$defs/cta"
        },
        "note": {
          "type": "string",
          "maxLength": 200,
          "description": "Small print under the buttons (e.g. no credit card, SSO for teams)."
        }
      }
    },
    "highlightDomains": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/domain"
      },
      "description": "Domains shown on the landing page, in this order. Each must exist in the catalog."
    },
    "features": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "$ref": "#/$defs/featureBlock"
      },
      "description": "Value-proposition blocks on the landing page."
    },
    "howItWorks": {
      "type": "array",
      "minItems": 2,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "body"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "body": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          }
        }
      },
      "description": "Numbered steps describing how a lab works."
    },
    "screenshots": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "image",
          "alt"
        ],
        "properties": {
          "image": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300,
            "pattern": "^(https?://|/)",
            "description": "Absolute path served by the web app (the default `/site/<name>.png` files are copies of README screenshots kept by apps/web/scripts/readme-shots.mjs) or a URL."
          },
          "alt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "caption": {
            "type": "string",
            "maxLength": 200
          }
        }
      }
    },
    "faq": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "q",
          "a"
        ],
        "properties": {
          "q": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "a": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1500
          },
          "group": {
            "type": "string",
            "maxLength": 60,
            "description": "Optional heading the question is listed under."
          }
        }
      }
    },
    "about": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "paragraphs"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "paragraphs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1500
          }
        },
        "facts": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "label",
              "value"
            ],
            "properties": {
              "label": {
                "type": "string",
                "maxLength": 60
              },
              "value": {
                "type": "string",
                "maxLength": 120
              }
            }
          }
        }
      }
    },
    "contact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "email"
      ],
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 120
        },
        "intro": {
          "type": "string",
          "maxLength": 600
        },
        "email": {
          "$ref": "#/$defs/email"
        },
        "salesEmail": {
          "$ref": "#/$defs/email"
        },
        "phone": {
          "type": "string",
          "maxLength": 40
        },
        "address": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "type": "string",
            "maxLength": 120
          },
          "description": "Postal address, one line per item."
        },
        "hours": {
          "type": "string",
          "maxLength": 160
        },
        "links": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/link"
          }
        }
      }
    },
    "footer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "columns"
      ],
      "properties": {
        "columns": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "title",
              "links"
            ],
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              },
              "links": {
                "type": "array",
                "minItems": 1,
                "maxItems": 10,
                "items": {
                  "$ref": "#/$defs/link"
                }
              }
            }
          }
        },
        "note": {
          "type": "string",
          "maxLength": 400,
          "description": "Short text under the columns (e.g. source-available notice)."
        }
      }
    },
    "legal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "alignmentNotice",
        "terms",
        "privacy"
      ],
      "properties": {
        "alignmentNotice": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600,
          "description": "Shown wherever frameworks are named (footer, catalog, pricing): the platform is not affiliated with the certifying bodies, trademarks belong to their owners, no certification is conferred."
        },
        "terms": {
          "$ref": "#/$defs/legalDocument"
        },
        "privacy": {
          "$ref": "#/$defs/legalDocument"
        }
      }
    },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "default": {
          "type": "string",
          "enum": [
            "dark",
            "light",
            "cream"
          ],
          "description": "Theme for first-time visitors (the user's choice is remembered)."
        },
        "tokens": {
          "type": "object",
          "additionalProperties": false,
          "description": "Design-token overrides per theme (CSS custom properties from apps/web/src/styles/tokens.css, e.g. `--accent`). `all` applies to every theme first.",
          "properties": {
            "all": {
              "$ref": "#/$defs/tokenMap"
            },
            "dark": {
              "$ref": "#/$defs/tokenMap"
            },
            "light": {
              "$ref": "#/$defs/tokenMap"
            },
            "cream": {
              "$ref": "#/$defs/tokenMap"
            }
          }
        }
      }
    },
    "flags": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "showPricing",
        "showCatalog",
        "signupEnabled"
      ],
      "properties": {
        "showPricing": {
          "type": "boolean",
          "description": "Pricing page and its navigation link."
        },
        "showCatalog": {
          "type": "boolean",
          "description": "Public read-only catalog (paths, courses, labs, exam simulations)."
        },
        "signupEnabled": {
          "type": "boolean",
          "description": "Self-service sign-up. Off: calls to action lead to sign-in or contact."
        },
        "showContactForm": {
          "type": "boolean",
          "default": false,
          "description": "Contact form on the contact page (needs a backend); off shows the contact details only."
        },
        "checkoutEnabled": {
          "type": "boolean",
          "default": false,
          "description": "Self-service checkout for paid plans (needs the gateway's billing integration, CT_BILLING_ENABLED). Off: paid-plan calls to action lead to contact."
        }
      }
    },
    "pricing": {
      "type": "object",
      "additionalProperties": false,
      "description": "Pricing page copy around the plans.",
      "properties": {
        "headline": {
          "type": "string",
          "maxLength": 140
        },
        "intro": {
          "type": "string",
          "maxLength": 600
        },
        "placeholderNote": {
          "type": "string",
          "maxLength": 300,
          "description": "Shown while prices are placeholders."
        },
        "contactCta": {
          "$ref": "#/$defs/cta"
        },
        "faqGroup": {
          "type": "string",
          "maxLength": 60,
          "description": "FAQ group shown under the plans (entries of `faq` with this `group`)."
        }
      }
    },
    "plans": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "currency",
        "items"
      ],
      "description": "Plans shown on the pricing page and used by billing (Stripe Products and Prices are created from them by lookup key). Three shapes: free, individual (monthly/yearly) and organisation (per seat).",
      "properties": {
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$",
          "description": "ISO 4217 code; amounts are in the currency's minor unit (cents)."
        },
        "placeholder": {
          "type": "boolean",
          "description": "Every price is a placeholder, not an offer; the page says so."
        },
        "taxNote": {
          "type": "string",
          "maxLength": 200,
          "description": "E.g. 'Prices exclude VAT.'"
        },
        "billingNote": {
          "type": "string",
          "maxLength": 400
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/plan"
          }
        }
      }
    }
  },
  "$defs": {
    "domain": {
      "type": "string",
      "enum": [
        "kubernetes",
        "linux",
        "containers",
        "iac",
        "automation",
        "networking"
      ]
    },
    "href": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^(https?://|/|mailto:|tel:)"
    },
    "email": {
      "type": "string",
      "maxLength": 200,
      "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$"
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "to"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "to": {
          "$ref": "#/$defs/href",
          "description": "Internal path (`/pricing`) or URL."
        },
        "external": {
          "type": "boolean",
          "description": "Open in a new tab (defaults to true for http(s) URLs)."
        }
      }
    },
    "cta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "to"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "to": {
          "$ref": "#/$defs/href"
        }
      }
    },
    "featureBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "icon",
        "title",
        "body"
      ],
      "properties": {
        "icon": {
          "type": "string",
          "enum": [
            "server",
            "shield",
            "graduation",
            "flag",
            "users",
            "network",
            "boxes",
            "terminal",
            "timer",
            "check",
            "sparkles",
            "chart",
            "lock",
            "cloud",
            "route",
            "eye"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "body": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        }
      }
    },
    "legalDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "updated",
        "placeholder",
        "sections"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "updated": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "placeholder": {
          "type": "boolean",
          "description": "True while the text is a draft that has not passed legal review; the page says so."
        },
        "sections": {
          "type": "array",
          "minItems": 1,
          "maxItems": 40,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "title",
              "paragraphs"
            ],
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "paragraphs": {
                "type": "array",
                "minItems": 1,
                "maxItems": 20,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                }
              }
            }
          }
        }
      }
    },
    "tokenMap": {
      "type": "object",
      "propertyNames": {
        "pattern": "^--[a-z][a-z0-9-]*$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200,
        "pattern": "^[^;{}<>]*$"
      },
      "maxProperties": 60
    },
    "price": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "amount",
        "lookupKey"
      ],
      "properties": {
        "amount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000000,
          "description": "Minor units (cents) per interval, per seat for per-seat plans."
        },
        "lookupKey": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{2,59}$",
          "description": "Stripe Price lookup key; unique across plans. `stripe:sync` creates or updates the Price behind it."
        }
      }
    },
    "entitlements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "labHoursPerMonth",
        "concurrentLabs",
        "envTiers",
        "examSimulationsPerMonth",
        "ctfEvents"
      ],
      "description": "What a plan allows. Recorded and displayed; enforcement comes later.",
      "properties": {
        "labHoursPerMonth": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000
            },
            {
              "const": "unlimited"
            }
          ],
          "description": "Lab session hours per month (per learner)."
        },
        "concurrentLabs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "description": "Lab sessions a learner may run at once."
        },
        "envTiers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "A",
              "B",
              "C",
              "K",
              "V",
              "N"
            ]
          },
          "description": "Environment tiers the plan may start (curriculum envTiers: A pod, B Kata pod, C VM, K kubeadm cluster, V virtual cluster, N netdev)."
        },
        "examSimulationsPerMonth": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000
            },
            {
              "const": "unlimited"
            }
          ],
          "description": "Exam simulation attempts per month (per learner)."
        },
        "ctfEvents": {
          "type": "boolean",
          "description": "May join (and, for organisations, run) CTF events."
        }
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "kind",
        "description",
        "entitlements",
        "includes",
        "cta"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,30}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "kind": {
          "type": "string",
          "enum": [
            "free",
            "individual",
            "organisation"
          ],
          "description": "free: no price; individual: one person, monthly or yearly; organisation: per seat, monthly or yearly."
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "badge": {
          "type": "string",
          "maxLength": 24,
          "description": "Small label on the card, e.g. 'Most popular'."
        },
        "highlight": {
          "type": "boolean",
          "description": "Emphasised card (at most one plan)."
        },
        "prices": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "monthly": {
              "$ref": "#/$defs/price"
            },
            "yearly": {
              "$ref": "#/$defs/price"
            }
          },
          "description": "Required for paid plans; absent for free."
        },
        "perSeat": {
          "type": "boolean",
          "description": "Organisation plans: the price is per seat and the buyer picks a seat count."
        },
        "minSeats": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "maxSeats": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "placeholderPrices": {
          "type": "boolean",
          "description": "This plan's prices are placeholders (also implied by `plans.placeholder`)."
        },
        "entitlements": {
          "$ref": "#/$defs/entitlements"
        },
        "includes": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "description": "Marketing bullets under the entitlements."
        },
        "cta": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "label",
            "action"
          ],
          "properties": {
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40
            },
            "action": {
              "type": "string",
              "enum": [
                "signin",
                "checkout",
                "contact"
              ],
              "description": "signin: sign in or go to the dashboard; checkout: subscribe (falls back to contact while flags.checkoutEnabled is off); contact: the contact page or `to`."
            },
            "to": {
              "$ref": "#/$defs/href",
              "description": "Target for `contact` (default /contact)."
            }
          }
        }
      },
      "if": {
        "properties": {
          "kind": {
            "const": "free"
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "prices"
          ]
        }
      },
      "else": {
        "required": [
          "prices"
        ]
      }
    }
  }
}
