{
  "name": "@cloudtrain/gateway",
  "version": "0.1.0",
  "private": true,
  "license": "BUSL-1.1",
  "description": "Backend-for-frontend for apps/web: real catalog from content/, lab sessions in the cluster, terminal over WebSocket.",
  "type": "module",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "lint": "tsc -p tsconfig.test.json",
    "test": "vitest run --testTimeout=30000",
    "db:migrate": "tsx src/db/cli.ts migrate",
    "db:seed": "tsx src/db/cli.ts seed",
    "kc:sync": "tsx src/keycloak/cli.ts sync",
    "stripe:sync": "tsx src/billing/sync-cli.ts",
    "site:export": "tsx src/site/export-cli.ts"
  },
  "dependencies": {
    "@cloudtrain/api-types": "workspace:^",
    "@cloudtrain/lab-schema": "workspace:^",
    "@fastify/cookie": "^11",
    "@fastify/websocket": "^11",
    "@kubernetes/client-node": "^2",
    "fastify": "^5",
    "jose": "^6",
    "kysely": "^0.29",
    "nodemailer": "^10",
    "pg": "^8",
    "ws": "^8",
    "yaml": "^2"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8",
    "@types/pg": "^8",
    "@types/ws": "^8",
    "tsx": "^4",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
