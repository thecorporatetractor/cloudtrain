    "nodemailer": "^10.1.0",
    "pg": "^8.23.1",
    "ws": "^8",
    "yaml": "^2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8",
    "tsx": "^4",
    "typescript": "^5.7.3",
