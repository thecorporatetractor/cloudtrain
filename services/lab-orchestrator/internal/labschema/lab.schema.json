{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloudtrain.dev/schema/lab/v3",
  "title": "CloudTrain Lab (v3)",
  "description": "A hands-on lab: a topology of nodes and links, setup actions, typed checks tagged with skills, and a reference solution. Domain-agnostic (Kubernetes, Linux, networking).",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": { "const": "cloudtrain.dev/v3" },
    "kind": { "const": "Lab" },
    "metadata": {
      "type": "object",
      "required": ["id", "title", "domain", "difficulty", "estimatedMinutes"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "title": { "type": "string", "maxLength": 80 },
        "domain": { "enum": ["kubernetes", "linux", "networking"] },
        "frameworks": {
          "description": "Framework objective references, e.g. 'cka:cluster-architecture'.",
          "type": "array", "items": { "type": "string" }
        },
        "difficulty": { "enum": ["easy", "medium", "hard"] },
        "estimatedMinutes": { "type": "integer", "minimum": 1, "maximum": 240 },
        "tags": { "type": "array", "items": { "type": "string" } },
        "version": { "type": "integer", "minimum": 1, "default": 1 }
      }
    },
    "spec": {
      "type": "object",
      "required": ["description", "topology", "checks", "solution"],
      "additionalProperties": false,
      "properties": {
        "description": { "type": "string", "description": "Task statement shown to the learner (Markdown). May reference {{params}}." },
        "objectives": { "type": "array", "items": { "type": "string" } },
        "params": {
          "description": "Values randomised per learner attempt. Referenced as {{name}} anywhere in description, setup, checks and solution.",
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["type"],
            "properties": {
              "type": { "enum": ["choice", "int", "name"] },
              "values": { "type": "array" },
              "min": { "type": "integer" },
              "max": { "type": "integer" },
              "prefix": { "type": "string" },
              "default": {}
            }
          }
        },
        "topology": { "$ref": "#/$defs/topology" },
        "setup": { "type": "array", "items": { "$ref": "#/$defs/action" } },
        "teardown": { "type": "array", "items": { "$ref": "#/$defs/action" } },
        "checks": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/check" } },
        "hints": {
          "type": "array",
          "items": {
            "type": "object", "required": ["title", "body"], "additionalProperties": false,
            "properties": {
              "title": { "type": "string" }, "body": { "type": "string" },
              "command": { "type": "string" }, "cost": { "type": "integer", "minimum": 0, "default": 1 }
            }
          }
        },
        "misconceptions": {
          "description": "Plausible wrong approaches. Each one with a `mutation` is also a mutation test: the verifier applies `mutation` instead of the solution and requires every check listed in `expectFail` to fail. A misconception without a mutation is advisory only.",
          "type": "array",
          "items": {
            "type": "object", "required": ["id", "description"], "additionalProperties": false,
            "properties": {
              "id": { "type": "string" }, "description": { "type": "string" },
              "mutation": { "$ref": "#/$defs/action" },
              "expectFail": {
                "description": "Ids of the checks aimed at this misconception. Each must fail after `mutation`; failures of other checks (e.g. the context check) do not count.",
                "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" }
              },
              "feedback": { "type": "string" }
            },
            "dependentRequired": { "mutation": ["expectFail"], "expectFail": ["mutation"] }
          }
        },
        "exam": {
          "description": "Exam-task extras (labs drawn by exam simulations). `rerun` actions run after the first grading pass when the exam's rules set idempotencyRerun (e.g. re-run the candidate's saved playbook and assert it reports no changes); a failing action fails the task's checks, then every check is graded again.",
          "type": "object", "additionalProperties": false,
          "properties": {
            "rerun": { "type": "array", "items": { "$ref": "#/$defs/action" } }
          }
        },
        "solution": {
          "type": "object", "required": ["steps"], "additionalProperties": false,
          "properties": {
            "explanation": { "type": "string" },
            "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/action" } },
            "alternatives": {
              "description": "Other valid ways to solve the lab. The Scenario Studio verifier applies each alternative's steps in a fresh session and requires every check to pass, so a correct but different approach is never penalised.",
              "type": "array",
              "items": {
                "type": "object", "required": ["id", "description", "steps"], "additionalProperties": false,
                "properties": {
                  "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
                  "description": { "type": "string" },
                  "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/action" } }
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "topology": {
      "type": "object",
      "required": ["nodes"],
      "additionalProperties": false,
      "properties": {
        "entry": { "type": "string", "description": "Node the learner's terminal opens on (usually the jumphost)." },
        "nodes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/node" } },
        "links": { "type": "array", "items": { "$ref": "#/$defs/link" } }
      }
    },
    "node": {
      "type": "object",
      "required": ["name", "driver"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$" },
        "driver": { "enum": ["container", "vm", "k8s-cluster", "netdev"] },
        "image": { "type": "string", "description": "Catalog image ref, e.g. 'jumphost:1', 'ubuntu:24.04', 'frr:10', 'kubeadm:1.35'." },
        "resources": {
          "type": "object", "additionalProperties": false,
          "properties": { "cpu": { "type": "number" }, "memoryMiB": { "type": "integer" }, "disks": { "type": "array", "maxItems": 6, "items": { "type": "string", "pattern": "^[0-9]+(Mi|Gi)$" }, "description": "vm nodes: sizes of extra blank data disks (e.g. [\"2Gi\", \"2Gi\"]), attached as /dev/vdb, /dev/vdc, ... with serials ct-data1, ct-data2, ... (/dev/disk/by-id/virtio-ct-dataN)" } }
        },
        "access": { "type": "array", "items": { "enum": ["shell", "ssh", "console", "web", "rdp"] } },
        "learnerSudo": {
          "type": "boolean", "default": false,
          "description": "Entry container node only. SECURITY TRADE-OFF, opt-in: lets setuid/setgid programs (sudo, crontab, passwd, su) raise the learner's privileges (allowPrivilegeEscalation true instead of false on the node container). The learner can then become root in the container (unprivileged, default capabilities; inside a user namespace when the image is marked userNamespace and the cluster supports it). The platform only lifts no_new_privs: the image or the lab's setup must grant the sudo rule (e.g. /etc/sudoers.d/learner). Operators can refuse such labs with the manager flag --allow-learner-sudo=false."
        },
        "cluster": {
          "description": "Only for driver=k8s-cluster.",
          "type": "object", "additionalProperties": false,
          "properties": {
            "mode": { "enum": ["virtual", "kubeadm"], "description": "virtual = vcluster (API-only), kubeadm = real VM nodes" },
            "version": { "type": "string" },
            "context": { "type": "string", "description": "kubeconfig context name exposed on the entry node" },
            "nodes": {
              "type": "array",
              "items": {
                "type": "object", "required": ["name", "role"], "additionalProperties": false,
                "properties": {
                  "name": { "type": "string" }, "role": { "enum": ["control-plane", "worker"] },
                  "taints": { "type": "array", "items": { "type": "string" } },
                  "labels": { "type": "object", "additionalProperties": { "type": "string" } },
                  "state": { "enum": ["ready", "notready"], "default": "ready" }
                }
              }
            }
          }
        }
      }
    },
    "link": {
      "type": "object", "required": ["a", "b"], "additionalProperties": false,
      "properties": {
        "a": { "type": "string", "description": "node:interface" },
        "b": { "type": "string" },
        "subnet": { "type": "string" },
        "impair": {
          "type": "object", "additionalProperties": false,
          "properties": { "latencyMs": { "type": "integer" }, "lossPct": { "type": "number" }, "mtu": { "type": "integer" } }
        }
      }
    },
    "action": {
      "type": "object",
      "required": ["on"],
      "additionalProperties": false,
      "description": "Runs on a node. Exactly one of run/apply/file/config.",
      "properties": {
        "on": { "type": "string", "description": "node name, or node/cluster-node for kubeadm cluster nodes, e.g. 'web-cluster/web-cp-1'" },
        "as": { "enum": ["learner", "admin"], "default": "admin", "description": "admin = out-of-band platform credentials; learner = as the learner would" },
        "run": { "type": "string", "description": "shell script" },
        "apply": { "type": "string", "description": "Kubernetes manifest (YAML) applied to the node's cluster" },
        "file": {
          "type": "object", "required": ["path"], "additionalProperties": false,
          "properties": {
            "path": { "type": "string" }, "content": { "type": "string" }, "mode": { "type": "string" },
            "source": {
              "type": "string",
              "description": "Asset path relative to the lab directory (beside lab.yaml), copied verbatim to `path`. Use instead of `content` for scripts and fixtures too large to inline. Must stay inside the lab directory: no leading '/', no '.' or '..' segments.",
              "pattern": "^(?:[^./][^/]*|\\.[^./][^/]*|\\.\\.[^/]+)(?:/(?:[^./][^/]*|\\.[^./][^/]*|\\.\\.[^/]+))*$"
            }
          },
          "oneOf": [{ "required": ["content"] }, { "required": ["source"] }]
        },
        "config": { "type": "string", "description": "network device configuration block" },
        "timeoutSec": { "type": "integer", "default": 60 }
      },
      "oneOf": [
        { "required": ["run"] }, { "required": ["apply"] }, { "required": ["file"] }, { "required": ["config"] }
      ]
    },
    "check": {
      "type": "object",
      "required": ["id", "description", "type", "skills"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "description": { "type": "string" },
        "skills": { "type": "array", "minItems": 1, "items": { "type": "string" }, "description": "Skill ids from content/skills.yaml" },
        "weight": { "type": "number", "default": 1 },
        "type": {
          "enum": ["shell", "k8s-query", "k8s-can-i", "k8s-context", "file", "service-state", "reachability", "device-cmd", "http"]
        },
        "on": { "type": "string" },
        "command": { "type": "string" },
        "query": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "cluster": { "type": "string" }, "resource": { "type": "string" }, "name": { "type": "string" },
            "namespace": { "type": "string" }, "jsonpath": { "type": "string" },
            "verb": { "type": "string" }, "as": { "type": "string" }
          }
        },
        "target": { "type": "string" },
        "port": { "type": "integer" },
        "expect": {
          "type": "object", "required": ["match", "value"], "additionalProperties": false,
          "properties": {
            "match": { "enum": ["exact", "not_exact", "contains", "not_contains", "regex"] },
            "value": { "type": "string" }
          }
        },
        "timeoutSec": { "type": "integer", "default": 5 }
      }
    }
  }
}
