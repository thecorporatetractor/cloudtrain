{
  "version": "2.0",
  "logging": {
    "logLevel": { "default": "Warning", "Function": "Information" },
    "applicationInsights": { "samplingSettings": { "isEnabled": true, "maxTelemetryItemsPerSecond": 1 } }
  },
  "extensionBundle": { "id": "Microsoft.Azure.Functions.ExtensionBundle", "version": "[4.*, 5.0.0)" },
  "extensions": {
    "queues": { "batchSize": 1, "newBatchThreshold": 0, "maxDequeueCount": 5, "visibilityTimeout": "00:01:00", "maxPollingInterval": "00:00:30", "messageEncoding": "base64" }
  },
  "functionTimeout": "00:05:00"
}
