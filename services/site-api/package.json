{
  "name": "@cloudtrain/site-api",
  "version": "0.1.0",
  "private": true,
  "license": "BUSL-1.1",
  "description": "The production website's backend: two Azure Function apps over Azure Tables. The public app can only add; the worker app does everything else (docs/deploy-site-vm.md).",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.test.json",
    "lint": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "package": "node scripts/package.mjs",
    "cli": "tsx src/cli.ts",
    "dev:host": "tsx dev/local-host.ts"
  },
  "dependencies": {
    "@azure/communication-email": "^1",
    "@azure/data-tables": "^13",
    "@azure/functions": "^4",
    "@azure/identity": "^4",
    "@azure/storage-blob": "^12",
    "@azure/storage-queue": "^12",
    "@cloudtrain/api-types": "workspace:^",
    "@cloudtrain/email-templates": "workspace:*",
    "@cloudtrain/waitlist-rules": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "azurite": "^3",
    "esbuild": "^0.28.2",
    "tsx": "^4",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "yaml": "^2"
  }
}
