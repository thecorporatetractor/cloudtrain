# Python packages of the mirrored execution environment base (localhost/ov-ee-base:1, baked into
# el-vm:10). All of them go into the image's wheelhouse /opt/wheelhouse, because lab VMs have no PyPI:
# ansible-builder's stages pip-install bindep, pyyaml, packaging, dumb-init and the lab's own packages.
# Only ansible-core and ansible-runner are installed in the image. jmespath stays a wheel: the
# execution environment lab adds it itself.
# Same versions as the Ansible control node (tools/images/ansible/requirements.lock).
# Regenerate requirements.lock with tools/images/ee-base/lock-python.sh after changing this file.
ansible-core==2.21.5
ansible-runner==2.4.3
bindep==2.14.0
pyyaml==6.0.3
packaging==26.3
jmespath==1.1.0
dumb-init==1.2.5
setuptools==84.0.0
