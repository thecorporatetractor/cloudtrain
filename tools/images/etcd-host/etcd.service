# CloudTrain etcd-host default unit: a single TLS member on loopback.
# Client and peer traffic are both mutual TLS; the PKI under /etc/qm-etcd/pki is
# generated per VM on first start (cloudtrain-etcd-pki), never baked into the image.
# Labs replace this unit and the PKI with their own (etcd-snapshot-restore's
# provision-etcd.sh tears both down first).
[Unit]
Description=etcd key-value store (CloudTrain etcd-host)
Documentation=https://etcd.io/docs/
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
User=etcd
Group=etcd
ExecStartPre=+/usr/local/sbin/cloudtrain-etcd-pki
ExecStart=/usr/local/bin/etcd \
  --name=etcd-host \
  --data-dir=/var/lib/etcd \
  --listen-client-urls=https://127.0.0.1:2379 \
  --advertise-client-urls=https://127.0.0.1:2379 \
  --listen-peer-urls=https://127.0.0.1:2380 \
  --initial-advertise-peer-urls=https://127.0.0.1:2380 \
  --initial-cluster=etcd-host=https://127.0.0.1:2380 \
  --client-cert-auth=true \
  --trusted-ca-file=/etc/qm-etcd/pki/ca.crt \
  --cert-file=/etc/qm-etcd/pki/server.crt \
  --key-file=/etc/qm-etcd/pki/server.key \
  --peer-client-cert-auth=true \
  --peer-trusted-ca-file=/etc/qm-etcd/pki/ca.crt \
  --peer-cert-file=/etc/qm-etcd/pki/peer.crt \
  --peer-key-file=/etc/qm-etcd/pki/peer.key
Restart=on-failure
RestartSec=3
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
