# CloudTrain IaC workstation shell, sourced at the end of ~/.bashrc (interactive only).
[[ $- == *i* ]] || return 0

if ! declare -F __start_kubectl >/dev/null && [[ -r /usr/share/bash-completion/completions/kubectl ]]; then
  . /usr/share/bash-completion/completions/kubectl
fi
alias k=kubectl
complete -o default -F __start_kubectl k
# terraform/tofu complete themselves (`-install-autocomplete` writes the same line).
for __c in terraform tofu; do command -v "$__c" >/dev/null && complete -C "$(command -v "$__c")" "$__c"; done
unset __c

export EDITOR=vim KUBE_EDITOR=vim
# The local S3 store (state backends) comes back after a hibernation on first login.
ct-s3 ensure >/dev/null 2>&1 || true

__ct_kube_ctx() {
  local cfg=${KUBECONFIG:-$HOME/.kube/config} ctx
  cfg=${cfg%%:*}
  [[ -r $cfg ]] || return 0
  ctx=$(awk '/^current-context:/{print $2; exit}' "$cfg" 2>/dev/null)
  [[ -n $ctx && $ctx != '""' ]] && printf ' [%s]' "$ctx"
  return 0
}
PS1='\[\e[1;32m\]\u@\h\[\e[0m\]:\[\e[1;34m\]\w\[\e[0;36m\]$(__ct_kube_ctx)\[\e[0m\]\$ '
