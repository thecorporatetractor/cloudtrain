#!/bin/sh
# OpenTofu flavour of the CloudTrain IaC workstation: this image ships no Terraform
# binary. `terraform` runs OpenTofu (tofu), which accepts the same commands, files and
# state for everything the shared labs use.
[ -n "${CT_IAC_SHIM_QUIET:-}" ] || [ ! -t 2 ] || echo "note: this workstation runs OpenTofu; 'terraform' runs 'tofu'" >&2
exec tofu "$@"
