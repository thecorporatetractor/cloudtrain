# CloudTrain IaC workstation: CLI configuration for terraform and tofu (both read
# ~/.terraformrc; tofu prefers ~/.tofurc when present). Labs are offline, so providers
# come only from the image's filesystem mirror; there is no direct registry access.
disable_checkpoint = true

provider_installation {
  filesystem_mirror {
    path = "/opt/cloudtrain/providers"
  }
}
