# Lab guest kernel fragment (docs/kata-spike.md, section 4.3), appended to Kata's own config
# for the same kernel (kata-config-<version>-<kata config version>). Everything is built in
# (=y): the Kata guest has no module tree, so nothing can be loaded at runtime.
# build.sh fails when `make olddefconfig` drops any of these lines (a missing dependency).
# Covers deploy/scripts/lab-kernel-modules.txt plus what the storage labs need.
#
# Tunnels: GRE (v4/v6), IP-in-IP, SIT, ip6 tunnel, WireGuard
CONFIG_NET_IPGRE_DEMUX=y
CONFIG_NET_IPGRE=y
CONFIG_IPV6_GRE=y
CONFIG_NET_IPIP=y
CONFIG_IPV6_SIT=y
CONFIG_IPV6_TUNNEL=y
CONFIG_WIREGUARD=y
# L2: dummy, bonding, team, 802.1Q VLANs
CONFIG_DUMMY=y
CONFIG_BONDING=y
CONFIG_NET_TEAM=y
CONFIG_VLAN_8021Q=y
# tc: netem, shaping, classifiers, mirroring (actions need NET_CLS_ACT)
CONFIG_NET_SCH_NETEM=y
CONFIG_NET_SCH_HTB=y
CONFIG_NET_SCH_TBF=y
CONFIG_NET_SCH_PRIO=y
CONFIG_NET_SCH_FQ_CODEL=y
CONFIG_NET_CLS_U32=y
CONFIG_NET_CLS_ACT=y
CONFIG_NET_ACT_MIRRED=y
# IPsec: AH/ESP (v4/v6), IPcomp, xfrm tunnels
CONFIG_INET_AH=y
CONFIG_INET6_AH=y
CONFIG_INET6_ESP=y
CONFIG_INET_IPCOMP=y
CONFIG_INET_XFRM_TUNNEL=y
CONFIG_INET6_XFRM_TUNNEL=y
# Storage: MD RAID, device-mapper targets, loop
CONFIG_MD=y
CONFIG_BLK_DEV_MD=y
CONFIG_MD_RAID0=y
CONFIG_MD_RAID1=y
CONFIG_MD_RAID10=y
CONFIG_MD_RAID456=y
CONFIG_BLK_DEV_DM=y
CONFIG_DM_SNAPSHOT=y
CONFIG_DM_THIN_PROVISIONING=y
CONFIG_DM_MIRROR=y
CONFIG_DM_RAID=y
CONFIG_BLK_DEV_LOOP=y
# File systems: XFS, Btrfs, NFS client and server, autofs, quota
CONFIG_XFS_FS=y
CONFIG_BTRFS_FS=y
CONFIG_NFS_FS=y
CONFIG_NFSD=y
CONFIG_AUTOFS_FS=y
CONFIG_QUOTA=y
