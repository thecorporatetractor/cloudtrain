# CloudTrain KQL workstation shell, sourced at the end of ~/.bashrc (interactive only).
[[ $- == *i* ]] || return 0
export EDITOR=vim
PS1='\[\e[1;32m\]\u@\h\[\e[0m\]:\[\e[1;34m\]\w\[\e[0m\]\$ '
if [[ -z ${CT_KQL_HELLO:-} ]]; then
  export CT_KQL_HELLO=1
  echo "KQL workstation: run 'kql' for a KQL prompt (kql --tables lists the tables, kql --help for more)."
fi
