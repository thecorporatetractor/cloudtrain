#!/usr/bin/env python3
"""kql-load: print a lokql script that loads a dataset with the right column types.

  kql-load DATASET_DIR [--prefix P]

A dataset is a directory with schema.json ({"tables": {Name: {"file", "columns": [{"name",
"type"}]}}}) and one JSONL file per table, as written by ct-loggen and the sample-data
importer. lokql infers column types from JSON; the script turns inference off, loads each
file, casts every column to its schema type (dynamic columns parsed from JSON) and keeps
the result as the table. --prefix names the tables P<Name> (two datasets side by side).
"""
import json
import os
import sys

CAST = {"datetime": "todatetime", "string": "tostring", "long": "tolong", "int": "toint",
        "real": "todouble", "bool": "tobool", "dynamic": "todynamic", "timespan": "totimespan",
        "guid": "toguid", "decimal": "todecimal"}


def quote(name: str) -> str:
    return "['" + name.replace("\\", "\\\\").replace("'", "\\'") + "']"


def script(directory: str, prefix: str = "") -> str:
    with open(os.path.join(directory, "schema.json"), encoding="utf-8") as f:
        doc = json.load(f)
    out = [".set json.skipTypeInference on", ""]
    for name, table in doc["tables"].items():
        target = prefix + name
        path = os.path.join(os.path.abspath(directory), table["file"])
        cols = ", ".join(f"{quote(c['name'])}={CAST[c['type']]}({quote(c['name'])})" for c in table["columns"])
        # load under a scratch name, cast, keep the typed result as the table, drop the scratch
        out += [f'.load "{path}" {target}__raw', "", f"{quote(target + '__raw')} | project {cols}", "",
                f".materialize {target}", "", f".drop {target}__raw", ""]
    return "\n".join(out)


def main():
    args = [a for a in sys.argv[1:] if not a.startswith("--")]
    prefix = ""
    if "--prefix" in sys.argv:
        prefix = sys.argv[sys.argv.index("--prefix") + 1]
        args.remove(prefix)
    if len(args) != 1:
        sys.exit(__doc__)
    sys.stdout.write(script(args[0], prefix))


if __name__ == "__main__":
    main()
