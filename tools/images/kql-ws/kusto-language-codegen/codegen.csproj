<Project Sdk="Microsoft.NET.Sdk">
  <!-- Regenerates Kusto.Language's generated sources (syntax nodes, command grammars). Since
       2026-07-08 github.com/microsoft/Kusto-Query-Language ships them as T4 templates
       (*.tt) that only call the generator classes in src/Kusto.Language.Generators; this
       program calls the same methods.
       dotnet run -p:KustoLanguageSrc=<repo>/src -/- <repo>/src/Kusto.Language -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS0162;CS0168;CS0219;CS8632</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(KustoLanguageSrc)/Kusto.Language.Generators/*.cs" />
  </ItemGroup>
</Project>
