diff --git a/libraries/lokql-engine/Commands/MaterializeCommand.cs b/libraries/lokql-engine/Commands/MaterializeCommand.cs
index 598ffee2..dd909425 100644
--- a/libraries/lokql-engine/Commands/MaterializeCommand.cs
+++ b/libraries/lokql-engine/Commands/MaterializeCommand.cs
@@ -1,5 +1,6 @@
 ﻿using CommandLine;
 using KustoLoco.PluginSupport;
+using NotNullStrings;
 
 namespace Lokql.Engine.Commands;
 
@@ -10,7 +11,16 @@ public static class MaterializeCommand
         var console = context.Console;
         var queryContext = context.QueryContext;
         var history = context.History;
-        queryContext.MaterializeResultAsTable(history.Fetch(o.ResultName), o.As);
+        var result = history.Fetch(o.ResultName);
+        if (result.Error.IsNotBlank())
+        {
+            // a failed query has no rows or columns: materializing it would silently
+            // replace the table with an empty one
+            console.Error($"Not materializing '{o.As}': the query failed");
+            return Task.CompletedTask;
+        }
+
+        queryContext.MaterializeResultAsTable(result, o.As);
         console.Info($"Table {NameEscaper.EscapeIfNecessary(o.As)} now available");
         return Task.CompletedTask;
     }
diff --git a/libraries/lokql-engine/ErrorCountingConsole.cs b/libraries/lokql-engine/ErrorCountingConsole.cs
new file mode 100644
index 00000000..7908b44c
--- /dev/null
+++ b/libraries/lokql-engine/ErrorCountingConsole.cs
@@ -0,0 +1,43 @@
+﻿using KustoLoco.Core.Console;
+
+namespace Lokql.Engine;
+
+/// <summary>
+///     Passes everything through to another console and counts the errors written to it
+/// </summary>
+internal sealed class ErrorCountingConsole(IKustoConsole inner) : IKustoConsole
+{
+    public int Errors { get; private set; }
+
+    public int WindowWidth => inner.WindowWidth;
+
+    public ConsoleColor ForegroundColor
+    {
+        get => inner.ForegroundColor;
+        set => inner.ForegroundColor = value;
+    }
+
+    public void Write(string s) => inner.Write(s);
+
+    public void WriteLine(string s) => inner.WriteLine(s);
+
+    public string ReadLine() => inner.ReadLine();
+
+    public void Info(string s) => inner.Info(s);
+
+    public void Warn(string s) => inner.Warn(s);
+
+    public void Error(string s)
+    {
+        Errors++;
+        inner.Error(s);
+    }
+
+    public void Progress(string s) => inner.Progress(s);
+
+    public void ShowProgress(string s) => inner.ShowProgress(s);
+
+    public void CompleteProgress(string s) => inner.CompleteProgress(s);
+
+    public void RestoreColors() => inner.RestoreColors();
+}
