diff --git a/test/LokqlEngineTests/ScriptRobustnessTests.cs b/test/LokqlEngineTests/ScriptRobustnessTests.cs
new file mode 100644
index 00000000..383f98fe
--- /dev/null
+++ b/test/LokqlEngineTests/ScriptRobustnessTests.cs
@@ -0,0 +1,74 @@
+﻿using AwesomeAssertions;
+using Kusto.Language.Symbols;
+using KustoLoco.Core;
+using KustoLoco.Core.Console;
+using KustoLoco.Core.Evaluation.BuiltIns;
+using KustoLoco.Core.Settings;
+using Lokql.Engine;
+using Lokql.Engine.Commands;
+
+namespace LokqlEngineTests;
+
+/// <summary>
+///     Non-interactive use (scripts, CI, graders) must be able to trust the last result
+///     and know when something failed.
+/// </summary>
+[TestClass]
+public class ScriptRobustnessTests
+{
+    private static InteractiveTableExplorer CreateExplorer(IResultRenderingSurface surface)
+    {
+        var settings = new KustoSettingsProvider();
+        return new InteractiveTableExplorer(new NullConsole(), settings, CommandProcessor.Default(),
+            surface, new Dictionary<FunctionSymbol, ScalarFunctionInfo>());
+    }
+
+    [TestMethod]
+    public async Task FailedQueryIsCounted()
+    {
+        var explorer = CreateExplorer(new NullResultRenderingSurface());
+        await explorer.RunInput("print x=1");
+        explorer.ErrorCount.Should().Be(0);
+        await explorer.RunInput("print y=nosuchfunction(1)");
+        explorer.ErrorCount.Should().Be(1);
+    }
+
+    [TestMethod]
+    public async Task RenderingFailureKeepsTheResultAndIsCounted()
+    {
+        var explorer = CreateExplorer(new ThrowingSurface());
+        await explorer.RunInput("print x=1");
+        await explorer.RunInput("print x=2");
+        explorer.ErrorCount.Should().Be(2);
+        // the last result is the second query's, not the first one's
+        explorer._resultHistory.MostRecent.Get(0, 0).Should().Be(2L);
+    }
+
+    [TestMethod]
+    public async Task MaterializeRefusesAFailedQuery()
+    {
+        var explorer = CreateExplorer(new NullResultRenderingSurface());
+        await explorer.RunInput("datatable(a:long)[1,2,3]");
+        await explorer.RunInput(".materialize T");
+        await explorer.RunInput("T | extend b=nosuchfunction(a)");
+        await explorer.RunInput(".materialize T");
+        explorer.ErrorCount.Should().Be(2);
+        var result = await explorer.GetCurrentContext().RunQuery("T | count");
+        result.Get(0, 0).Should().Be(3L);
+    }
+
+    [TestMethod]
+    public async Task FailedLoadIsAnError()
+    {
+        var explorer = CreateExplorer(new NullResultRenderingSurface());
+        await explorer.RunInput($".load {Path.Combine(Path.GetTempPath(), Guid.NewGuid() + ".csv")}");
+        explorer.ErrorCount.Should().Be(1);
+    }
+
+    private sealed class ThrowingSurface : IResultRenderingSurface
+    {
+        public Task RenderToDisplay(KustoQueryResult result) => throw new InvalidOperationException("no terminal");
+
+        public byte[] RenderToImage(KustoQueryResult result, double pWidth, double pHeight) => [];
+    }
+}
