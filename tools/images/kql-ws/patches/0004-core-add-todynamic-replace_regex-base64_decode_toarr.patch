+﻿using System;
+using System.Linq;
+using System.Text.Json.Nodes;
+
+namespace KustoLoco.Core.Evaluation.BuiltIns.Impl;
+
+/// <summary>
+///     base64_decode_toarray(): the decoded bytes as a dynamic array of longs; null for
+///     input that is not valid base64. Used with unicode_codepoints_to_string() or to decode
+///     UTF-16 payloads such as PowerShell -EncodedCommand.
+/// </summary>
+[KustoImplementation(Keyword = "Functions.Base64DecodeToArray")]
+internal partial class Base64DecodeToArrayFunction
+{
+    private static JsonNode? Impl(string base64)
+    {
+        try
+        {
+            return new JsonArray(Convert.FromBase64String(base64).Select(b => (JsonNode?)JsonValue.Create((long)b)).ToArray());
+        }
+        catch (FormatException)
+        {
+            return null;
+        }
+    }
+}
