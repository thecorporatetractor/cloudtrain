--- /dev/null
+++ b/libraries/KustoLoco.Core/Evaluation/BuiltIns/ScalarFunctions/ToDynamicFunction.cs
@@ -0,0 +1,28 @@
+﻿using System.Text.Json;
+using System.Text.Json.Nodes;
+
+namespace KustoLoco.Core.Evaluation.BuiltIns.Impl;
+
+/// <summary>
+///     todynamic() is a synonym of parse_json(). The source generator inlines Impl bodies,
+///     so parse_json's logic is repeated here rather than called. Kusto declares the
+///     argument as string, so a dynamic argument arrives as its JSON text.
+/// </summary>
+[KustoImplementation(Keyword = "Functions.ToDynamic_")]
+public partial class ToDynamicFunction
+{
+    JsonNode? StringImpl(string input)
+    {
+        if (string.IsNullOrEmpty(input))
+            return null;
+        try
+        {
+            return JsonNode.Parse(input);
+        }
+        catch (JsonException)
+        {
+            // not JSON: a dynamic value holding the original string, as parse_json does
+            return JsonValue.Create(input);
+        }
+    }
+}
diff --git a/libraries/KustoLoco.Core/Evaluation/BuiltIns/ScalarFunctions/UnicodeCodepointsFunctions.cs b/libraries/KustoLoco.Core/Evaluation/BuiltIns/ScalarFunctions/UnicodeCodepointsFunctions.cs
new file mode 100644
index 00000000..4273c1d1
--- /dev/null
+++ b/libraries/KustoLoco.Core/Evaluation/BuiltIns/ScalarFunctions/UnicodeCodepointsFunctions.cs
@@ -0,0 +1,65 @@
+﻿using System.Linq;
+using System.Text;
+using System.Text.Json.Nodes;
+
+namespace KustoLoco.Core.Evaluation.BuiltIns.Impl;
+
+/// <summary>
+///     unicode_codepoints_to_string(dynamic array of code points); null if any element is not
+///     a valid code point
+/// </summary>
+[KustoImplementation(Keyword = "Functions.UnicodeCodepointsToString")]
+internal partial class UnicodeCodepointsToStringFunction
+{
+    private static string Impl(JsonNode codepoints)
+    {
+        if (codepoints is not JsonArray array)
+            return string.Empty;
+        var sb = new StringBuilder(array.Count);
+        foreach (var item in array)
+        {
+            if (!CodepointSupport.TryGetCodepoint(item, out var cp))
+                return string.Empty;
+            if (cp is < 0 or > 0x10FFFF or >= 0xD800 and <= 0xDFFF)
+                return string.Empty;
+            sb.Append(char.ConvertFromUtf32((int)cp));
+        }
+
+        return sb.ToString();
+    }
+}
+
+internal static class CodepointSupport
+{
+    internal static bool TryGetCodepoint(JsonNode? item, out long cp)
+    {
+        cp = 0;
+        if (item is not JsonValue v)
+            return false;
+        if (v.TryGetValue<long>(out cp))
+            return true;
+        if (v.TryGetValue<int>(out var i))
+        {
+            cp = i;
+            return true;
+        }
+
+        if (v.TryGetValue<double>(out var d) && d == System.Math.Floor(d))
+        {
+            cp = (long)d;
+            return true;
+        }
+
+        return false;
+    }
+}
+
+/// <summary>
+///     unicode_codepoints_from_string(string): dynamic array of the string's code points
+/// </summary>
+[KustoImplementation(Keyword = "Functions.UnicodeCodepointsFromString")]
+internal partial class UnicodeCodepointsFromStringFunction
+{
+    private static JsonNode Impl(string s) =>
+        new JsonArray(s.EnumerateRunes().Select(r => (JsonNode?)JsonValue.Create((long)r.Value)).ToArray());
+}
diff --git a/libraries/KustoLoco.Core/InternalRepresentation/Translation/IRTranslator.Expressions.cs b/libraries/KustoLoco.Core/InternalRepresentation/Translation/IRTranslator.Expressions.cs
index 75309216..9819f629 100644
--- a/libraries/KustoLoco.Core/InternalRepresentation/Translation/IRTranslator.Expressions.cs
+++ b/libraries/KustoLoco.Core/InternalRepresentation/Translation/IRTranslator.Expressions.cs
@@ -148,6 +148,26 @@ internal partial class IRTranslator : DefaultSyntaxVisitor<IRNode>
         return new IRLiteralExpressionNode(node.LiteralValue, node.ResultType);
     }
 
+    /// <summary>
+    ///     column_ifexists(name, default): the column when the input has one of that name,
+    ///     otherwise the default. Like Kusto, this is decided when the query is translated.
+    /// </summary>
+    private IRNode TranslateColumnIfExists(FunctionCallExpression node)
+    {
+        var args = node.ArgumentList.Expressions;
+        if (args.Count != 2 || args[0].Element is not LiteralExpression { LiteralValue: string name })
+            throw new InvalidOperationException("column_ifexists requires a constant column name and a default value");
+        var index = _rowScope == TableSymbol.Empty
+            ? -1
+            : _rowScope.Members.FirstIndex(m => m is ColumnSymbol && m.Name == name);
+        var result = index >= 0
+            ? new IRRowScopeNameReferenceNode(_rowScope.Members[index], ((ColumnSymbol)_rowScope.Members[index]).Type, index)
+            : (IRExpressionNode)args[1].Element.Accept(this);
+        return result.ResultType.Simplify() == node.ResultType.Simplify()
+            ? result
+            : new IRCastExpressionNode(result, node.ResultType);
+    }
+
     public override IRNode VisitDynamicExpression(DynamicExpression node)
     {
         var literalValue = (string)node.LiteralValue;
@@ -289,6 +309,8 @@ internal partial class IRTranslator : DefaultSyntaxVisitor<IRNode>
     {
         var signature = node.ReferencedSignature;
         var returnType = node.ResultType;
+        if (signature.Symbol == Functions.ColumnIfExists || signature.Symbol == Functions.ColumnIfExists_Deprecated)
+            return TranslateColumnIfExists(node);
 
         var arguments = new Expression[node.ArgumentList.Expressions.Count];
         var irArguments = new IRExpressionNode[arguments.Length];
