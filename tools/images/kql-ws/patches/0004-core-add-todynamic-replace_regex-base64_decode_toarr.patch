+﻿using AwesomeAssertions;
+
+namespace BasicTests;
+
+/// <summary>
+///     Scalar functions common in security queries that were missing or mis-typed
+/// </summary>
+[TestClass]
+public class ScalarCompatibilityTests : TestMethods
+{
+    [TestMethod]
+    public async Task HourOfDay()
+    {
+        var result = await LastLineOfResult("print h=hourofday(datetime(2026-10-18T13:05:00Z))");
+        result.Should().Be("13");
+    }
+
+    [TestMethod]
+    public async Task ToDynamicIsParseJson()
+    {
+        var result = await LastLineOfResult("print d=todynamic('{\"a\":[1,2,3]}') | project n=array_length(d.a)");
+        result.Should().Be("3");
+    }
+
+    [TestMethod]
+    public async Task ReplaceRegexWithBackReferences()
+    {
+        var result = await LastLineOfResult(@"print s=replace_regex('user=alice id=7', @'user=(\w+) id=(\d+)', @'\2:\1 costs $5')");
+        result.Should().Be("7:alice costs $5");
+    }
+
+    [TestMethod]
+    public async Task ReplaceLegacyArgumentOrder()
+    {
+        var result = await LastLineOfResult(@"print s=replace(@'\d', 'x', 'a1b22')");
+        result.Should().Be("axbxx");
+    }
+
+    [TestMethod]
+    public async Task Base64DecodeToArrayAndCodepoints()
+    {
+        // "hi" encoded as UTF-16LE, the form PowerShell -EncodedCommand uses
+        var result = await LastLineOfResult(
+            "print a=base64_decode_toarray('aABpAA==') " +
+            "| extend s=unicode_codepoints_to_string(a) " +
+            "| project n=array_length(a), len=strlen(s), text=replace_regex(s, @'\\x00', '')");
+        result.Should().Be("4,4,hi");
+    }
+
+    [TestMethod]
+    public async Task CodepointsRoundTrip()
+    {
+        var result = await LastLineOfResult("print s=unicode_codepoints_to_string(unicode_codepoints_from_string('Kql'))");
+        result.Should().Be("Kql");
+    }
+
+    [TestMethod]
+    public async Task InvalidBase64IsNull()
+    {
+        var result = await LastLineOfResult("print a=base64_decode_toarray('not base64!') | extend e=isnull(a)");
+        result.Should().EndWith("True");
+    }
+
+    [TestMethod]
+    public async Task ColumnIfExistsPicksTheColumn()
+    {
+        var result = await ResultAsString(
+            "datatable(ClientIP:string)['10.0.0.1'] | extend ip=column_ifexists('ClientIP', 'none') | project ip");
+        result.Should().Be("10.0.0.1");
+    }
+
+    [TestMethod]
+    public async Task ColumnIfExistsFallsBackToTheDefault()
+    {
+        var result = await ResultAsString(
+            "datatable(Other:string)['x'] | extend ip=column_ifexists('ClientIP', 'none') | project ip");
+        result.Should().Be("none");
+    }
+
+    [TestMethod]
+    public async Task ColumnIfExistsAcrossAFuzzyUnion()
+    {
+        var query = "union isfuzzy=true (datatable(IPAddress:string)['1.1.1.1']), (datatable(ClientIP:string)['2.2.2.2']) " +
+                    "| extend ip=coalesce(column_ifexists('IPAddress', ''), column_ifexists('ClientIP', '')) | project ip | order by ip asc";
+        var result = await ResultAsString(query);
+        result.Should().Be("1.1.1.1,2.2.2.2");
+    }
+}
