@@ -0,0 +1,50 @@
+﻿using System;
+using System.Text.RegularExpressions;
+
+namespace KustoLoco.Core.Evaluation.BuiltIns.Impl;
+
+/// <summary>
+///     replace_regex(source, lookup_regex, rewrite_pattern): rewrite_pattern refers to capture
+///     groups as \0..\9 (Kusto syntax), translated to .NET's ${n}. An invalid regex or a
+///     timeout returns the source unchanged.
+/// </summary>
+[KustoImplementation(Keyword = "Functions.ReplaceRegex")]
+internal partial class ReplaceRegexFunction
+{
+    private static string Impl(string source, string lookup, string rewrite) =>
+        RegexReplace.Replace(source, lookup, rewrite);
+}
+
+/// <summary>
+///     replace() is the older name of replace_regex() with the same arguments
+/// </summary>
+[KustoImplementation(Keyword = "Functions.Replace")]
+internal partial class ReplaceFunction
+{
+    private static string Impl(string lookup, string rewrite, string source) =>
+        RegexReplace.Replace(source, lookup, rewrite);
+}
+
+internal static class RegexReplace
+{
+    private static readonly Regex Backref = new(@"\\(\d)", RegexOptions.Compiled);
+    private static readonly TimeSpan Timeout = TimeSpan.FromSeconds(1);
+
+    internal static string Replace(string source, string lookup, string rewrite)
+    {
+        // escape '$' (special in .NET replacements), then \n -> ${n}
+        var dotnetRewrite = Backref.Replace(rewrite.Replace("$", "$$"), m => "${" + m.Groups[1].Value + "}");
+        try
+        {
+            return Regex.Replace(source, lookup, dotnetRewrite, RegexOptions.CultureInvariant, Timeout);
+        }
+        catch (ArgumentException)
+        {
+            return source;
+        }
+        catch (RegexMatchTimeoutException)
+        {
+            return source;
+        }
+    }
+}
diff --git a/libraries/KustoLoco.Core/Evaluation/BuiltIns/ScalarFunctions/ToDynamicFunction.cs b/libraries/KustoLoco.Core/Evaluation/BuiltIns/ScalarFunctions/ToDynamicFunction.cs
