+++ b/test/BasicTests/TermOperatorTests.cs
@@ -0,0 +1,59 @@
+﻿using AwesomeAssertions;
+
+namespace BasicTests;
+
+/// <summary>
+///     has, !has, has_any, has_all, hasprefix, hassuffix match whole terms, as in Kusto
+/// </summary>
+[TestClass]
+public class TermOperatorTests : TestMethods
+{
+    private async Task<string> Count(string predicate) =>
+        await LastLineOfResult($"datatable(s:string)['PowerShell.exe -enc AAA', 'C:\\\\Windows\\\\cmd.exe', 'src 198.51.100.97 port 22'] | where {predicate} | count");
+
+    [TestMethod]
+    public async Task HasMatchesWholeTermsOnly()
+    {
+        (await Count("s has 'shell'")).Should().Be("0");
+        (await Count("s has 'powershell'")).Should().Be("1");
+        (await Count("s has 'exe'")).Should().Be("2");
+        (await Count("s !has 'shell'")).Should().Be("3");
+    }
+
+    [TestMethod]
+    public async Task HasCaseSensitivity()
+    {
+        (await Count("s has_cs 'PowerShell'")).Should().Be("1");
+        (await Count("s has_cs 'powershell'")).Should().Be("0");
+        (await Count("s !has_cs 'powershell'")).Should().Be("3");
+    }
+
+    [TestMethod]
+    public async Task NeedleSpanningSeveralTerms()
+    {
+        (await Count("s has '198.51.100.'")).Should().Be("1");
+        (await Count("s has '98.51.100'")).Should().Be("0");
+        (await Count("s has 'port 22'")).Should().Be("1");
+    }
+
+    [TestMethod]
+    public async Task HasAnyAndHasAllUseTerms()
+    {
+        (await Count("s has_any ('shell', 'cmd')")).Should().Be("1");
+        (await Count("s has_all ('src', 'port')")).Should().Be("1");
+        (await Count("s has_all ('src', 'por')")).Should().Be("0");
+    }
+
+    [TestMethod]
+    public async Task HasPrefixAndHasSuffix()
+    {
+        (await Count("s hasprefix 'Power'")).Should().Be("1");
+        (await Count("s hasprefix 'Shell'")).Should().Be("0");
+        (await Count("s hassuffix 'shell'")).Should().Be("1");
+        (await Count("s hassuffix 'Power'")).Should().Be("0");
+        (await Count("s !hasprefix 'win'")).Should().Be("2");
+        (await Count("s hasprefix_cs 'power'")).Should().Be("0");
+        (await Count("s hassuffix_cs 'Shell'")).Should().Be("1");
+        (await Count("s !hassuffix_cs 'Shell'")).Should().Be("2");
+    }
+}
