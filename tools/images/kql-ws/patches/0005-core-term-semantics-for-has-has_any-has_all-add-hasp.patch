@@ -0,0 +1,50 @@
+﻿using System;
+
+namespace KustoLoco.Core.Evaluation.BuiltIns.Impl;
+
+/// <summary>
+///     Kusto's term semantics for has / hasprefix / hassuffix and their variants.
+/// </summary>
+/// <remarks>
+///     Kusto splits strings into terms, runs of alphanumeric characters, and these operators
+///     match terms rather than substrings: "PowerShell.exe" has "shell" is false, has "exe"
+///     is true. A needle may span several terms ("198.51.100." or "North America"); then only
+///     its ends must sit on term boundaries, and only where the needle itself starts or ends
+///     with an alphanumeric character. This follows the documented behaviour; edge cases of
+///     Kusto's tokenizer (e.g. Unicode categories) may differ.
+/// </remarks>
+internal static class TermMatch
+{
+    private static bool IsTermChar(char c) => char.IsLetterOrDigit(c);
+
+    /// <summary>needle occurs in text starting and ending on term boundaries</summary>
+    public static bool Has(string text, string needle, StringComparison comparison) =>
+        Find(text, needle, comparison, true, true);
+
+    /// <summary>needle occurs at the start of a term</summary>
+    public static bool HasPrefix(string text, string needle, StringComparison comparison) =>
+        Find(text, needle, comparison, true, false);
+
+    /// <summary>needle occurs at the end of a term</summary>
+    public static bool HasSuffix(string text, string needle, StringComparison comparison) =>
+        Find(text, needle, comparison, false, true);
+
+    private static bool Find(string text, string needle, StringComparison comparison, bool atStart, bool atEnd)
+    {
+        if (needle.Length == 0)
+            return true;
+        var checkStart = atStart && IsTermChar(needle[0]);
+        var checkEnd = atEnd && IsTermChar(needle[^1]);
+        for (var i = text.IndexOf(needle, comparison); i >= 0; i = text.IndexOf(needle, i + 1, comparison))
+        {
+            var end = i + needle.Length;
+            if (checkStart && i > 0 && IsTermChar(text[i - 1]))
+                continue;
+            if (checkEnd && end < text.Length && IsTermChar(text[end]))
+                continue;
+            return true;
+        }
+
+        return false;
+    }
+}
