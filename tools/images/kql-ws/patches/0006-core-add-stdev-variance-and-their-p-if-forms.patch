+﻿using AwesomeAssertions;
+
+namespace BasicTests;
+
+[TestClass]
+public class VarianceAggregateTests : TestMethods
+{
+    // 2,4,4,4,5,5,7,9: mean 5, squared deviations 32 -> population variance 4, sample 32/7
+    private const string Data = "datatable(v:long, k:string)[2,'a',4,'a',4,'b',4,'b',5,'a',5,'b',7,'a',9,'b']";
+
+    [TestMethod]
+    public async Task PopulationAndSample()
+    {
+        var result = await LastLineOfResult(
+            $"{Data} | summarize vp=variancep(v), sp=stdevp(v), vs=round(variance(v), 6), ss=round(stdev(v), 6)");
+        result.Should().Be("4,2,4.571429,2.13809");
+    }
+
+    [TestMethod]
+    public async Task ConditionalForms()
+    {
+        // k == 'a': 2,4,5,7 -> mean 4.5, squared deviations 13 -> sample variance 13/3
+        var result = await LastLineOfResult(
+            $"{Data} | summarize vi=round(varianceif(v, k == 'a'), 6), si=round(stdevif(v, k == 'a'), 6), vpi=variancepif(v, k == 'a')");
+        result.Should().Be("4.333333,2.081666,3.25");
+    }
+
+    [TestMethod]
+    public async Task SingleValueAndReals()
+    {
+        var result = await LastLineOfResult("datatable(r:real)[1.5] | summarize s=stdev(r), p=stdevp(r)");
+        result.Should().Be("0,0");
+    }
+
+    [TestMethod]
+    public async Task ByGroupForBeaconRegularity()
+    {
+        var result = await ResultAsString(
+            "datatable(h:string, gap:int)['c2',300,'c2',301,'c2',299,'web',5,'web',900,'web',40] " +
+            "| summarize cv=round(stdev(gap)/avg(gap), 3) by h | order by h asc");
+        result.Should().Be("c2,0.003,web,1.609");
+    }
+}
