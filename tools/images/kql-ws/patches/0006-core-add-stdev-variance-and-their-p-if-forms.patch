+﻿using System;
+using System.Collections.Concurrent;
+using System.Linq;
+
+// ReSharper disable PartialTypeWithSinglePart
+namespace KustoLoco.Core.Evaluation.BuiltIns.Impl;
+
+/// <summary>
+///     Shared accumulation for stdev/variance and their population (p) and conditional (if)
+///     forms. Sample statistics divide by n-1 (0 for a single value), population ones by n;
+///     no values gives null.
+/// </summary>
+internal static class VarianceSupport
+{
+    internal static double Add(NumericAggregate context, double value)
+    {
+        context.Count++;
+        context.DoubleValue += value;
+        context.SumOfSquares += value * value;
+        return 0;
+    }
+
+    internal static double? Variance(ConcurrentBag<NumericAggregate> contexts, bool population)
+    {
+        var n = contexts.Sum(c => (long)c.Count);
+        if (n == 0)
+            return null;
+        var sum = contexts.Sum(c => c.DoubleValue);
+        var sumSquares = contexts.Sum(c => c.SumOfSquares);
+        var mean = sum / n;
+        var squaredDeviations = Math.Max(0, sumSquares - n * mean * mean);
+        if (population)
+            return squaredDeviations / n;
+        return n == 1 ? 0 : squaredDeviations / (n - 1);
+    }
+
+    internal static double? Stdev(ConcurrentBag<NumericAggregate> contexts, bool population)
+    {
+        var v = Variance(contexts, population);
+        return v is null ? null : Math.Sqrt(v.Value);
+    }
+}
+
+[KustoImplementation(Keyword = "Aggregates.Stdev")]
+internal partial class StdevAggregate
+{
+    internal static double IntImpl(NumericAggregate context, int n) => VarianceSupport.Add(context, n);
+
+    internal static double? IntImplFinish(ConcurrentBag<NumericAggregate> contexts) => VarianceSupport.Stdev(contexts, false);
+
+    internal static double LongImpl(NumericAggregate context, long n) => VarianceSupport.Add(context, n);
+
+    internal static double? LongImplFinish(ConcurrentBag<NumericAggregate> contexts) => VarianceSupport.Stdev(contexts, false);
+
+    internal static double DoubleImpl(NumericAggregate context, double n) => VarianceSupport.Add(context, n);
+
+    internal static double? DoubleImplFinish(ConcurrentBag<NumericAggregate> contexts) => VarianceSupport.Stdev(contexts, false);
+}
+
+[KustoImplementation(Keyword = "Aggregates.StdevIf")]
+internal partial class StdevIfAggregate
+{
+    internal static double IntImpl(NumericAggregate context, int n, bool t) => t ? VarianceSupport.Add(context, n) : 0;
+
+    internal static double? IntImplFinish(ConcurrentBag<NumericAggregate> contexts) => VarianceSupport.Stdev(contexts, false);
+
+    internal static double LongImpl(NumericAggregate context, long n, bool t) => t ? VarianceSupport.Add(context, n) : 0;
+
+    internal static double? LongImplFinish(ConcurrentBag<NumericAggregate> contexts) => VarianceSupport.Stdev(contexts, false);
+
+    internal static double DoubleImpl(NumericAggregate context, double n, bool t) => t ? VarianceSupport.Add(context, n) : 0;
+
+    internal static double? DoubleImplFinish(ConcurrentBag<NumericAggregate> contexts) => VarianceSupport.Stdev(contexts, false);
+}
+
+[KustoImplementation(Keyword = "Aggregates.Stdevp")]
+internal partial class StdevpAggregate
+{
+    internal static double IntImpl(NumericAggregate context, int n) => VarianceSupport.Add(context, n);
+
+    internal static double? IntImplFinish(ConcurrentBag<NumericAggregate> contexts) => VarianceSupport.Stdev(contexts, true);
+
+    internal static double LongImpl(NumericAggregate context, long n) => VarianceSupport.Add(context, n);
+
+    internal static double? LongImplFinish(ConcurrentBag<NumericAggregate> contexts) => VarianceSupport.Stdev(contexts, true);
+
+    internal static double DoubleImpl(NumericAggregate context, double n) => VarianceSupport.Add(context, n);
+
+    internal static double? DoubleImplFinish(ConcurrentBag<NumericAggregate> contexts) => VarianceSupport.Stdev(contexts, true);
+}
+
+[KustoImplementation(Keyword = "Aggregates.Variance")]
+internal partial class VarianceAggregate
+{
+    internal static double IntImpl(NumericAggregate context, int n) => VarianceSupport.Add(context, n);
+
+    internal static double? IntImplFinish(ConcurrentBag<NumericAggregate> contexts) => VarianceSupport.Variance(contexts, false);
+
+    internal static double LongImpl(NumericAggregate context, long n) => VarianceSupport.Add(context, n);
+
+    internal static double? LongImplFinish(ConcurrentBag<NumericAggregate> contexts) => VarianceSupport.Variance(contexts, false);
+
+    internal static double DoubleImpl(NumericAggregate context, double n) => VarianceSupport.Add(context, n);
+
+    internal static double? DoubleImplFinish(ConcurrentBag<NumericAggregate> contexts) => VarianceSupport.Variance(contexts, false);
+}
+
+[KustoImplementation(Keyword = "Aggregates.VarianceIf")]
+internal partial class VarianceIfAggregate
+{
+    internal static double IntImpl(NumericAggregate context, int n, bool t) => t ? VarianceSupport.Add(context, n) : 0;
+
+    internal static double? IntImplFinish(ConcurrentBag<NumericAggregate> contexts) => VarianceSupport.Variance(contexts, false);
+
+    internal static double LongImpl(NumericAggregate context, long n, bool t) => t ? VarianceSupport.Add(context, n) : 0;
+
+    internal static double? LongImplFinish(ConcurrentBag<NumericAggregate> contexts) => VarianceSupport.Variance(contexts, false);
+
+    internal static double DoubleImpl(NumericAggregate context, double n, bool t) => t ? VarianceSupport.Add(context, n) : 0;
+
+    internal static double? DoubleImplFinish(ConcurrentBag<NumericAggregate> contexts) => VarianceSupport.Variance(contexts, false);
+}
+
+[KustoImplementation(Keyword = "Aggregates.Variancep")]
+internal partial class VariancepAggregate
+{
+    internal static double IntImpl(NumericAggregate context, int n) => VarianceSupport.Add(context, n);
+
+    internal static double? IntImplFinish(ConcurrentBag<NumericAggregate> contexts) => VarianceSupport.Variance(contexts, true);
+
+    internal static double LongImpl(NumericAggregate context, long n) => VarianceSupport.Add(context, n);
+
+    internal static double? LongImplFinish(ConcurrentBag<NumericAggregate> contexts) => VarianceSupport.Variance(contexts, true);
+
+    internal static double DoubleImpl(NumericAggregate context, double n) => VarianceSupport.Add(context, n);
+
+    internal static double? DoubleImplFinish(ConcurrentBag<NumericAggregate> contexts) => VarianceSupport.Variance(contexts, true);
+}
+
+[KustoImplementation(Keyword = "Aggregates.VariancepIf")]
+internal partial class VariancepIfAggregate
+{
+    internal static double IntImpl(NumericAggregate context, int n, bool t) => t ? VarianceSupport.Add(context, n) : 0;
+
+    internal static double? IntImplFinish(ConcurrentBag<NumericAggregate> contexts) => VarianceSupport.Variance(contexts, true);
+
+    internal static double LongImpl(NumericAggregate context, long n, bool t) => t ? VarianceSupport.Add(context, n) : 0;
+
+    internal static double? LongImplFinish(ConcurrentBag<NumericAggregate> contexts) => VarianceSupport.Variance(contexts, true);
+
+    internal static double DoubleImpl(NumericAggregate context, double n, bool t) => t ? VarianceSupport.Add(context, n) : 0;
+
+    internal static double? DoubleImplFinish(ConcurrentBag<NumericAggregate> contexts) => VarianceSupport.Variance(contexts, true);
+}
