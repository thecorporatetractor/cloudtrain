new file mode 100644
index 00000000..010093c5
--- /dev/null
+++ b/applications/lokql/QuietConsole.cs
@@ -0,0 +1,34 @@
+﻿using KustoLoco.Core.Console;
+
+/// <summary>
+///     The system console with a switch that silences everything except errors
+/// </summary>
+internal sealed class QuietConsole : IKustoConsole
+{
+    private readonly SystemConsole _inner = new();
+
+    public bool Quiet { get; set; }
+
+    public int WindowWidth => _inner.WindowWidth;
+
+    public ConsoleColor ForegroundColor
+    {
+        get => _inner.ForegroundColor;
+        set => _inner.ForegroundColor = value;
+    }
+
+    public void Write(string s)
+    {
+        if (!Quiet)
+            _inner.Write(s);
+    }
+
+    public void WriteLine(string s) => Write(s + Environment.NewLine);
+
+    public string ReadLine() => _inner.ReadLine();
+
+    // errors are always shown, bypassing the switch
+    public void Error(string s) => ((IKustoConsole)_inner).Error(s);
+
+    public void RestoreColors() => _inner.RestoreColors();
+}
