+//
+// Licensed under the MIT License.
+
+using System;
+using System.Collections.Generic;
+using System.Text.RegularExpressions;
+using Kusto.Language.Symbols;
+
+namespace KustoLoco.Core.InternalRepresentation.Nodes.Expressions.QueryOperators;
+
+/// <summary>
+///     parse [kind=simple|regex|relaxed] [flags=...] Expression with Pattern
+/// </summary>
+/// <remarks>
+///     The pattern is compiled once into a .NET regex with one group per capture column.
+///     Captures are in pattern order; each has the KQL type it was declared with.
+/// </remarks>
+internal class IRParseOperatorNode : IRQueryOperatorNode
+{
+    public IRParseOperatorNode(IRExpressionNode expression, Regex regex, List<ColumnSymbol> captures, bool relaxed,
+        TypeSymbol resultType)
+        : base(resultType)
+    {
+        Expression = expression ?? throw new ArgumentNullException(nameof(expression));
+        Regex = regex;
+        Captures = captures;
+        Relaxed = relaxed;
+    }
+
+    public IRExpressionNode Expression { get; }
+    public Regex Regex { get; }
+    public List<ColumnSymbol> Captures { get; }
+
+    /// <summary>relaxed: a capture that does not convert to its type becomes null instead of failing the match</summary>
+    public bool Relaxed { get; }
+
+    public override int ChildCount => 1;
+
+    public override IRNode GetChild(int index) =>
+        index == 0 ? Expression : throw new ArgumentOutOfRangeException(nameof(index));
+
+    public override TResult Accept<TResult, TContext>(IRNodeVisitor<TResult, TContext> visitor, TContext context)
+        => visitor.VisitParseOperator(this, context);
+
+    public override string ToString() => $"ParseOperator: {Regex} -> {SchemaDisplay.GetText(ResultType)}";
+}
