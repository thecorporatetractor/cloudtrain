+//
+// Licensed under the MIT License.
+
+using System;
+using System.Collections.Generic;
+using System.Linq;
+using System.Text;
+using System.Text.RegularExpressions;
+using Kusto.Language.Symbols;
+using Kusto.Language.Syntax;
+using KustoLoco.Core.InternalRepresentation.Nodes.Expressions;
+using KustoLoco.Core.InternalRepresentation.Nodes.Expressions.QueryOperators;
+
+namespace KustoLoco.Core.InternalRepresentation;
+
+internal partial class IRTranslator
+{
+    private static readonly TimeSpan ParseRegexTimeout = TimeSpan.FromSeconds(1);
+
+    /// <summary>
+    ///     parse [kind=simple|regex|relaxed] [flags=imsU] Expression with [*] "const" Col[:type] ... [*]
+    /// </summary>
+    /// <remarks>
+    ///     The pattern becomes one regex, anchored at the start unless it begins with '*'.
+    ///     simple/relaxed: string constants match literally. regex: constants are regex fragments.
+    ///     A capture is lazy (".*?" for strings, a type-shaped regex for numbers and bools) except a
+    ///     capture that ends the pattern, which takes the rest of the input.
+    /// </remarks>
+    public override IRNode VisitParseOperator(ParseOperator node)
+    {
+        var kind = "simple";
+        var flags = string.Empty;
+        foreach (var p in node.Parameters)
+        {
+            var value = p.Expression.ToString().Trim().Trim('"', '\'');
+            if (string.Equals(p.Name.SimpleName, "kind", StringComparison.OrdinalIgnoreCase))
+                kind = value.ToLowerInvariant();
+            else if (string.Equals(p.Name.SimpleName, "flags", StringComparison.OrdinalIgnoreCase))
+                flags = value;
+        }
+
+        if (kind is not ("simple" or "regex" or "relaxed"))
+            throw new NotImplementedException($"parse kind={kind} is not supported");
+
+        var isRegex = kind == "regex";
+        var ungreedy = flags.Contains('U');
+        var resultType = (TableSymbol)node.ResultType;
+        var captures = new List<ColumnSymbol>();
+        var sb = new StringBuilder();
+        var elements = node.Patterns.ToList();
+        if (elements.Count == 0 || elements[0] is not StarExpression)
+            sb.Append('^');
+
+        for (var i = 0; i < elements.Count; i++)
+        {
+            var element = elements[i];
+            var isLast = i == elements.Count - 1;
+            switch (element)
+            {
+                case StarExpression:
+                    sb.Append(isLast ? "(?:.*)" : "(?:.*?)");
+                    break;
+                case LiteralExpression literal:
+                    var text = literal.LiteralValue?.ToString() ?? string.Empty;
+                    sb.Append(isRegex ? $"(?:{text})" : Regex.Escape(text));
+                    break;
+                case CompoundStringLiteralExpression compound:
+                    var joined = string.Concat(compound.Tokens.Select(t => t.Text.Trim('"', '\'')));
+                    sb.Append(isRegex ? $"(?:{joined})" : Regex.Escape(joined));
+                    break;
+                default:
+                    var name = CaptureName(element)
+                               ?? throw new NotImplementedException(
+                                   $"parse pattern element '{element}' is not supported");
+                    var column = resultType.Columns.First(c => c.Name == name);
+                    captures.Add(column);
+                    sb.Append($"(?<c{captures.Count - 1}>{CaptureRegex(column.Type, isLast, kind, ungreedy)})");
+                    break;
+            }
+        }
+
+        var options = RegexOptions.CultureInvariant | RegexOptions.Compiled;
+        if (flags.Contains('i')) options |= RegexOptions.IgnoreCase;
+        if (flags.Contains('m')) options |= RegexOptions.Multiline;
+        if (flags.Contains('s')) options |= RegexOptions.Singleline;
+        var regex = new Regex(sb.ToString(), options, ParseRegexTimeout);
+
+        var expression = (IRExpressionNode)node.Expression.Accept(this);
+        return new IRParseOperatorNode(expression, regex, captures, kind == "relaxed", node.ResultType);
+    }
+
+    private static string? CaptureName(SyntaxNode element) =>
+        element switch
+        {
+            NameAndTypeDeclaration nt => nt.Name.SimpleName,
+            NameDeclaration nd => nd.SimpleName,
+            NameReference nr => nr.SimpleName,
+            _ => null
+        };
+
+    private static string CaptureRegex(TypeSymbol type, bool isLast, string kind, bool ungreedy)
+    {
+        var lazy = ungreedy ? "" : "?";
+        if (isLast)
+            return type == ScalarTypes.String || type == ScalarTypes.Dynamic || kind == "relaxed"
+                ? ".*"
+                : TypedCapture(type) ?? ".*";
+
+        if (kind == "relaxed")
+            return $".*{lazy}";
+        return TypedCapture(type) ?? $".*{lazy}";
+    }
+
+    private static string? TypedCapture(TypeSymbol type)
+    {
+        if (type == ScalarTypes.Long || type == ScalarTypes.Int)
+            return @"[-+]?\d+";
+        if (type == ScalarTypes.Real || type == ScalarTypes.Decimal)
+            return @"[-+]?(?:\d+(?:\.\d*)?|\.\d+)(?:[eE][-+]?\d+)?";
+        if (type == ScalarTypes.Bool)
+            return @"(?i:true|false|1|0)";
+        return null;
+    }
+}
