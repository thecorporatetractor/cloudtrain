+using AwesomeAssertions;
+
+namespace BasicTests;
+
+[TestClass]
+public class ParseOperatorTests : TestMethods
+{
+    private const string Sshd =
+        "datatable(Msg:string)['Failed password for invalid user admin from 192.0.2.5 port 2222 ssh2']";
+
+    [TestMethod]
+    public async Task Parse_SimpleWithTypedCapture()
+    {
+        var query = Sshd +
+                    " | parse Msg with 'Failed password for invalid user ' User ' from ' SrcIP ' port ' Port:int ' ssh2'" +
+                    " | project User, SrcIP, Port, P2 = Port + 1";
+        var result = await ResultAsString(query);
+        result.Should().Be("admin,192.0.2.5,2222,2223");
+    }
+
+    [TestMethod]
+    public async Task Parse_TypedCaptureHasDeclaredType()
+    {
+        var query = Sshd +  " | parse Msg with * 'port ' Port:long ' ' * | getschema | where ColumnName == 'Port' | project ColumnType";
+        var result = await ResultAsString(query);
+        result.Should().Be("long");
+    }
+
+    [TestMethod]
+    public async Task Parse_NonMatchingRowIsKeptWithEmptyColumns()
+    {
+        var query = "datatable(Msg:string)['user=bob id=7', 'no match here']" +
+                    " | parse Msg with 'user=' Name ' id=' Id:long" +
+                    " | project Msg, Name, IdIsNull = isnull(Id)";
+        var result = await ResultAsString(query, ";");
+        result.Should().Be("user=bob id=7,bob,False;no match here,,True");
+    }
+
+    [TestMethod]
+    public async Task Parse_LeadingStarSkipsPrefix()
+    {
+        var query = Sshd + " | parse Msg with * 'user ' User ' from ' * | project User";
+        var result = await ResultAsString(query);
+        result.Should().Be("admin");
+    }
+
+    [TestMethod]
+    public async Task Parse_WithoutLeadingStarIsAnchoredAtStart()
+    {
+        var query = Sshd + " | parse Msg with 'user ' User ' from ' * | project Empty = isempty(User)";
+        var result = await ResultAsString(query);
+        result.Should().Be("True");
+    }
+
+    [TestMethod]
+    public async Task Parse_LastCaptureTakesTheRest()
+    {
+        var query = "datatable(Msg:string)['k=a b c'] | parse Msg with 'k=' Rest | project Rest";
+        var result = await ResultAsString(query);
+        result.Should().Be("a b c");
+    }
+
+    [TestMethod]
+    public async Task Parse_KindRegex()
+    {
+        var query = Sshd +
+                    @" | parse kind=regex Msg with * @'for (invalid user )?' User @'\s+from\s+' SrcIP @'\s+port\s+' Port:int" +
+                    " | project User, SrcIP, Port";
+        var result = await ResultAsString(query);
+        result.Should().Be("admin,192.0.2.5,2222");
+    }
+
+    [TestMethod]
+    public async Task Parse_KindRegexIgnoreCaseFlag()
+    {
+        var query = "datatable(Msg:string)['USER=Ann'] | parse kind=regex flags=i Msg with 'user=' Name | project Name";
+        var result = await ResultAsString(query);
+        result.Should().Be("Ann");
+    }
+
+    [TestMethod]
+    public async Task Parse_RelaxedBadIntBecomesNull()
+    {
+        var query = "datatable(Msg:string)['id=abc name=zed']" +
+                    " | parse kind=relaxed Msg with 'id=' Id:int ' name=' Name" +
+                    " | project IdIsNull = isnull(Id), Name";
+        var result = await ResultAsString(query);
+        result.Should().Be("True,zed");
+    }
+
+    [TestMethod]
+    public async Task Parse_SimpleBadIntFailsTheMatch()
+    {
+        var query = "datatable(Msg:string)['id=abc name=zed']" +
+                    " | parse Msg with 'id=' Id:int ' name=' Name" +
+                    " | project IdIsNull = isnull(Id), Name";
+        var result = await ResultAsString(query);
+        result.Should().Be("True,");
+    }
+
+    [TestMethod]
+    public async Task Parse_OnDynamicMemberViaTostring()
+    {
+        var query = "datatable(d:dynamic)[dynamic({\"msg\":\"src=10.0.0.1 dst=10.0.0.2\"})]" +
+                    " | parse tostring(d.msg) with 'src=' Src ' dst=' Dst | project Src, Dst";
+        var result = await ResultAsString(query);
+        result.Should().Be("10.0.0.1,10.0.0.2");
+    }
+
+    [TestMethod]
+    public async Task Parse_KeepsExistingColumnsAndFeedsSummarize()
+    {
+        var query = "datatable(Host:string, Msg:string)['a','from 1.1.1.1 port 1','a','from 1.1.1.1 port 2','b','from 2.2.2.2 port 3']" +
+                    " | parse Msg with 'from ' Ip ' port ' Port:long" +
+                    " | summarize n=count(), p=sum(Port) by Host, Ip | order by Host asc";
+        var result = await ResultAsString(query, ";");
+        result.Should().Be("a,1.1.1.1,2,3;b,2.2.2.2,1,3");
+    }
+}
