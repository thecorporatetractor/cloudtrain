@@ -0,0 +1,179 @@
+//
+// Licensed under the MIT License.
+
+using System;
+using System.Collections.Generic;
+using System.Globalization;
+using System.Linq;
+using System.Text.Json;
+using System.Text.Json.Nodes;
+using System.Text.RegularExpressions;
+using Kusto.Language.Symbols;
+using KustoLoco.Core.DataSource;
+using KustoLoco.Core.DataSource.Columns;
+using KustoLoco.Core.InternalRepresentation.Nodes.Expressions.QueryOperators;
+using KustoLoco.Core.Util;
+
+namespace KustoLoco.Core.Evaluation;
+
+internal partial class TreeEvaluator
+{
+    public override EvaluationResult VisitParseOperator(IRParseOperatorNode node, EvaluationContext context)
+    {
+        var result = new ParseResultTable(this, context.Left.Value, context, node);
+        return TabularResult.CreateWithVisualisation(result, context.Left.VisualizationState);
+    }
+
+    /// <summary>
+    ///     Adds one column per capture. Every input row is kept: a row whose text does not match
+    ///     gets empty strings / nulls in the new columns (as in Kusto).
+    /// </summary>
+    private class ParseResultTable : DerivedTableSourceBase<NoContext>
+    {
+        private readonly EvaluationContext _context;
+        private readonly IRParseOperatorNode _node;
+        private readonly TreeEvaluator _owner;
+
+        public ParseResultTable(TreeEvaluator owner, ITableSource input, EvaluationContext context,
+            IRParseOperatorNode node)
+            : base(input)
+        {
+            _owner = owner;
+            _context = context;
+            _node = node;
+            Type = (TableSymbol)node.ResultType;
+        }
+
+        public override TableSymbol Type { get; }
+
+        protected override (NoContext NewContext, ITableChunk NewChunk, bool ShouldBreak) ProcessChunk(NoContext _,
+            ITableChunk chunk)
+        {
+            var chunkContext = _context with { Chunk = chunk };
+            var evaluated = _node.Expression.Accept(_owner, chunkContext);
+            var rowCount = chunk.RowCount;
+            Func<int, object?> valueAt = evaluated switch
+            {
+                ColumnarResult c => c.Column.GetRawDataValue,
+                ScalarResult s => _ => s.Value,
+                _ => throw new InvalidOperationException("parse requires a scalar or columnar expression")
+            };
+
+            var captures = _node.Captures;
+            var builders = captures
+                .Select(c => NullableSetBuilderLocator.GetFixedNullableSetBuilderForType(
+                    TypeMapping.UnderlyingTypeForSymbol(c.Type), rowCount))
+                .ToArray();
+            var values = new object?[captures.Count];
+
+            for (var row = 0; row < rowCount; row++)
+            {
+                var matched = TryMatch(AsText(valueAt(row)), values);
+                for (var i = 0; i < captures.Count; i++)
+                    builders[i].Add(matched ? values[i] : EmptyValue(captures[i].Type));
+            }
+
+            var captureIndex = captures.Select((c, i) => (c.Name, i)).ToDictionary(t => t.Name, t => t.i);
+            var inputIndex = new Dictionary<string, int>();
+            for (var i = 0; i < Source.Type.Columns.Count; i++)
+                inputIndex[Source.Type.Columns[i].Name] = i;
+
+            var outputColumns = new BaseColumn[Type.Columns.Count];
+            for (var i = 0; i < Type.Columns.Count; i++)
+            {
+                var name = Type.Columns[i].Name;
+                if (captureIndex.TryGetValue(name, out var ci))
+                    outputColumns[i] = ColumnFactory.CreateFromDataSet(builders[ci].ToINullableSet());
+                else if (inputIndex.TryGetValue(name, out var ii))
+                    outputColumns[i] = chunk.Columns[ii];
+                else
+                    throw new InvalidOperationException($"parse: column '{name}' not found");
+            }
+
+            return (default, new TableChunk(this, outputColumns), false);
+        }
+
+        private bool TryMatch(string? text, object?[] values)
+        {
+            if (text is null)
+                return false;
+            Match m;
+            try
+            {
+                m = _node.Regex.Match(text);
+            }
+            catch (RegexMatchTimeoutException)
+            {
+                return false;
+            }
+
+            if (!m.Success)
+                return false;
+            for (var i = 0; i < _node.Captures.Count; i++)
+            {
+                var raw = m.Groups[$"c{i}"].Value;
+                if (TryConvert(raw, _node.Captures[i].Type, out var v))
+                    values[i] = v;
+                else if (_node.Relaxed)
+                    values[i] = null;
+                else
+                    return false;
+            }
+
+            return true;
+        }
+
+        private static string? AsText(object? value) =>
+            value switch
+            {
+                null => null,
+                string s => s,
+                JsonValue jv when jv.TryGetValue<string>(out var s) => s,
+                JsonNode jn => jn.ToJsonString(),
+                IFormattable f => f.ToString(null, CultureInfo.InvariantCulture),
+                _ => value.ToString()
+            };
+
+        private static object? EmptyValue(TypeSymbol type) => type == ScalarTypes.String ? string.Empty : null;
+
+        private static bool TryConvert(string raw, TypeSymbol type, out object? value)
+        {
+            value = null;
+            var inv = CultureInfo.InvariantCulture;
+            if (type == ScalarTypes.String)
+            {
+                value = raw;
+                return true;
+            }
+
+            if (raw.Length == 0)
+                return false;
+            if (type == ScalarTypes.Long && long.TryParse(raw, NumberStyles.Integer, inv, out var l)) value = l;
+            else if (type == ScalarTypes.Int && int.TryParse(raw, NumberStyles.Integer, inv, out var n)) value = n;
+            else if (type == ScalarTypes.Real && double.TryParse(raw, NumberStyles.Float, inv, out var d)) value = d;
+            else if (type == ScalarTypes.Decimal && decimal.TryParse(raw, NumberStyles.Float, inv, out var m)) value = m;
+            else if (type == ScalarTypes.Bool)
+            {
+                if (raw is "1" or "0") value = raw == "1";
+                else if (bool.TryParse(raw, out var b)) value = b;
+            }
+            else if (type == ScalarTypes.DateTime && DateTime.TryParse(raw, inv,
+                         DateTimeStyles.AssumeUniversal | DateTimeStyles.AdjustToUniversal, out var dt)) value = dt;
+            else if (type == ScalarTypes.TimeSpan && TimeSpan.TryParse(raw, inv, out var ts)) value = ts;
+            else if (type == ScalarTypes.Guid && Guid.TryParse(raw, out var g)) value = g;
+            else if (type == ScalarTypes.Dynamic)
+            {
+                try
+                {
+                    value = JsonNode.Parse(raw);
+                }
+                catch (JsonException)
+                {
+                    value = JsonValue.Create(raw);
+                }
+            }
+
+            return value != null;
+        }
+    }
+}
