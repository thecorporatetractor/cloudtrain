+    [TestMethod]
+    public async Task MakeSeries_OmittedFromTo_UsesTheBinsThatHoldData()
+    {
+        // With no 'from'/'to', ADX starts at bin(min(axis), step) and ends just past bin(max(axis), step): the
+        // first and last bins are the ones holding the earliest and latest rows.
+        var q = "datatable(t:datetime, v:long)[datetime(2026-10-01T10:20:00Z),1, datetime(2026-10-01T10:50:00Z),1, " +
+                "datetime(2026-10-01T13:05:00Z),1] | make-series n=count() on t step 1h";
+        var result = await Result(q);
+        var row = result.GetRow(0).ToArray();
+        Squash(row[0]?.ToString() ?? "").Should().Be("[2,0,0,1]");
+        var axis = row[1]?.ToString() ?? "";
+        axis.Should().Contain("2026-10-01T10:00:00.0000000Z").And.Contain("2026-10-01T13:00:00.0000000Z")
+            .And.NotContain("2026-10-01T14:00");
+    }
+
+    [TestMethod]
+    public async Task MakeSeries_OmittedFromTo_WithBy_SharesOneAxis()
+    {
+        // The range comes from the whole input, so every group's series has the same length and axis.
+        var q = "datatable(t:datetime, k:string)[datetime(2026-10-01T00:10:00Z),'a', datetime(2026-10-01T02:10:00Z),'b'] " +
+                "| make-series n=count() default=0 on t step 1h by k | order by k asc";
+        var result = await ResultAsString(q, ";");
+        Squash(result).Should().Contain("a,[1,0,0]").And.Contain("b,[0,0,1]");
+    }
+
+    [TestMethod]
+    public async Task MakeSeries_OnlyFromGiven_EndsAfterTheLastData()
+    {
+        var q = "datatable(x:long, v:long)[3,1, 7,1] | make-series n=count() on x from 0 step 2";
+        var result = await Result(q);
+        Squash(result.GetRow(0)[0]?.ToString() ?? "").Should().Be("[0,1,0,1]");
+    }
+
+    [TestMethod]
+    public async Task MakeSeries_OmittedRange_EmptyInput_NoRows()
+    {
+        var q = "datatable(t:datetime, v:long)[] | make-series n=count() on t step 1h";
