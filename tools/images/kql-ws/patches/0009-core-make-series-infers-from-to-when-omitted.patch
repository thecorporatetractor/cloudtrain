+    /// <summary>
+    ///     ADX semantics for an omitted range: 'from' is the first bin that holds data, bin(min(axis), step), and 'to'
+    ///     (exclusive) is just past the last one, bin(max(axis), step) + step. Bins align to zero (0 ticks for
+    ///     datetime/timespan), as bin() does. Explicit bounds are kept. With no non-null axis values the range is
+    ///     empty, so no series rows are produced.
+    /// </summary>
+    private static (object? from, object? to) InferSeriesRange(BaseColumn axis, int rowCount, object? stepVal,
+        object? explicitFrom, object? explicitTo)
+    {
+        object? min = null, max = null;
+        for (var r = 0; r < rowCount; r++)
+        {
+            var v = axis.GetRawDataValue(r);
+            if (v is null) continue;
+            if (min is null || Comparer<object>.Default.Compare(v, min) < 0) min = v;
+            if (max is null || Comparer<object>.Default.Compare(v, max) > 0) max = v;
+        }
+
+        if (min is null || max is null)
+            return (explicitFrom ?? 0.0, explicitFrom ?? 0.0); // empty range: zero bins
+
+        switch (min)
+        {
+            case DateTime dmin:
+            {
+                var step = ToTicks(stepVal);
+                if (step <= 0) return (explicitFrom ?? dmin, explicitTo ?? dmin);
+                var lo = dmin.Ticks / step * step;
+                var hi = ((DateTime)max).Ticks / step * step + step;
+                return (explicitFrom ?? new DateTime(lo, DateTimeKind.Utc), explicitTo ?? new DateTime(hi, DateTimeKind.Utc));
+            }
+            case TimeSpan tmin:
+            {
+                var step = ToTicks(stepVal);
+                if (step <= 0) return (explicitFrom ?? tmin, explicitTo ?? tmin);
+                var lo = (long)Math.Floor((double)tmin.Ticks / step) * step;
+                var hi = (long)Math.Floor((double)((TimeSpan)max).Ticks / step) * step + step;
+                return (explicitFrom ?? new TimeSpan(lo), explicitTo ?? new TimeSpan(hi));
+            }
+            default:
+            {
+                var step = ToDouble(stepVal);
+                var dmin = ToDouble(min);
+                var dmax = ToDouble(max);
+                if (step <= 0) return (explicitFrom ?? dmin, explicitTo ?? dmax);
+                return (explicitFrom ?? Math.Floor(dmin / step) * step, explicitTo ?? Math.Floor(dmax / step) * step + step);
+            }
+        }
+    }
+
     private static long ToTicks(object? v) => v switch
