+    /// <summary>
+    ///     Functions in <see cref="SeriesFunctions" /> are evaluated row by row from raw argument values. A tuple
+    ///     result becomes an <see cref="IRTupleScalarCallNode" /> holding one call per tuple column (arguments are
+    ///     translated afresh for each, so no IR node is shared); extend/project/print expand it into columns.
+    /// </summary>
+    private IRNode TranslateRowwiseFunctionCall(FunctionCallExpression node, Signature signature,
+        IReadOnlyList<Parameter> parameters, IRExpressionNode[] irArguments, SeriesFunctions.Compute compute)
+    {
+        IRExpressionNode[] TranslateArguments() =>
+            node.ArgumentList.Expressions.Select(a => (IRExpressionNode)a.Element.Accept(this)).ToArray();
+
+        var argumentTypes = irArguments.Select(a => a.ResultType).ToArray();
+        if (node.ResultType is TupleSymbol tuple)
+        {
+            var elements = tuple.Columns.Select((column, i) =>
+                (IRExpressionNode)new IRBuiltInScalarFunctionCallNode(signature,
+                    SeriesFunctions.ElementOverload(compute, i, column.Type, argumentTypes), parameters,
+                    IRListNode.From(i == 0 ? irArguments : TranslateArguments()), column.Type)).ToArray();
+            return new IRTupleScalarCallNode(tuple, elements, signature.Symbol.Name);
+        }
+
+        return new IRBuiltInScalarFunctionCallNode(signature,
+            SeriesFunctions.ElementOverload(compute, 0, node.ResultType, argumentTypes), parameters,
+            IRListNode.From(irArguments), node.ResultType);
+    }
