+using System.Linq;
+using AwesomeAssertions;
+
+namespace BasicTests;
+
+[TestClass]
+public class SeriesFunctionTests : TestMethods
+{
+    private static string Flat(int n, int spikeAt, int spike) =>
+        "dynamic([" + string.Join(",", Enumerable.Range(0, n).Select(i => i == spikeAt ? spike : 10)) + "])";
+
+    [TestMethod]
+    public async Task SeriesStats_Tuple()
+    {
+        var query = "print s=dynamic([1,2,3,4]) | extend (mn, mni, mx, mxi, a, v, sd) = series_stats(s) " +
+                    "| project mn, mni, mx, mxi, a, v";
+        var result = await ResultAsString(query);
+        result.Should().Be("1,0,4,3,2.5,1.6666666666666667");
+    }
+
+    [TestMethod]
+    public async Task SeriesStatsDynamic_Bag()
+    {
+        var query = "print s=dynamic([1,2,3,4]) | extend b = series_stats_dynamic(s) | project mx=b.max, a=b.avg";
+        var result = await ResultAsString(query);
+        result.Should().Be("4,2.5");
+    }
+
+    [TestMethod]
+    public async Task SeriesFitLine_PerfectLine()
+    {
+        var query = "print s=dynamic([1,3,5,7,9]) " +
+                    "| extend (rsquare, slope, variance, rvariance, interception, line_fit) = series_fit_line(s) " +
+                    "| project rsquare, slope, interception";
+        var result = await ResultAsString(query);
+        result.Should().Be("1,2,1");
+    }
+
+    [TestMethod]
+    public async Task SeriesFitLine_UnnamedColumns()
+    {
+        // Without names Kusto names the tuple columns itself (series_fit_line_s_rsquare, ...).
+        var query = "print s=dynamic([0,1,2]) | extend series_fit_line(s)";
+        var result = await Result(query);
+        result.ColumnDefinitions().Select(c => c.Name).Should().Contain("series_fit_line_s_slope");
+        result.ColumnCount.Should().Be(7);
+    }
+
+    [TestMethod]
+    public async Task SeriesOutliers_FlagsTheSpike()
+    {
+        var query = $"print s={Flat(20, 7, 100)} | extend o = series_outliers(s) " +
+                    "| mv-expand with_itemindex=i o to typeof(real) | where o > 1.5 | project i";
+        var result = await ResultAsString(query, ";");
+        result.Should().Be("7");
+    }
+
+    [TestMethod]
+    public async Task SeriesDecomposeAnomalies_FlatSeriesWithOneSpike()
+    {
+        var query = $"print s={Flat(48, 30, 80)} " +
+                    "| extend (flag, score, baseline) = series_decompose_anomalies(s) " +
+                    "| mv-expand with_itemindex=i flag to typeof(int) | where flag != 0 | project i, flag";
+        var result = await ResultAsString(query, ";");
+        result.Should().Be("30,1");
+    }
+
+    [TestMethod]
+    public async Task SeriesDecomposeAnomalies_DailySeasonality()
+    {
+        // 7 days of hourly points with a daily cycle (busy 08-18h) and one spike at hour 100 (a quiet hour): the
+        // seasonal baseline absorbs the cycle, so only the spike is flagged.
+        var values = Enumerable.Range(0, 168).Select(i =>
+        {
+            var h = i % 24;
+            var v = h is >= 8 and <= 18 ? 50 : 10;
+            return i == 100 ? v + 60 : v;
+        });
+        var series = "dynamic([" + string.Join(",", values) + "])";
+        var query = $"print s={series} | extend (flag, score, baseline) = series_decompose_anomalies(s, 1.5, -1, 'avg') " +
+                    "| mv-expand with_itemindex=i flag to typeof(int) | where flag != 0 | project i";
+        var result = await ResultAsString(query, ";");
+        result.Should().Be("100");
+    }
+
+    [TestMethod]
+    public async Task SeriesDecompose_SeasonalComponent()
+    {
+        var series = "dynamic([" + string.Join(",", Enumerable.Range(0, 40).Select(i => i % 4 == 0 ? 20 : 0)) + "])";
+        var query = $"print s={series} | extend (baseline, seasonal, trend, residual) = series_decompose(s) " +
+                    "| project r = series_stats_dynamic(residual).max, b0 = todouble(baseline[0]), b1 = todouble(baseline[1])";
+        var result = await ResultAsString(query);
+        result.Should().Be("0,20,0");
+    }
+
+    [TestMethod]
+    public async Task SeriesDecomposeAnomalies_AfterMakeSeries()
+    {
+        // The SOC idiom: make-series per hour, then flag the hour with the burst.
+        var rows = string.Join(",", Enumerable.Range(0, 24).SelectMany(h =>
+            Enumerable.Range(0, h == 15 ? 40 : 2).Select(_ => $"datetime(2026-10-01T{h:00}:10:00Z)")));
+        var query = $"datatable(t:datetime)[{rows}] | make-series n=count() on t step 1h " +
+                    "| extend (a, s, b) = series_decompose_anomalies(n) " +
+                    "| mv-expand with_itemindex=i a to typeof(int) | where a == 1 | project i";
+        var result = await ResultAsString(query, ";");
+        result.Should().Be("15");
+    }
+
+    [TestMethod]
+    public async Task TupleFunction_InProject()
+    {
+        var query = "print s=dynamic([2,4,6]) | project (r2, slope, v, rv, ic, lf) = series_fit_line(s) | project slope";
+        var result = await ResultAsString(query);
+        result.Should().Be("2");
+    }
+}
