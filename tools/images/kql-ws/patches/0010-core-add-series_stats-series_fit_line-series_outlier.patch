+using System;
+using System.Collections.Generic;
+using Kusto.Language.Symbols;
+
+namespace KustoLoco.Core.InternalRepresentation.Nodes.Expressions;
+
+/// <summary>
+///     A call to a scalar function that returns a tuple, e.g. <c>series_fit_line(s)</c> or
+///     <c>series_decompose_anomalies(s)</c>. It is never evaluated as a whole: extend, project and print replace it
+///     with its <see cref="Elements" />, one scalar call per tuple column, in column order.
+/// </summary>
+internal class IRTupleScalarCallNode : IRExpressionNode
+{
+    public IRTupleScalarCallNode(TupleSymbol tuple, IReadOnlyList<IRExpressionNode> elements, string functionName)
+        : base(tuple, elements.Count > 0 ? elements[0].ResultKind : EvaluatedExpressionKind.Scalar)
+    {
+        Elements = elements;
+        FunctionName = functionName;
+    }
+
+    public IReadOnlyList<IRExpressionNode> Elements { get; }
+    public string FunctionName { get; }
+
+    public override int ChildCount => Elements.Count;
+    public override IRNode GetChild(int index) => Elements[index];
+
+    public override TResult Accept<TResult, TContext>(IRNodeVisitor<TResult, TContext> visitor, TContext context)
+        => throw new NotSupportedException(
+            $"{FunctionName}() returns several columns; use it directly in extend, project or print, e.g. extend (a, b) = {FunctionName}(...)");
+}
