diff --git a/libraries/KustoLoco.Core/Evaluation/BuiltIns/Infra/RowwiseScalarFunctionImpl.cs b/libraries/KustoLoco.Core/Evaluation/BuiltIns/Infra/RowwiseScalarFunctionImpl.cs
new file mode 100644
index 00000000..1181c59f
--- /dev/null
+++ b/libraries/KustoLoco.Core/Evaluation/BuiltIns/Infra/RowwiseScalarFunctionImpl.cs
@@ -0,0 +1,66 @@
+//
+// Licensed under the MIT License.
+
+using System;
+using System.Text.Json.Nodes;
+using Kusto.Language.Symbols;
+using KustoLoco.Core.DataSource;
+using KustoLoco.Core.Extensions;
+using KustoLoco.Core.Util;
+
+namespace KustoLoco.Core.Evaluation.BuiltIns;
+
+/// <summary>
+///     A scalar function evaluated row by row over raw argument values. Used for functions whose arguments are
+///     mostly dynamic and optional (the series_* family), where generated typed overloads would add nothing.
+///     The computed value is converted to <see cref="ResultType" /> (real, long, int, bool, string or dynamic).
+/// </summary>
+internal sealed class RowwiseScalarFunctionImpl(Func<object?[], object?> compute, TypeSymbol resultType)
+    : IScalarFunctionImpl
+{
+    public TypeSymbol ResultType { get; } = resultType;
+
+    public ScalarResult InvokeScalar(ScalarResult[] arguments)
+    {
+        var values = new object?[arguments.Length];
+        for (var i = 0; i < arguments.Length; i++) values[i] = arguments[i].Value;
+        return new ScalarResult(ResultType, Convert(compute(values), ResultType));
+    }
+
+    public ColumnarResult InvokeColumnar(ColumnarResult[] arguments)
+    {
+        var rows = arguments.Length == 0 ? 0 : arguments[0].Column.RowCount;
+        var builder = ColumnHelpers.CreateBuilder(ResultType);
+        var values = new object?[arguments.Length];
+        for (var r = 0; r < rows; r++)
+        {
+            for (var i = 0; i < arguments.Length; i++) values[i] = arguments[i].Column.GetRawDataValue(r);
+            builder.Add(Convert(compute(values), ResultType));
+        }
+        return new ColumnarResult(builder.ToColumn());
+    }
+
+    public static object? Convert(object? value, TypeSymbol type)
+    {
+        if (value is null) return null;
+        var t = type.Simplify();
+        if (t == ScalarTypes.Real)
+            return value switch { double d => double.IsFinite(d) ? d : null, _ => System.Convert.ToDouble(value) };
+        if (t == ScalarTypes.Long) return System.Convert.ToInt64(value);
+        if (t == ScalarTypes.Int) return System.Convert.ToInt32(value);
+        if (t == ScalarTypes.Bool) return System.Convert.ToBoolean(value);
+        if (t == ScalarTypes.String) return value.ToString();
+        if (t == ScalarTypes.Dynamic)
+            return value switch
+            {
+                JsonNode n => n,
+                double d => double.IsFinite(d) ? JsonValue.Create(d) : null,
+                long l => JsonValue.Create(l),
+                int i => JsonValue.Create(i),
+                string s => JsonValue.Create(s),
+                bool b => JsonValue.Create(b),
+                _ => JsonValue.Create(value.ToString())
+            };
+        return value;
+    }
+}
diff --git a/libraries/KustoLoco.Core/Evaluation/BuiltIns/ScalarFunctions/SeriesMath.cs b/libraries/KustoLoco.Core/Evaluation/BuiltIns/ScalarFunctions/SeriesMath.cs
new file mode 100644
index 00000000..06ba6099
--- /dev/null
+++ b/libraries/KustoLoco.Core/Evaluation/BuiltIns/ScalarFunctions/SeriesMath.cs
@@ -0,0 +1,246 @@
+//
+// Licensed under the MIT License.
+
+using System;
+using System.Collections.Generic;
+using System.Linq;
+using System.Text.Json.Nodes;
+
+namespace KustoLoco.Core.Evaluation.BuiltIns.Impl;
+
+/// <summary>
+///     Numerical core of the series_* functions (series_stats, series_fit_line, series_outliers,
+///     series_decompose, series_decompose_anomalies). Series arrive as dynamic arrays; non-numeric or null elements
+///     are treated as missing (NaN) the way ADX ignores them in statistics.
+/// </summary>
+/// <remarks>
+///     The algorithms follow the ADX documentation: Tukey fences on the 10th/90th percentiles for outliers, a
+///     seasonal + trend baseline for decomposition, and anomalies flagged where the residual's outlier score exceeds
+///     the threshold. Seasonality auto-detection (seasonality = -1) uses the autocorrelation of the detrended series
+///     instead of ADX's periodogram, so scores are close to but not identical with ADX; clear anomalies get the same
+///     flags.
+/// </remarks>
+internal static class SeriesMath
+{
+    public static double[] ToSeries(JsonNode? node)
+    {
+        if (node is not JsonArray arr) return [];
+        var result = new double[arr.Count];
+        for (var i = 0; i < arr.Count; i++)
+            result[i] = arr[i] is JsonValue v && TryNumber(v, out var d) ? d : double.NaN;
+        return result;
+    }
+
+    private static bool TryNumber(JsonValue v, out double d)
+    {
+        if (v.TryGetValue(out d)) return true;
+        if (v.TryGetValue(out long l)) { d = l; return true; }
+        if (v.TryGetValue(out int i)) { d = i; return true; }
+        if (v.TryGetValue(out decimal m)) { d = (double)m; return true; }
+        if (v.TryGetValue(out bool b)) { d = b ? 1 : 0; return true; }
+        d = double.NaN;
+        return false;
+    }
+
+    public static JsonArray ToJson(IEnumerable<double> values) =>
+        new(values.Select(v => double.IsFinite(v) ? JsonValue.Create(v) : (JsonNode?)null).ToArray());
+
+    public static JsonArray ToJson(IEnumerable<int> values) =>
+        new(values.Select(v => (JsonNode?)JsonValue.Create(v)).ToArray());
+
+    // ---------------------------------------------------------------- series_stats
+    public record Stats(double Min, int MinIdx, double Max, int MaxIdx, double Avg, double Variance, double Stdev);
+
+    public static Stats ComputeStats(double[] s, bool ignoreNonFinite = false)
+    {
+        var finite = s.Select((v, i) => (v, i)).Where(p => double.IsFinite(p.v)).ToArray();
+        if (finite.Length == 0) return new Stats(double.NaN, -1, double.NaN, -1, double.NaN, double.NaN, double.NaN);
+        var min = finite.MinBy(p => p.v);
+        var max = finite.MaxBy(p => p.v);
+        var avg = finite.Average(p => p.v);
+        // sample variance, as ADX (n-1 in the denominator; 0 for a single point)
+        var variance = finite.Length > 1 ? finite.Sum(p => (p.v - avg) * (p.v - avg)) / (finite.Length - 1) : 0;
+        return new Stats(min.v, min.i, max.v, max.i, avg, variance, Math.Sqrt(variance));
+    }
+
+    public static JsonObject StatsToBag(Stats st) => new()
+    {
+        ["min"] = Num(st.Min), ["min_idx"] = st.MinIdx, ["max"] = Num(st.Max), ["max_idx"] = st.MaxIdx,
+        ["avg"] = Num(st.Avg), ["variance"] = Num(st.Variance), ["stdev"] = Num(st.Stdev)
+    };
+
+    public static JsonNode? Num(double v) => double.IsFinite(v) ? JsonValue.Create(v) : null;
+
+    // ---------------------------------------------------------------- series_fit_line
+    public record Line(double RSquare, double Slope, double Variance, double RVariance, double Interception, double[] Fit);
+
+    /// <summary>Least-squares line over x = 0..n-1 (missing points are skipped, as ADX does).</summary>
+    public static Line FitLine(double[] s)
+    {
+        var pts = s.Select((v, i) => (x: (double)i, y: v)).Where(p => double.IsFinite(p.y)).ToArray();
+        var n = pts.Length;
+        if (n == 0) return new Line(double.NaN, double.NaN, double.NaN, double.NaN, double.NaN, s.Select(_ => double.NaN).ToArray());
+        var mx = pts.Average(p => p.x);
+        var my = pts.Average(p => p.y);
+        var sxx = pts.Sum(p => (p.x - mx) * (p.x - mx));
+        var sxy = pts.Sum(p => (p.x - mx) * (p.y - my));
+        var slope = sxx == 0 ? 0 : sxy / sxx;
+        var icept = my - slope * mx;
+        var fit = Enumerable.Range(0, s.Length).Select(i => icept + slope * i).ToArray();
+        var variance = n > 1 ? pts.Sum(p => (p.y - my) * (p.y - my)) / (n - 1) : 0;
+        var rvariance = n > 1 ? pts.Sum(p => Math.Pow(p.y - (icept + slope * p.x), 2)) / (n - 1) : 0;
+        var rsquare = variance == 0 ? 1 : 1 - rvariance / variance;
+        return new Line(rsquare, slope, variance, rvariance, icept, fit);
+    }
+
+    // ---------------------------------------------------------------- series_outliers
+    /// <summary>
+    ///     Tukey-fence outlier score per point (ADX 'ctukey'): with p10/p90 the percentiles and IQR = p90 - p10,
+    ///     a point above p90 scores (x - p90) / IQR, below p10 scores (x - p10) / IQR, inside scores 0. ADX's
+    ///     'tukey' kind uses p25/p75. Points equal to ignoreVal (or missing) score 0.
+    /// </summary>
+    public static double[] Outliers(double[] s, string kind = "ctukey", double? ignoreVal = null,
+        double minPercentile = 10, double maxPercentile = 90)
+    {
+        if (string.Equals(kind, "tukey", StringComparison.OrdinalIgnoreCase))
+        {
+            minPercentile = 25;
+            maxPercentile = 75;
+        }
+        var vals = s.Where(v => double.IsFinite(v) && (ignoreVal is null || v != ignoreVal)).OrderBy(v => v).ToArray();
+        if (vals.Length == 0) return s.Select(_ => 0.0).ToArray();
+        var lo = Percentile(vals, minPercentile);
+        var hi = Percentile(vals, maxPercentile);
+        var iqr = hi - lo;
+        if (iqr <= 0)
+        {
+            // A flat series has no spread: fall back to a scale that makes any departure from it stand out.
+            var mad = vals.Select(v => Math.Abs(v - lo)).Where(d => d > 0).DefaultIfEmpty(0).Min();
+            iqr = mad > 0 ? mad / 10 : 1;
+            iqr = Math.Max(iqr, 1e-9);
+        }
+        return s.Select(v =>
+        {
+            if (!double.IsFinite(v) || (ignoreVal is not null && v == ignoreVal)) return 0.0;
+            if (v > hi) return (v - hi) / iqr;
+            if (v < lo) return (v - lo) / iqr;
+            return 0.0;
+        }).ToArray();
+    }
+
+    /// <summary>Percentile by linear interpolation between closest ranks (input sorted ascending).</summary>
+    public static double Percentile(double[] sorted, double p)
+    {
+        if (sorted.Length == 1) return sorted[0];
+        var rank = p / 100.0 * (sorted.Length - 1);
+        var lo = (int)Math.Floor(rank);
+        var hi = (int)Math.Ceiling(rank);
+        return sorted[lo] + (sorted[hi] - sorted[lo]) * (rank - lo);
+    }
+
+    // ---------------------------------------------------------------- series_decompose
+    public record Decomposition(double[] Baseline, double[] Seasonal, double[] Trend, double[] Residual);
+
+    /// <param name="seasonality">-1 = detect, 0 = none, n = period length in points</param>
+    /// <param name="trend">'avg' (constant mean), 'linefit' (least squares line) or 'none'</param>
+    /// <param name="testPoints">trailing points excluded from the fit (forecast region)</param>
+    public static Decomposition Decompose(double[] s, int seasonality = -1, string trend = "avg", int testPoints = 0)
+    {
+        var n = s.Length;
+        var train = Math.Max(0, n - Math.Max(0, testPoints));
+        var fill = FillMissing(s);
+
+        double[] trendArr;
+        switch (trend.ToLowerInvariant())
+        {
+            case "linefit":
+            {
+                var l = FitLine(fill.Take(train).ToArray());
+                trendArr = Enumerable.Range(0, n).Select(i => l.Interception + l.Slope * i).ToArray();
+                break;
+            }
+            case "none":
+                trendArr = new double[n];
+                break;
+            default:
+            {
+                var avg = train > 0 ? fill.Take(train).Average() : 0;
+                trendArr = Enumerable.Repeat(avg, n).ToArray();
+                break;
+            }
+        }
+
+        var detrended = fill.Select((v, i) => v - trendArr[i]).ToArray();
+        var period = seasonality < 0 ? DetectPeriod(detrended.Take(train).ToArray()) : seasonality;
+        var seasonal = new double[n];
+        if (period >= 2 && train >= 2 * period)
+        {
+            // seasonal component = median of each phase over the training part (robust to the anomalies we look for)
+            var phase = new double[period];
+            for (var p = 0; p < period; p++)
+            {
+                var values = new List<double>();
+                for (var i = p; i < train; i += period) values.Add(detrended[i]);
+                values.Sort();
+                phase[p] = values.Count == 0 ? 0 : Percentile(values.ToArray(), 50);
+            }
+            for (var i = 0; i < n; i++) seasonal[i] = phase[i % period];
+        }
+
+        var baseline = trendArr.Select((t, i) => t + seasonal[i]).ToArray();
+        var residual = s.Select((v, i) => double.IsFinite(v) ? v - baseline[i] : double.NaN).ToArray();
+        return new Decomposition(baseline, seasonal, trendArr, residual);
+    }
+
+    /// <summary>
+    ///     Period detection: autocorrelation r(lag) of the detrended series for lag 2..n/2; the period is the shortest
+    ///     lag that is a local maximum of r and within 90 % of the strongest correlation, provided that is clearly
+    ///     positive (> 0.3). Multiples of the true period correlate almost as well, hence "shortest". Returns 0 when
+    ///     no period stands out.
+    /// </summary>
+    public static int DetectPeriod(double[] x)
+    {
+        var n = x.Length;
+        if (n < 8) return 0;
+        var mean = x.Average();
+        var denom = x.Sum(v => (v - mean) * (v - mean));
+        if (denom <= 0) return 0;
+        var maxLag = n / 2;
+        var r = new double[maxLag + 2];
+        for (var lag = 1; lag <= maxLag + 1 && lag < n; lag++)
+        {
+            double num = 0;
+            for (var i = 0; i + lag < n; i++) num += (x[i] - mean) * (x[i + lag] - mean);
+            r[lag] = num / denom;
+        }
+        var rmax = Enumerable.Range(2, maxLag - 1).Select(l => r[l]).DefaultIfEmpty(0).Max();
+        if (rmax <= 0.3) return 0;
+        for (var lag = 2; lag <= maxLag; lag++)
+            if (r[lag] >= r[lag - 1] && r[lag] >= r[lag + 1] && r[lag] >= 0.9 * rmax)
+                return lag;
+        return 0;
+    }
+
+    private static double[] FillMissing(double[] s)
+    {
+        var finite = s.Where(double.IsFinite).ToArray();
+        var avg = finite.Length > 0 ? finite.Average() : 0;
+        return s.Select(v => double.IsFinite(v) ? v : avg).ToArray();
+    }
+
+    // ---------------------------------------------------------------- series_decompose_anomalies
+    public record Anomalies(int[] Flags, double[] Scores, double[] Baseline);
+
+    /// <summary>
+    ///     Decompose, then score the residual with Tukey fences (ctukey: p10/p90; tukey: p25/p75); a point whose
+    ///     |score| exceeds threshold is flagged +1 (above the baseline) or -1 (below).
+    /// </summary>
+    public static Anomalies DecomposeAnomalies(double[] s, double threshold = 1.5, int seasonality = -1,
+        string trend = "avg", int testPoints = 0, string method = "ctukey")
+    {
+        var d = Decompose(s, seasonality, trend, testPoints);
+        var scores = Outliers(d.Residual, method);
+        var flags = scores.Select(v => v > threshold ? 1 : v < -threshold ? -1 : 0).ToArray();
+        return new Anomalies(flags, scores, d.Baseline);
+    }
+}
diff --git a/libraries/KustoLoco.Core/Evaluation/BuiltIns/SeriesFunctions.cs b/libraries/KustoLoco.Core/Evaluation/BuiltIns/SeriesFunctions.cs
new file mode 100644
index 00000000..ef76dbdd
--- /dev/null
+++ b/libraries/KustoLoco.Core/Evaluation/BuiltIns/SeriesFunctions.cs
@@ -0,0 +1,106 @@
+//
+// Licensed under the MIT License.
+
+using System;
+using System.Collections.Generic;
+using System.Globalization;
+using System.Linq;
+using System.Text.Json.Nodes;
+using Kusto.Language;
+using Kusto.Language.Symbols;
+using KustoLoco.Core.Evaluation.BuiltIns.Impl;
+
+namespace KustoLoco.Core.Evaluation.BuiltIns;
+
+/// <summary>
+///     The series_* analysis functions: series_stats, series_stats_dynamic, series_fit_line,
+///     series_fit_line_dynamic, series_outliers, series_decompose, series_decompose_anomalies.
+/// </summary>
+/// <remarks>
+///     Several of these return a tuple in Kusto (<c>extend (flag, score, baseline) = series_decompose_anomalies(s)</c>).
+///     Each function is a <see cref="Compute" /> from the raw argument values (missing optional arguments are simply
+///     absent) to the tuple's values in column order; non-tuple functions return a single value. The translator
+///     (IRTranslator.VisitFunctionCallExpression) turns a tuple-returning call into one scalar call per tuple column.
+/// </remarks>
+internal static class SeriesFunctions
+{
+    public delegate object?[] Compute(object?[] args);
+
+    internal static readonly Dictionary<FunctionSymbol, Compute> Functions = new()
+    {
+        [Kusto.Language.Functions.SeriesStats] = a => StatsValues(SeriesMath.ComputeStats(Series(a), Bool(a, 1))),
+        [Kusto.Language.Functions.SeriesStatsDynamic] = a => [SeriesMath.StatsToBag(SeriesMath.ComputeStats(Series(a), Bool(a, 1)))],
+        [Kusto.Language.Functions.SeriesFitLine] = a => LineValues(SeriesMath.FitLine(Series(a))),
+        [Kusto.Language.Functions.SeriesFitLineDynamic] = a =>
+        {
+            var l = SeriesMath.FitLine(Series(a));
+            return
+            [
+                new JsonObject
+                {
+                    ["rsquare"] = SeriesMath.Num(l.RSquare), ["slope"] = SeriesMath.Num(l.Slope),
+                    ["variance"] = SeriesMath.Num(l.Variance), ["rvariance"] = SeriesMath.Num(l.RVariance),
+                    ["interception"] = SeriesMath.Num(l.Interception), ["line_fit"] = SeriesMath.ToJson(l.Fit)
+                }
+            ];
+        },
+        [Kusto.Language.Functions.SeriesOutliers] = a =>
+        [
+            SeriesMath.ToJson(SeriesMath.Outliers(Series(a), Str(a, 1, "ctukey"), NullableReal(a, 2),
+                Real(a, 3, 10), Real(a, 4, 90)))
+        ],
+        [Kusto.Language.Functions.SeriesDecompose] = a =>
+        {
+            var d = SeriesMath.Decompose(Series(a), Int(a, 1, -1), Str(a, 2, "avg"), Int(a, 3, 0));
+            return
+            [
+                SeriesMath.ToJson(d.Baseline), SeriesMath.ToJson(d.Seasonal), SeriesMath.ToJson(d.Trend),
+                SeriesMath.ToJson(d.Residual)
+            ];
+        },
+        [Kusto.Language.Functions.SeriesDecomposeAnomalies] = a =>
+        {
+            var r = SeriesMath.DecomposeAnomalies(Series(a), Real(a, 1, 1.5), Int(a, 2, -1), Str(a, 3, "avg"),
+                Int(a, 4, 0), Str(a, 5, "ctukey"));
+            return [SeriesMath.ToJson(r.Flags), SeriesMath.ToJson(r.Scores), SeriesMath.ToJson(r.Baseline)];
+        },
+    };
+
+    private static object?[] StatsValues(SeriesMath.Stats s) =>
+        [Nan(s.Min), s.MinIdx < 0 ? null : s.MinIdx, Nan(s.Max), s.MaxIdx < 0 ? null : s.MaxIdx, Nan(s.Avg),
+            Nan(s.Variance), Nan(s.Stdev)];
+
+    private static object?[] LineValues(SeriesMath.Line l) =>
+        [Nan(l.RSquare), Nan(l.Slope), Nan(l.Variance), Nan(l.RVariance), Nan(l.Interception), SeriesMath.ToJson(l.Fit)];
+
+    private static object? Nan(double d) => double.IsFinite(d) ? d : null;
+
+    private static double[] Series(object?[] a) => SeriesMath.ToSeries(a.Length > 0 ? a[0] as JsonNode : null);
+
+    // Optional arguments: absent, null, or the literal default are all "use the default".
+    private static object? Raw(object?[] a, int i)
+    {
+        var v = i < a.Length ? a[i] : null;
+        return v is JsonValue j ? j.GetValue<object>() : v;
+    }
+
+    private static double Real(object?[] a, int i, double def) =>
+        Raw(a, i) is { } v && v is not string ? Convert.ToDouble(v, CultureInfo.InvariantCulture) : def;
+
+    private static double? NullableReal(object?[] a, int i) =>
+        Raw(a, i) is { } v && v is not string ? Convert.ToDouble(v, CultureInfo.InvariantCulture) : null;
+
+    private static int Int(object?[] a, int i, int def) =>
+        Raw(a, i) is { } v && v is not string ? Convert.ToInt32(v, CultureInfo.InvariantCulture) : def;
+
+    private static bool Bool(object?[] a, int i) => Raw(a, i) is bool b && b;
+
+    private static string Str(object?[] a, int i, string def) =>
+        Raw(a, i) is string s && s.Length > 0 ? s : def;
+
+    /// <summary>Builds the scalar overload that computes tuple element <paramref name="index" />.</summary>
+    internal static ScalarOverloadInfo ElementOverload(Compute compute, int index, TypeSymbol elementType,
+        IEnumerable<TypeSymbol> argumentTypes) =>
+        new(new RowwiseScalarFunctionImpl(args => compute(args)[index], elementType), elementType,
+            argumentTypes.ToArray());
+}
diff --git a/libraries/KustoLoco.Core/InternalRepresentation/Nodes/Expressions/IRTupleScalarCallNode.cs b/libraries/KustoLoco.Core/InternalRepresentation/Nodes/Expressions/IRTupleScalarCallNode.cs
