+    /// <summary>
+    ///     The IR expressions an extend/project/print element contributes: one, or one per column for a call to a
+    ///     tuple-returning function (written bare or as <c>(a, b) = f(...)</c>).
+    /// </summary>
+    private List<IRExpressionNode> ExpandTuple(Expression expression)
+    {
+        var inner = expression is CompoundNamedExpression compound ? compound.Expression : expression;
+        var ir = (IRExpressionNode)inner.Accept(this);
+        if (ir is IRTupleScalarCallNode tuple) return tuple.Elements.ToList();
+        if (expression is CompoundNamedExpression)
+            throw new NotSupportedException("(a, b, ...) = expression requires a function that returns a tuple");
+        return [ir];
+    }
