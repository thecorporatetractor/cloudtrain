 .../ScalarFunctions/JsonArrayHelper.cs        | 163 ++++++++++++++----
 .../ScalarFunctions/ToTimespanFunction.cs     |   5 +
 .../ScalarFunctions/todatetimefunction.cs     |   6 +
 test/BasicTests/MakeSeriesOperatorTests.cs    |  60 +++++++
 4 files changed, 199 insertions(+), 35 deletions(-)

