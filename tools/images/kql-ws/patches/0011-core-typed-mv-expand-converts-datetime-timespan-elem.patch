         if (targetType == ScalarTypes.Dynamic) return node;
 
-        // Default: return the node as-is
+        if (targetType == ScalarTypes.String)
+            return node is JsonValue sv && TryGetPrimitive(sv) is string str ? str : node.ToString();
+
+        // Typed expansion is a conversion, like tolong()/todatetime(): the element may be held as the target CLR type
+        // (a JsonValue created in-process, e.g. by make-series), as a JSON string (an ISO datetime, "01:00:00") or as a
+        // JSON number. A value that cannot be converted becomes null, never the raw node.
+        if (node is not JsonValue value) return null;
+        var primitive = TryGetPrimitive(value);
+        if (primitive is null) return null;
+        try
+        {
+            if (targetType == ScalarTypes.Long) return ToLong(primitive);
+            if (targetType == ScalarTypes.Int) return ToLong(primitive) is { } l ? (int)l : null;
+            if (targetType == ScalarTypes.Real) return ToDouble(primitive);
+            if (targetType == ScalarTypes.Decimal)
+                return primitive switch
+                {
+                    string s => decimal.TryParse(s, NumberStyles.Float, CultureInfo.InvariantCulture, out var m) ? m : null,
+                    bool => null,
+                    DateTime or TimeSpan => null,
+                    _ => Convert.ToDecimal(primitive, CultureInfo.InvariantCulture)
+                };
+            if (targetType == ScalarTypes.Bool)
+                return primitive switch
+                {
+                    bool bo => bo,
+                    string s => bool.TryParse(s, out var bv) ? bv : null,
+                    DateTime or TimeSpan => null,
+                    _ => Convert.ToDouble(primitive, CultureInfo.InvariantCulture) != 0
+                };
+            if (targetType == ScalarTypes.Guid)
+                return primitive switch
+                {
+                    Guid g => g,
+                    string s => Guid.TryParse(s, out var gv) ? gv : null,
+                    _ => null
+                };
+            if (targetType == ScalarTypes.DateTime) return ToDateTime(primitive);
+            if (targetType == ScalarTypes.TimeSpan) return ToTimeSpan(primitive);
+        }
+        catch (Exception e) when (e is FormatException or InvalidCastException or OverflowException)
+        {
+            return null;
+        }
+
         return node;
     }
 
+    /// <summary>
+    ///     The CLR value behind a JsonValue, whether it wraps a parsed JsonElement or an in-process value.
+    /// </summary>
+    private static object? TryGetPrimitive(JsonValue value)
+    {
+        if (value.TryGetValue<JsonElement>(out var element))
+            return element.ValueKind switch
+            {
+                JsonValueKind.String => element.GetString(),
+                JsonValueKind.True => true,
+                JsonValueKind.False => false,
+                JsonValueKind.Number => element.TryGetInt64(out var l) ? l : element.GetDouble(),
+                _ => null
+            };
+        if (value.TryGetValue<string>(out var s)) return s;
+        if (value.TryGetValue<DateTime>(out var dt)) return dt;
+        if (value.TryGetValue<TimeSpan>(out var ts)) return ts;
+        if (value.TryGetValue<bool>(out var b)) return b;
+        if (value.TryGetValue<long>(out var lv)) return lv;
+        if (value.TryGetValue<int>(out var iv)) return (long)iv;
+        if (value.TryGetValue<double>(out var d)) return d;
+        if (value.TryGetValue<decimal>(out var m)) return m;
+        if (value.TryGetValue<Guid>(out var g)) return g;
+        return value.ToString();
+    }
+
+    private static long? ToLong(object v) => v switch
+    {
+        long l => l,
+        double d => double.IsFinite(d) ? (long)d : null,
+        decimal m => (long)m,
+        bool b => b ? 1 : 0,
+        string s => long.TryParse(s, NumberStyles.Integer, CultureInfo.InvariantCulture, out var l)
+            ? l
+            : double.TryParse(s, NumberStyles.Float, CultureInfo.InvariantCulture, out var d) && double.IsFinite(d)
+                ? (long)d
+                : null,
+        _ => null
+    };
+
+    private static double? ToDouble(object v) => v switch
+    {
+        long l => l,
+        double d => d,
+        decimal m => (double)m,
+        bool b => b ? 1 : 0,
+        string s => double.TryParse(s, NumberStyles.Float, CultureInfo.InvariantCulture, out var d) ? d : null,
+        _ => null
+    };
+
+    private static DateTime? ToDateTime(object v) => v switch
+    {
+        DateTime dt => dt.Kind == DateTimeKind.Local ? dt.ToUniversalTime() : DateTime.SpecifyKind(dt, DateTimeKind.Utc),
+        string s => DateTime.TryParse(s, CultureInfo.InvariantCulture,
+            DateTimeStyles.AssumeUniversal | DateTimeStyles.AdjustToUniversal, out var r)
+            ? r
+            : null,
+        _ => null
+    };
+
+    // A timespan held as a number is in ticks (make-series stores a timespan axis that way).
+    private static TimeSpan? ToTimeSpan(object v) => v switch
+    {
+        TimeSpan ts => ts,
+        long l => new TimeSpan(l),
+        double d => double.IsFinite(d) ? new TimeSpan((long)d) : null,
+        string s => TimeSpan.TryParse(s, CultureInfo.InvariantCulture, out var r) ? r : null,
+        _ => null
+    };
+
+    /// <summary>
+    ///     Converts a dynamic value to datetime the way todatetime() does (null when it is not a datetime).
+    /// </summary>
+    public static DateTime? DynamicToDateTime(JsonNode? node) =>
+        ConvertJsonNodeToValueOfTargetType(node, ScalarTypes.DateTime) as DateTime?;
+
+    /// <summary>
+    ///     Converts a dynamic value to timespan the way totimespan() does (null when it is not a timespan).
+    /// </summary>
+    public static TimeSpan? DynamicToTimeSpan(JsonNode? node) =>
+        ConvertJsonNodeToValueOfTargetType(node, ScalarTypes.TimeSpan) as TimeSpan?;
+
     /// <summary>
     ///     Convert a possible JsonArray to an object array of values of the target type.
     /// </summary>
