+
+    private static string HourlyBurst() =>
+        "datatable(TimeGenerated:datetime)[" + string.Join(",", Enumerable.Range(0, 24).SelectMany(h =>
+            Enumerable.Range(0, h == 15 ? 40 : 2).Select(_ => $"datetime(2026-10-01T{h:00}:10:00Z)"))) + "]";
+
+    [TestMethod]
+    public async Task MakeSeries_AnomalyIdiom_EndToEnd()
+    {
+        // The standard SOC idiom: series per hour, anomalies, then back to one row per point with typed columns.
+        var q = HourlyBurst() +
+                " | make-series n=count() default=0 on TimeGenerated step 1h" +
+                " | extend (flag, score, baseline) = series_decompose_anomalies(n)" +
+                " | mv-expand TimeGenerated to typeof(datetime), n to typeof(long), flag to typeof(int)" +
+                " | where flag == 1 | project TimeGenerated, n";
+        var result = await Result(q);
+        result.RowCount.Should().Be(1);
+        var row = result.GetRow(0);
+        row[0].Should().Be(new DateTime(2026, 10, 1, 15, 0, 0, DateTimeKind.Utc));
+        row[1].Should().Be(40L);
+        result.ColumnDefinitions()[0].UnderlyingType.Should().Be(typeof(DateTime));
+    }
+
+    [TestMethod]
+    public async Task MakeSeries_AxisUntypedMvExpand_ThenToDateTime()
+    {
+        var q = HourlyBurst() +
+                " | make-series n=count() default=0 on TimeGenerated step 1h" +
+                " | mv-expand TimeGenerated, n | extend t = todatetime(TimeGenerated), c = tolong(n)" +
+                " | where c == 40 | project t";
+        var result = await Result(q);
+        result.RowCount.Should().Be(1);
+        result.GetRow(0)[0].Should().Be(new DateTime(2026, 10, 1, 15, 0, 0, DateTimeKind.Utc));
+    }
+
+    [TestMethod]
+    public async Task MakeSeries_TimeSpanAxis_MvExpandToTimeSpan()
+    {
+        var q = "datatable(d:timespan, v:long)[0h,1, 1h,1, 1h,1] | make-series n=count() on d from 0h to 3h step 1h" +
+                " | mv-expand d to typeof(timespan), n to typeof(long) | where n == 2 | project d";
+        var result = await Result(q);
+        result.RowCount.Should().Be(1);
+        result.GetRow(0)[0].Should().Be(TimeSpan.FromHours(1));
+    }
+
+    [TestMethod]
+    public async Task MvExpand_TypedConversion_FromParsedJson()
+    {
+        // Elements of parsed JSON: ISO strings to datetime, "01:30:00" to timespan, numeric strings to long;
+        // what cannot be converted is null.
+        var q = "print d = parse_json('{\"t\":[\"2026-10-01T10:00:00Z\"],\"s\":[\"01:30:00\"],\"n\":[\"7\",\"x\"]}')" +
+                " | project t=d.t, s=d.s, n=d.n" +
+                " | mv-expand t to typeof(datetime), s to typeof(timespan), n to typeof(long)";
+        var result = await Result(q);
+        result.RowCount.Should().Be(2);
+        result.GetRow(0)[0].Should().Be(new DateTime(2026, 10, 1, 10, 0, 0, DateTimeKind.Utc));
+        result.GetRow(0)[1].Should().Be(TimeSpan.FromMinutes(90));
+        result.GetRow(0)[2].Should().Be(7L);
+        result.GetRow(1)[2].Should().BeNull();
+    }
