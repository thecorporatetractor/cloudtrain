+using AwesomeAssertions;
+using KustoLoco.Core;
+using NotNullStrings;
+
+namespace BasicTests;
+
+[TestClass]
+public class UnionOperatorTests : TestMethods
+{
+    public record ProcRow(string DeviceName, string FileName);
+
+    public record NetRow(string DeviceName, string RemoteIP);
+
+    public record SignRow(string UserPrincipalName, string IPAddress);
+
+    private static KustoQueryContext SocContext()
+    {
+        var context = CreateContext();
+        context.CopyDataIntoTable("DeviceProcessEvents",
+            new[] { new ProcRow("pc1", "a.exe"), new ProcRow("pc2", "b.exe") });
+        context.CopyDataIntoTable("DeviceNetworkEvents", new[] { new NetRow("pc1", "10.0.0.1") });
+        context.CopyDataIntoTable("SigninLogs", new[] { new SignRow("u@x", "10.0.0.1") });
+        return context;
+    }
+
+    private static async Task<string> Run(KustoQueryContext context, string query)
+    {
+        var result = await context.RunQuery(query);
+        result.Error.Should().BeEmpty();
+        return result.EnumerateRows()
+            .Select(r => string.Join(",", r.Select(KustoFormatter.ObjectToKustoString)))
+            .JoinString(";");
+    }
+
+    [TestMethod]
+    public async Task Wildcard_ExpandsToMatchingTables()
+    {
+        var result = await Run(SocContext(), "union Device* | count");
+        result.Should().Be("3");
+    }
+
+    [TestMethod]
+    public async Task Wildcard_WithSource_NamesEachRowsTable()
+    {
+        var result = await Run(SocContext(),
+            "union withsource=SourceTable Device* | summarize n=count() by SourceTable | order by SourceTable asc");
+        result.Should().Be("DeviceNetworkEvents,1;DeviceProcessEvents,2");
+    }
+
+    [TestMethod]
+    public async Task WithSource_ExplicitTables()
+    {
+        var result = await Run(SocContext(),
+            "union withsource=T SigninLogs, DeviceNetworkEvents | summarize n=count() by T | order by T asc");
+        result.Should().Be("DeviceNetworkEvents,1;SigninLogs,1");
+    }
+
+    [TestMethod]
+    public async Task WithSource_SubqueryIsNamedUnionArg()
+    {
+        var result = await Run(SocContext(),
+            "union withsource=T (SigninLogs | where IPAddress == '10.0.0.1'), DeviceNetworkEvents | project T | order by T asc");
+        result.Should().Be("DeviceNetworkEvents;union_arg0");
+    }
+
+    [TestMethod]
+    public async Task WithSource_PipedFormNamesTheLeftInput()
+    {
+        var result = await Run(SocContext(),
+            "SigninLogs | union withsource=T DeviceNetworkEvents | project T | order by T asc");
+        result.Should().Be("DeviceNetworkEvents;union_arg0");
+    }
+
+    [TestMethod]
+    public async Task KindInner_KeepsOnlyCommonColumns()
+    {
+        var result = await Run(SocContext(),
+            "union kind=inner DeviceProcessEvents, DeviceNetworkEvents | getschema | project ColumnName");
+        result.Should().Be("DeviceName");
+    }
+
+    [TestMethod]
+    public async Task KindInner_ReturnsAllRows()
+    {
+        var result = await Run(SocContext(), "union kind=inner DeviceProcessEvents, DeviceNetworkEvents | count");
+        result.Should().Be("3");
+    }
+
+    [TestMethod]
+    public async Task IsFuzzy_IgnoresMissingTables()
+    {
+        var result = await Run(SocContext(), "union isfuzzy=true SigninLogs, NoSuchTable | count");
+        result.Should().Be("1");
+    }
+
+    [TestMethod]
+    public async Task Wildcard_MixedWithExplicitTable()
+    {
+        var result = await Run(SocContext(), "union withsource=T Device*, SigninLogs | distinct T | count");
+        result.Should().Be("3");
+    }
+}
