+    /// <summary>
+    ///     union [kind=inner|outer] [withsource=Col] [isfuzzy=true] T1, T2*, (subquery) ...
+    /// </summary>
+    /// <remarks>
+    ///     Kusto.Language resolves a wildcarded name (Device*) to a GroupSymbol of the matching
+    ///     tables and computes the result schema (the withsource column first; for kind=inner it
+    ///     still reports every column, so the common ones are selected here). Here each group member becomes its own input,
+    ///     and every input remembers its source name for the withsource column: the table name,
+    ///     or union_arg{position} for anything that is not a plain table reference. With
+    ///     isfuzzy=true a name that resolves to nothing is skipped (Kusto reports it as a
+    ///     warning, KS205).
+    /// </remarks>
     public override IRNode VisitUnionOperator(UnionOperator node)
     {
-        var expressions = node.Expressions
-            .Select(expression => (IRExpressionNode)expression.Element.Accept(this))
-            .ToArray();
+        var sourceColumn = ParameterText(node.Parameters, "withsource")
+                           ?? ParameterText(node.Parameters, "source");
+        var expressions = new List<IRExpressionNode>();
+        var names = new List<string?>();
+        foreach (var element in node.Expressions)
+        {
+            var expression = element.Element;
+            switch (expression.ReferencedSymbol)
+            {
+                case GroupSymbol group:
+                    foreach (var table in group.Members.OfType<TableSymbol>())
+                    {
+                        expressions.Add(new IRNameReferenceNode(table, table));
+                        names.Add(table.Name);
+                    }
 
-        return new IRUnionOperatorNode(IRListNode.From(expressions), node.ResultType);
+                    break;
+                case TableSymbol table when expression is NameReference:
+                    expressions.Add((IRExpressionNode)expression.Accept(this));
+                    names.Add(table.Name);
+                    break;
+                case null when expression is NameReference:
+                    // unresolved name: only legal with isfuzzy=true (otherwise binding failed earlier)
+                    break;
+                default:
+                    expressions.Add((IRExpressionNode)expression.Accept(this));
+                    names.Add(null);
+                    break;
+            }
+        }
+
+        var resultType = (TableSymbol)node.ResultType;
+        if (string.Equals(ParameterText(node.Parameters, "kind"), "inner", StringComparison.OrdinalIgnoreCase))
+        {
+            // Kusto.Language reports the outer schema for kind=inner too; keep only the columns
+            // (name and type) present in every input, plus the withsource column.
+            var inputs = expressions.Select(e => e.ResultType).OfType<TableSymbol>().ToList();
+            if (node.Parent is PipeExpression pipe && pipe.Operator == node)
+                inputs.Add(_rowScope);
+            resultType = new TableSymbol(resultType.Columns.Where(c =>
+                c.Name == sourceColumn ||
+                inputs.All(t => t.Columns.Any(x => x.Name == c.Name && x.Type == c.Type))));
+        }
+
+        return new IRUnionOperatorNode(IRListNode.From(expressions.ToArray()), resultType,
+            sourceColumn, names.ToArray(), null);
+    }
+
+    /// <summary>The value of a named operator parameter (withsource=X -> "X"), or null.</summary>
+    private static string? ParameterText(SyntaxList<NamedParameter> parameters, string name)
+    {
+        var parameter = parameters
+            .FirstOrDefault(p => string.Equals(p.Name.SimpleName, name, StringComparison.OrdinalIgnoreCase));
+        return parameter?.Expression switch
+        {
+            null => null,
+            NameDeclaration declaration => declaration.SimpleName,
+            NameReference reference => reference.SimpleName,
+            var e => e.ToString().Trim()
+        };
     }
-}
