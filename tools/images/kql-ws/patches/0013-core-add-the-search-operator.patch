+
+using System;
+using System.Collections.Generic;
+using System.Linq;
+using System.Text;
+using System.Text.RegularExpressions;
+using Kusto.Language;
+using Kusto.Language.Symbols;
+using Kusto.Language.Syntax;
+using KustoLoco.Core.InternalRepresentation.Nodes.Expressions;
+using KustoLoco.Core.InternalRepresentation.Nodes.Expressions.QueryOperators;
+
+namespace KustoLoco.Core.InternalRepresentation;
+
+internal partial class IRTranslator
+{
+    private const string SearchInput = "__kustoloco_search_input";
+
+    /// <summary>
+    ///     search [kind=case_sensitive|case_insensitive] [in (T1, T2*, ...)] Predicate
+    ///     T | search Predicate
+    /// </summary>
+    /// <remarks>
+    ///     Translated to a union (with a $table source column) of one filter per table, so no new
+    ///     evaluator is needed. For each table the predicate is rewritten into ordinary KQL and
+    ///     bound against that table's schema:
+    ///     <list type="bullet">
+    ///         <item>a bare string term matches if any string column (or dynamic column, via tostring) has it;</item>
+    ///         <item>Col:"term" applies the same test to one column;</item>
+    ///         <item>
+    ///             wildcards: "abc*" = word prefix, "*abc" = word suffix, "*abc*" = substring,
+    ///             "a*c" = regex \ba.*c\b (Kusto's documented mapping);
+    ///         </item>
+    ///         <item>and / or / not() combine terms; any other predicate (Col == "x", Col > 5) is kept
+    ///         as written and is false for a table that lacks one of its columns.</item>
+    ///     </list>
+    ///     Terms are case-insensitive unless kind=case_sensitive. Limits: the rewritten predicate is
+    ///     bound against the query's global state, so a predicate that references a let-bound
+    ///     scalar is not supported; `search in (...)` tables are taken from the global state too
+    ///     (database tables, not let-bound tabular expressions).
+    /// </remarks>
+    public override IRNode VisitSearchOperator(SearchOperator node)
+    {
+        if (_globals == null)
+            throw new NotImplementedException("search requires the query's global state");
+        var caseSensitive = string.Equals(ParameterText(node.Parameters, "kind"), "case_sensitive",
+            StringComparison.OrdinalIgnoreCase);
+        var resultType = (TableSymbol)node.ResultType;
+        var sourceColumn = resultType.Columns.FirstOrDefault()?.Name ?? "$table";
+
+        // Piped form: filter the input; the union then adds the source column.
+        // T | search ...: the search is the pipe's operator (not merely the left side of one)
+        if (node.Parent is PipeExpression pipe && pipe.Operator == node)
+        {
+            var leftName = pipe.Expression is NameReference { ReferencedSymbol: TableSymbol t } ? t.Name : null;
+            var filter = SearchFilter(_rowScope, node.Condition, caseSensitive);
+            return new IRUnionOperatorNode(IRListNode.From(Array.Empty<IRExpressionNode>()), resultType,
+                sourceColumn, [], filter, leftName);
+        }
+
+        var tables = new List<TableSymbol>();
+        if (node.InClause != null)
+        {
+            foreach (var e in node.InClause.Expressions.Select(se => se.Element))
+            {
+                switch (e.ReferencedSymbol)
+                {
+                    case GroupSymbol g:
+                        tables.AddRange(g.Members.OfType<TableSymbol>());
+                        break;
+                    case TableSymbol t:
+                        tables.Add(t);
+                        break;
+                    default:
+                        throw new NotImplementedException($"search in (...): '{e.ToString().Trim()}' is not a table");
+                }
+            }
+        }
+        else
+        {
+            tables.AddRange(_globals.Database.Tables);
+        }
+
+        var expressions = new List<IRExpressionNode>();
+        var names = new List<string?>();
+        foreach (var table in tables.Distinct())
+        {
+            var filter = SearchFilter(table, node.Condition, caseSensitive);
+            expressions.Add(new IRPipeExpressionNode(new IRNameReferenceNode(table, table), filter, table));
+            names.Add(table.Name);
+        }
+
+        return new IRUnionOperatorNode(IRListNode.From(expressions.ToArray()), resultType, sourceColumn,
+            names.ToArray(), null);
+    }
+
+    /// <summary>The search predicate as a where-filter over one table's schema.</summary>
+    private IRFilterOperatorNode SearchFilter(TableSymbol table, Expression condition, bool caseSensitive)
+    {
+        var columns = table.Columns.ToArray();
+        var text = SearchPredicateText(condition, columns, caseSensitive);
+        var input = new TableSymbol(SearchInput, columns.Select(c => new ColumnSymbol(c.Name, c.Type)));
+        var globals = _globals!.WithDatabase(
+            new DatabaseSymbol(_globals.Database.Name, _globals.Database.Members.Append(input).ToArray()));
+        var code = KustoCode.ParseAndAnalyze($"{SearchInput} | where {text}", globals);
+        var errors = code.GetDiagnostics().Where(d => d.Severity == DiagnosticSeverity.Error).ToArray();
+        if (errors.Length > 0)
+            throw new InvalidOperationException(
+                $"search: could not bind the rewritten predicate '{text}': {errors[0].Message}");
+        var filterNode = code.Syntax.GetDescendants<FilterOperator>(_ => true).Single();
+        var oldRowScope = _rowScope;
+        _rowScope = table;
+        try
+        {
+            return (IRFilterOperatorNode)filterNode.Accept(this);
+        }
+        finally
+        {
+            _rowScope = oldRowScope;
+        }
+    }
+
+    private static string SearchPredicateText(Expression e, ColumnSymbol[] columns, bool cs)
+    {
+        switch (e)
+        {
+            case LiteralExpression { LiteralValue: string term }:
+                return AnyColumnMatches(term, columns, cs);
+            case ParenthesizedExpression p:
+                return $"({SearchPredicateText(p.Expression, columns, cs)})";
+            case BinaryExpression b when b.Kind == SyntaxKind.AndExpression:
+                return $"({SearchPredicateText(b.Left, columns, cs)} and {SearchPredicateText(b.Right, columns, cs)})";
+            case BinaryExpression b when b.Kind == SyntaxKind.OrExpression:
+                return $"({SearchPredicateText(b.Left, columns, cs)} or {SearchPredicateText(b.Right, columns, cs)})";
+            case BinaryExpression b when b.Kind == SyntaxKind.SearchExpression:
+            {
+                // Col:"term"
+                var name = (b.Left as NameReference)?.SimpleName;
+                var column = columns.FirstOrDefault(c => c.Name == name);
+                return column == null || b.Right is not LiteralExpression { LiteralValue: string t }
+                    ? "false"
+                    : ColumnMatches(column, t, cs);
+            }
+            case FunctionCallExpression f when f.Name.SimpleName == "not" && f.ArgumentList.Expressions.Count == 1:
+                return $"not({SearchPredicateText(f.ArgumentList.Expressions[0].Element, columns, cs)})";
+            default:
+            {
+                var names = columns.Select(c => c.Name).ToHashSet();
+                var missing = e.GetDescendants<NameReference>(_ => true)
+                    .Any(n => n.ReferencedSymbol is ColumnSymbol && !names.Contains(n.SimpleName));
+                return missing ? "false" : $"({e.ToString(IncludeTrivia.Minimal)})";
+            }
+        }
+    }
+
+    private static string AnyColumnMatches(string term, ColumnSymbol[] columns, bool cs)
+    {
+        var tests = columns
+            .Where(c => c.Type == ScalarTypes.String || c.Type == ScalarTypes.Dynamic)
+            .Select(c => ColumnMatches(c, term, cs))
+            .ToArray();
+        return tests.Length == 0 ? "false" : "(" + string.Join(" or ", tests) + ")";
+    }
+
+    private static string ColumnMatches(ColumnSymbol column, string term, bool cs)
+    {
+        var col = $"['{column.Name.Replace("'", "\\'")}']";
+        if (column.Type != ScalarTypes.String)
+            col = $"tostring({col})";
+        if (!term.Contains('*'))
+            return $"{col} {(cs ? "has_cs" : "has")} {Quote(term)}";
+        // Wildcards follow Kusto's mapping: abc* -> word prefix, *abc -> word suffix,
+        // *abc* -> substring, a*c -> \ba.*c\b. Implemented with regexes (the engine has no hasprefix).
+        var core = term.Trim('*');
+        var startsStar = term.StartsWith('*');
+        var endsStar = term.EndsWith('*');
+        var body = string.Join(".*", core.Split('*').Select(Regex.Escape));
+        var pattern = (startsStar, endsStar) switch
+        {
+            (true, true) => body,
+            (false, true) => $@"\b{body}",
+            (true, false) => $@"{body}\b",
+            _ => $@"\b{body}\b"
+        };
+        if (!cs)
+            pattern = "(?i)" + pattern;
+        return $"{col} matches regex {Quote(pattern)}";
+    }
+
+    private static string Quote(string s)
+    {
+        var sb = new StringBuilder("@\"");
+        sb.Append(s.Replace("\"", "\"\""));
+        sb.Append('"');
+        return sb.ToString();
+    }
+}
