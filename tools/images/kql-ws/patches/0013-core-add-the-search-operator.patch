+using AwesomeAssertions;
+using KustoLoco.Core;
+using NotNullStrings;
+
+namespace BasicTests;
+
+[TestClass]
+public class SearchOperatorTests : TestMethods
+{
+    public record SignRow(string UserPrincipalName, string IPAddress, long N);
+
+    public record NetRow(string DeviceName, string RemoteIP, string RemoteUrl);
+
+    public record AuditRow(string OperationName, string Target);
+
+    private static KustoQueryContext SocContext()
+    {
+        var context = CreateContext();
+        context.CopyDataIntoTable("SigninLogs", new[]
+        {
+            new SignRow("ada@corp.example", "198.51.100.7", 1),
+            new SignRow("bram@corp.example", "10.0.0.5", 2)
+        });
+        context.CopyDataIntoTable("DeviceNetworkEvents", new[]
+        {
+            new NetRow("pc1", "198.51.100.7", "cdn-x.example.org"),
+            new NetRow("pc2", "192.0.2.1", "intranet.corp.example")
+        });
+        context.CopyDataIntoTable("AuditLogs", new[] { new AuditRow("Add member to role", "svc-sync01") });
+        return context;
+    }
+
+    private static async Task<string> Run(KustoQueryContext context, string query)
+    {
+        var result = await context.RunQuery(query);
+        result.Error.Should().BeEmpty();
+        return result.EnumerateRows()
+            .Select(r => string.Join(",", r.Select(KustoFormatter.ObjectToKustoString)))
+            .JoinString(";");
+    }
+
+    [TestMethod]
+    public async Task BareTerm_SearchesEveryTable()
+    {
+        var result = await Run(SocContext(),
+            "search \"198.51.100.7\" | summarize n=count() by $table | order by $table asc");
+        result.Should().Be("DeviceNetworkEvents,1;SigninLogs,1");
+    }
+
+    [TestMethod]
+    public async Task BareTerm_IsCaseInsensitiveByDefault()
+    {
+        var result = await Run(SocContext(), "search \"ADD\" | project $table");
+        result.Should().Be("AuditLogs");
+    }
+
+    [TestMethod]
+    public async Task KindCaseSensitive()
+    {
+        var result = await Run(SocContext(), "search kind=case_sensitive \"ADD\" | count");
+        result.Should().Be("0");
+    }
+
+    [TestMethod]
+    public async Task InClause_LimitsTables()
+    {
+        var result = await Run(SocContext(), "search in (SigninLogs) \"198.51.100.7\" | project $table, UserPrincipalName");
+        result.Should().Be("SigninLogs,ada@corp.example");
+    }
+
+    [TestMethod]
+    public async Task InClause_Wildcard()
+    {
+        var result = await Run(SocContext(), "search in (Device*) \"pc2\" | project $table, DeviceName");
+        result.Should().Be("DeviceNetworkEvents,pc2");
+    }
+
+    [TestMethod]
+    public async Task ColumnScopedTerm()
+    {
+        // only the RemoteUrl column is searched, so the IP in SigninLogs does not match
+        var result = await Run(SocContext(), "search RemoteUrl:\"example\" | count");
+        result.Should().Be("2");
+    }
+
+    [TestMethod]
+    public async Task ColumnPredicate_FalseForTablesWithoutTheColumn()
+    {
+        var result = await Run(SocContext(), "search IPAddress == \"10.0.0.5\" | project $table, UserPrincipalName");
+        result.Should().Be("SigninLogs,bram@corp.example");
+    }
+
+    [TestMethod]
+    public async Task AndOfTerms()
+    {
+        var result = await Run(SocContext(), "search \"198.51.100.7\" and \"pc1\" | project $table");
+        result.Should().Be("DeviceNetworkEvents");
+    }
+
+    [TestMethod]
+    public async Task OrAndNot()
+    {
+        var result = await Run(SocContext(),
+            "search (\"ada\" or \"bram\" or \"pc1\") and not(UserPrincipalName:\"bram\") and not(DeviceName == \"pc1\") | project UserPrincipalName");
+        result.Should().Be("ada@corp.example");
+    }
+
+    [TestMethod]
+    public async Task Wildcards()
+    {
+        (await Run(SocContext(), "search \"intra*\" | count")).Should().Be("1");
+        (await Run(SocContext(), "search \"*sync01\" | count")).Should().Be("1");
+        (await Run(SocContext(), "search \"*-syn*\" | count")).Should().Be("1");
+        (await Run(SocContext(), "search \"cdn*org\" | count")).Should().Be("1");
+    }
+
+    [TestMethod]
+    public async Task Piped()
+    {
+        var result = await Run(SocContext(), "SigninLogs | search \"bram\" | project $table, UserPrincipalName");
+        result.Should().Be("SigninLogs,bram@corp.example");
+    }
+
+    [TestMethod]
+    public async Task PipedAfterOperators()
+    {
+        var result = await Run(SocContext(), "SigninLogs | where N > 0 | search \"ada\" | count");
+        result.Should().Be("1");
+    }
+
+    [TestMethod]
+    public async Task NumericPredicate()
+    {
+        var result = await Run(SocContext(), "search N > 1 | project UserPrincipalName");
+        result.Should().Be("bram@corp.example");
+    }
+}
