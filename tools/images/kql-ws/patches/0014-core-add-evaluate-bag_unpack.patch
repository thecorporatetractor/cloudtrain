@@ -0,0 +1,103 @@
+//
+// Licensed under the MIT License.
+
+using System;
+using System.Globalization;
+using System.Linq;
+using System.Text.Json.Nodes;
+using Kusto.Language.Symbols;
+using KustoLoco.Core.DataSource;
+using KustoLoco.Core.InternalRepresentation.Nodes.Expressions.QueryOperators;
+using KustoLoco.Core.Util;
+
+namespace KustoLoco.Core.Evaluation;
+
+internal partial class TreeEvaluator
+{
+    public override EvaluationResult VisitBagUnpackOperator(IRBagUnpackOperatorNode node, EvaluationContext context)
+    {
+        var source = context.Left.Value;
+        var sourceSchema = source.Type;
+        var resultSchema = (TableSymbol)node.ResultType;
+        var chunk = ChunkHelpers.Reassemble(source.GetData().ToArray());
+        var bags = ((ColumnarResult)node.Bag.Accept(this, context with { Chunk = chunk })).Column;
+
+        // per output column: the input column of that name (never the bag column itself unless the schema
+        // lists it) and the bag property it may come from
+        var plan = resultSchema.Columns.Select(c =>
+        {
+            var inputIdx = IndexOf(sourceSchema, c.Name);
+            var key = c.Name.StartsWith(node.Prefix, StringComparison.Ordinal)
+                ? c.Name.Substring(node.Prefix.Length)
+                : null;
+            if (key != null && node.IgnoredProperties.Contains(key))
+                key = null;
+            return (InputIdx: inputIdx, Key: key, c.Type);
+        }).ToArray();
+
+        var builders = ColumnHelpers.CreateBuildersForTable(resultSchema);
+        for (var row = 0; row < chunk.RowCount; row++)
+        {
+            var bag = bags.GetRawDataValue(row) as JsonObject;
+            for (var col = 0; col < plan.Length; col++)
+            {
+                var (inputIdx, key, type) = plan[col];
+                var inBag = key != null && bag != null && bag.ContainsKey(key);
+                object? value;
+                if (inputIdx >= 0 && inBag && !string.Equals(resultSchema.Columns[col].Name, node.SourceColumn))
+                {
+                    value = node.Conflict switch
+                    {
+                        BagUnpackConflict.ReplaceSource => ConvertBagValue(bag![key!], type),
+                        BagUnpackConflict.KeepSource => chunk.Columns[inputIdx].GetRawDataValue(row),
+                        _ => throw new InvalidOperationException(
+                            $"bag_unpack: property '{key}' conflicts with the existing column " +
+                            $"'{resultSchema.Columns[col].Name}' (use columnsConflict)")
+                    };
+                }
+                else if (inputIdx >= 0)
+                    value = chunk.Columns[inputIdx].GetRawDataValue(row);
+                else
+                    value = inBag ? ConvertBagValue(bag![key!], type) : null;
+
+                builders[col].Add(value);
+            }
+        }
+
+        var columns = builders.Select(b => b.ToColumn()).ToArray();
+        return TabularResult.CreateWithVisualisation(new InMemoryTableSource(resultSchema, columns),
+            context.Left.VisualizationState);
+    }
+
+    /// <summary>A bag property as a value of the output column's type (null when it does not convert).</summary>
+    private static object? ConvertBagValue(JsonNode? value, TypeSymbol type)
+    {
+        if (value == null)
+            return null;
+        if (type == ScalarTypes.Dynamic)
+            return value.DeepClone();
+        var text = value is JsonValue v && v.TryGetValue<string>(out var s) ? s : value.ToJsonString();
+        var inv = CultureInfo.InvariantCulture;
+        if (type == ScalarTypes.String)
+            return text;
+        if (type == ScalarTypes.Long)
+            return long.TryParse(text, NumberStyles.Integer, inv, out var l) ? l
+                : double.TryParse(text, NumberStyles.Float, inv, out var dl) ? (long)dl : null;
+        if (type == ScalarTypes.Int)
+            return int.TryParse(text, NumberStyles.Integer, inv, out var i) ? i : null;
+        if (type == ScalarTypes.Real)
+            return double.TryParse(text, NumberStyles.Float, inv, out var d) ? d : null;
+        if (type == ScalarTypes.Decimal)
+            return decimal.TryParse(text, NumberStyles.Float, inv, out var m) ? m : null;
+        if (type == ScalarTypes.Bool)
+            return bool.TryParse(text, out var b) ? b : null;
+        if (type == ScalarTypes.DateTime)
+            return DateTime.TryParse(text, inv, DateTimeStyles.AdjustToUniversal | DateTimeStyles.AssumeUniversal,
+                out var t) ? t : null;
+        if (type == ScalarTypes.TimeSpan)
+            return TimeSpan.TryParse(text, inv, out var ts) ? ts : null;
+        if (type == ScalarTypes.Guid)
+            return Guid.TryParse(text, out var g) ? g : null;
+        return null;
+    }
+}
