+//
+// Licensed under the MIT License.
+
+using System;
+using System.Collections.Generic;
+using Kusto.Language.Symbols;
+
+namespace KustoLoco.Core.InternalRepresentation.Nodes.Expressions.QueryOperators;
+
+internal enum BagUnpackConflict
+{
+    Error,
+    ReplaceSource,
+    KeepSource
+}
+
+// evaluate bag_unpack(Column [, OutputColumnPrefix] [, columnsConflict] [, ignoredProperties]) : (schema)
+// The output schema (ResultType) is always explicit by the time it reaches the IR: either written by the user or
+// discovered from the data before translation (see BagUnpackSchema). Each output column is filled from the input
+// column of the same name, or from the bag property named (column name minus prefix).
+internal class IRBagUnpackOperatorNode : IRQueryOperatorNode
+{
+    public IRBagUnpackOperatorNode(IRExpressionNode bag, string? sourceColumn, string prefix,
+        BagUnpackConflict conflict, IReadOnlySet<string> ignoredProperties, TypeSymbol resultType)
+        : base(resultType)
+    {
+        Bag = bag ?? throw new ArgumentNullException(nameof(bag));
+        SourceColumn = sourceColumn;
+        Prefix = prefix;
+        Conflict = conflict;
+        IgnoredProperties = ignoredProperties;
+    }
+
+    public IRExpressionNode Bag { get; }
+
+    /// The input column holding the bag (null when the bag is an expression); it is not copied to the output
+    /// unless the output schema lists it.
+    public string? SourceColumn { get; }
+
+    public string Prefix { get; }
+    public BagUnpackConflict Conflict { get; }
+    public IReadOnlySet<string> IgnoredProperties { get; }
+
+    public override int ChildCount => 1;
+
+    public override IRNode GetChild(int index) =>
+        index == 0 ? Bag : throw new ArgumentOutOfRangeException(nameof(index));
+
+    public override TResult Accept<TResult, TContext>(IRNodeVisitor<TResult, TContext> visitor, TContext context)
+        => visitor.VisitBagUnpackOperator(this, context);
+
+    public override string ToString() => $"BagUnpackOperator: {SchemaDisplay.GetText(ResultType)}";
+}
diff --git a/libraries/KustoLoco.Core/InternalRepresentation/Translation/BagUnpackSchema.cs b/libraries/KustoLoco.Core/InternalRepresentation/Translation/BagUnpackSchema.cs
new file mode 100644
index 00000000..115f0642
--- /dev/null
+++ b/libraries/KustoLoco.Core/InternalRepresentation/Translation/BagUnpackSchema.cs
@@ -0,0 +1,161 @@
+//
+// Licensed under the MIT License.
+
+using System;
+using System.Collections.Generic;
+using System.Linq;
+using System.Text;
+using System.Text.Json;
+using System.Text.Json.Nodes;
+using Kusto.Language;
+using Kusto.Language.Symbols;
+using Kusto.Language.Syntax;
+using KustoLoco.Core.InternalRepresentation.Nodes.Expressions.QueryOperators;
+
+namespace KustoLoco.Core.InternalRepresentation;
+
+/// <summary>The arguments of bag_unpack(Column [, OutputColumnPrefix] [, columnsConflict] [, ignoredProperties]).</summary>
+internal record BagUnpackArguments(
+    Expression Bag,
+    string Prefix,
+    BagUnpackConflict Conflict,
+    IReadOnlySet<string> IgnoredProperties)
+{
+    public static bool IsBagUnpack(EvaluateOperator node) =>
+        string.Equals(node.FunctionCall.Name.SimpleName, "bag_unpack", StringComparison.OrdinalIgnoreCase);
+
+    public static BagUnpackArguments Parse(FunctionCallExpression call)
+    {
+        var args = call.ArgumentList.Expressions.Select(e => e.Element).ToArray();
+        if (args.Length == 0)
+            throw new InvalidOperationException("bag_unpack requires the column to unpack");
+        var prefix = "";
+        var conflict = BagUnpackConflict.Error;
+        var ignored = new HashSet<string>();
+        var positional = 0;
+        foreach (var arg in args.Skip(1))
+        {
+            var (name, value) = arg is SimpleNamedExpression named
+                ? (named.Name.SimpleName.ToLowerInvariant(), named.Expression)
+                : (positional++ switch { 0 => "outputcolumnprefix", 1 => "columnsconflict", _ => "ignoredproperties" }, arg);
+            switch (name)
+            {
+                case "outputcolumnprefix":
+                    prefix = value.ConstantValue as string ?? value.LiteralValue as string ?? "";
+                    break;
+                case "columnsconflict":
+                    conflict = (value.ConstantValue as string ?? value.LiteralValue as string) switch
+                    {
+                        "replace_source" => BagUnpackConflict.ReplaceSource,
+                        "keep_source" => BagUnpackConflict.KeepSource,
+                        "error" or null => BagUnpackConflict.Error,
+                        var other => throw new InvalidOperationException(
+                            $"bag_unpack: unknown columnsConflict '{other}' (error, replace_source, keep_source)")
+                    };
+                    break;
+                case "ignoredproperties":
+                    foreach (var p in ParseStringArray(value))
+                        ignored.Add(p);
+                    break;
+                default:
+                    throw new InvalidOperationException($"bag_unpack: unknown argument '{name}'");
+            }
+        }
+
+        return new BagUnpackArguments(args[0], prefix, conflict, ignored);
+    }
+
+    private static IEnumerable<string> ParseStringArray(Expression e)
+    {
+        var text = e is DynamicExpression d ? d.LiteralValue as string ?? "" : e.ToString().Trim();
+        JsonNode? node;
+        try
+        {
+            node = JsonNode.Parse(text);
+        }
+        catch (JsonException)
+        {
+            // Kusto accepts single-quoted strings in dynamic literals
+            node = JsonNode.Parse(text.Replace('\'', '"'));
+        }
+
+        return node is JsonArray a ? a.Select(x => x?.ToString() ?? "") : [];
+    }
+}
+
+/// <summary>
+///     Schema discovery for `evaluate bag_unpack` without an output schema.
+/// </summary>
+/// <remarks>
+///     The plugin's output columns depend on the data (one per bag key), which Kusto.Language cannot know: it
+///     types the operator as its input minus the bag column and types later references to unpacked columns as
+///     `unknown`. Before translation, every bag_unpack without a schema clause is therefore resolved: its input
+///     (the pipe's left side, with the statements before it) is run with the bag column projected, the keys are
+///     collected in order of first appearance, and the query text is rewritten with an explicit schema clause
+///     `: (input columns..., prefix+key:dynamic, ...)`. The rewritten query is parsed again, so everything after
+///     the plugin binds against real columns. Unpacked columns are dynamic, as in Kusto.
+///     Limits: the input must be expressible on its own (it cannot reference parameters of an enclosing
+///     user-defined function); the input is evaluated twice.
+/// </remarks>
+internal static class BagUnpackSchema
+{
+    public static EvaluateOperator? FirstUnresolved(KustoCode code) =>
+        code.Syntax.GetDescendants<EvaluateOperator>(e => e.Schema == null && BagUnpackArguments.IsBagUnpack(e))
+            .FirstOrDefault();
+
+    /// <param name="runKeys">runs a discovery query and returns the values of its single string column</param>
+    public static string Rewrite(string query, EvaluateOperator node, Func<string, IReadOnlyList<string>> runKeys)
+    {
+        if (node.Parent is not PipeExpression pipe || pipe.Operator != node)
+            throw new InvalidOperationException("evaluate bag_unpack must be applied to a piped input");
+        var args = BagUnpackArguments.Parse(node.FunctionCall);
+
+        // statements before the one containing the plugin (let definitions the input may use)
+        var statement = node.GetFirstAncestor<Statement>(_ => true);
+        var block = node.GetFirstAncestor<QueryBlock>(_ => true);
+        var prior = new StringBuilder();
+        if (block != null && statement != null)
+            foreach (var s in block.Statements.Select(se => se.Element))
+            {
+                if (s == statement)
+                    break;
+                prior.Append(s.ToString(IncludeTrivia.Minimal)).Append(";\n");
+            }
+
+        var discovery =
+            $"{prior}{pipe.Expression.ToString(IncludeTrivia.Minimal)}\n" +
+            $"| project __kl_bag = {args.Bag.ToString(IncludeTrivia.Minimal)}\n" +
+            "| serialize __kl_row = row_number()\n" +
+            "| mv-expand __kl_key = bag_keys(__kl_bag) to typeof(string)\n" +
+            "| where isnotempty(__kl_key)\n" +
+            "| summarize __kl_first = min(__kl_row) by __kl_key\n" +
+            "| order by __kl_first asc\n" +
+            "| project __kl_key";
+        var keys = runKeys(discovery);
+
+        // the plugin's input columns (Kusto.Language already removed the bag column)
+        var inputColumns = ((TableSymbol)node.FunctionCall.ResultType).Columns.ToList();
+        var names = inputColumns.Select(c => c.Name).ToHashSet();
+        var columns = inputColumns.Select(c => (c.Name, Type: c.Type.Name)).ToList();
+        foreach (var key in keys.Where(k => !args.IgnoredProperties.Contains(k)))
+        {
+            var name = args.Prefix + key;
+            if (names.Contains(name))
+            {
+                if (args.Conflict == BagUnpackConflict.Error)
+                    throw new InvalidOperationException(
+                        $"bag_unpack: property '{key}' conflicts with the existing column '{name}' " +
+                        "(use columnsConflict='replace_source' or 'keep_source', or an OutputColumnPrefix)");
+                continue; // the existing column stays where it is; the evaluator picks the value
+            }
+
+            names.Add(name);
+            columns.Add((name, "dynamic"));
+        }
+
+        var schema = " : (" + string.Join(", ",
+            columns.Select(c => $"['{c.Name.Replace("\\", "\\\\").Replace("'", "\\'")}']:{c.Type}")) + ")";
+        var at = node.FunctionCall.End;
+        return query.Substring(0, at) + schema + query.Substring(at);
+    }
+}
diff --git a/libraries/KustoLoco.Core/InternalRepresentation/Translation/IRTranslator.BagUnpack.cs b/libraries/KustoLoco.Core/InternalRepresentation/Translation/IRTranslator.BagUnpack.cs
new file mode 100644
