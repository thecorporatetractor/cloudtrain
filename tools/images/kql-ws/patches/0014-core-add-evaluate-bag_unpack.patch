@@ -0,0 +1,22 @@
+//
+// Licensed under the MIT License.
+
+using System;
+using Kusto.Language.Syntax;
+
+namespace KustoLoco.Core.InternalRepresentation;
+
+internal partial class IRTranslator
+{
+    /// <summary>Dispatches `evaluate plugin(...)` to the plugin's translation.</summary>
+    public override IRNode VisitEvaluateOperator(EvaluateOperator node)
+    {
+        var pluginName = node.FunctionCall.Name.SimpleName;
+        return pluginName.ToLowerInvariant() switch
+        {
+            "ipv4_lookup" or "ipv6_lookup" => TranslateIpLookup(node, pluginName),
+            "bag_unpack" => TranslateBagUnpack(node),
+            _ => throw new NotImplementedException($"evaluate plugin '{pluginName}' is not supported.")
+        };
+    }
+}
