--- /dev/null
+++ b/libraries/KustoLoco.Core/InternalRepresentation/Translation/IRTranslator.BagUnpack.cs
@@ -0,0 +1,31 @@
+//
+// Licensed under the MIT License.
+
+using System;
+using Kusto.Language.Syntax;
+using KustoLoco.Core.InternalRepresentation.Nodes.Expressions;
+using KustoLoco.Core.InternalRepresentation.Nodes.Expressions.QueryOperators;
+
+namespace KustoLoco.Core.InternalRepresentation;
+
+internal partial class IRTranslator
+{
+    /// <summary>
+    ///     evaluate bag_unpack(Column [, OutputColumnPrefix] [, columnsConflict] [, ignoredProperties]) : (schema)
+    /// </summary>
+    /// <remarks>
+    ///     The schema clause is required here: a query without one has been rewritten with the discovered
+    ///     schema before translation (BagUnpackSchema), so node.ResultType is the real output schema.
+    /// </remarks>
+    private IRNode TranslateBagUnpack(EvaluateOperator node)
+    {
+        if (node.Schema == null)
+            throw new InvalidOperationException(
+                "bag_unpack: the output schema was not resolved (run the query through KustoQueryContext)");
+        var args = BagUnpackArguments.Parse(node.FunctionCall);
+        var bag = (IRExpressionNode)args.Bag.Accept(this);
+        var sourceColumn = args.Bag is NameReference nr ? nr.SimpleName : null;
+        return new IRBagUnpackOperatorNode(bag, sourceColumn, args.Prefix, args.Conflict, args.IgnoredProperties,
+            node.ResultType);
+    }
+}
diff --git a/libraries/KustoLoco.Core/InternalRepresentation/Translation/IRTranslator.Evaluate.cs b/libraries/KustoLoco.Core/InternalRepresentation/Translation/IRTranslator.Evaluate.cs
