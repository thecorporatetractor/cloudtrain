+using AwesomeAssertions;
+
+namespace BasicTests;
+
+[TestClass]
+public class BagUnpackTests : TestMethods
+{
+    private const string Data =
+        "datatable(id:long, d:dynamic)[" +
+        "1, dynamic({\"os\":\"Windows 11\",\"browser\":\"Edge\"}), " +
+        "2, dynamic({\"os\":\"MacOs\",\"compliant\":true}), " +
+        "3, dynamic(null)]";
+
+    [TestMethod]
+    public async Task KeysFromAllRows_InOrderOfFirstAppearance()
+    {
+        var result = await Result(Data + " | evaluate bag_unpack(d)");
+        result.Error.Should().BeEmpty();
+        string.Join(",", result.ColumnNames()).Should().Be("id,os,browser,compliant");
+        var rows = await ResultAsString(Data + " | evaluate bag_unpack(d)", ";");
+        rows.Should().Be("1,Windows 11,Edge,<null>;2,MacOs,<null>,true;3,<null>,<null>,<null>");
+    }
+
+    [TestMethod]
+    public async Task UnpackedColumnsAreUsableDownstream()
+    {
+        var result = await ResultAsString(
+            Data + " | evaluate bag_unpack(d) | where tostring(os) startswith 'Win' | project id, browser");
+        result.Should().Be("1,Edge");
+    }
+
+    [TestMethod]
+    public async Task Prefix()
+    {
+        var result = await Result(Data + " | evaluate bag_unpack(d, 'dev_') | project id, dev_os");
+        result.Error.Should().BeEmpty();
+        (await ResultAsString(Data + " | evaluate bag_unpack(d, 'dev_') | project id, dev_os", ";"))
+            .Should().Be("1,Windows 11;2,MacOs;3,<null>");
+    }
+
+    private const string Conflicting =
+        "datatable(os:string, d:dynamic)['input', dynamic({\"os\":\"bag\",\"x\":1}), 'only', dynamic({\"x\":2})]";
+
+    [TestMethod]
+    public async Task Conflict_ErrorByDefault()
+    {
+        var result = await Result(Conflicting + " | evaluate bag_unpack(d)");
+        result.Error.Should().Contain("conflicts");
+    }
+
+    [TestMethod]
+    public async Task Conflict_ReplaceSource()
+    {
+        var result = await ResultAsString(
+            Conflicting + " | evaluate bag_unpack(d, columnsConflict='replace_source') | project os, x", ";");
+        result.Should().Be("bag,1;only,2");
+    }
+
+    [TestMethod]
+    public async Task Conflict_KeepSource()
+    {
+        var result = await ResultAsString(
+            Conflicting + " | evaluate bag_unpack(d, columnsConflict='keep_source') | project os, x", ";");
+        result.Should().Be("input,1;only,2");
+    }
+
+    [TestMethod]
+    public async Task TypedSchema()
+    {
+        var query = "datatable(id:long, d:dynamic)[1, dynamic({\"n\":\"42\",\"name\":\"a\",\"extra\":1})]" +
+                    " | evaluate bag_unpack(d) : (id:long, name:string, n:long, absent:string)";
+        var result = await Result(query);
+        result.Error.Should().BeEmpty();
+        string.Join(",", result.ColumnNames()).Should().Be("id,name,n,absent");
+        (await ResultAsString(query + " | extend twice = n * 2", ";")).Should().Be("1,a,42,,84");
+    }
+
+    [TestMethod]
+    public async Task InputAfterLetStatements()
+    {
+        var query = "let t = " + Data + "; t | where id < 3 | evaluate bag_unpack(d) | summarize count() by tostring(os)";
+        var result = await Result(query);
+        result.Error.Should().BeEmpty();
+        result.RowCount.Should().Be(2);
+    }
+
+    [TestMethod]
+    public async Task ParsedJsonExpression()
+    {
+        // Kusto requires a column, so a parsed string is extended first
+        var query = "datatable(s:string)['{\"k\":\"v\"}'] | extend b = parse_json(s) | evaluate bag_unpack(b)";
+        (await ResultAsString(query)).Should().Be("{\"k\":\"v\"},v");
+    }
+}
