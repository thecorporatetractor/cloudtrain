diff --git a/libraries/KustoLoco.Core/InternalRepresentation/Nodes/Expressions/QueryOperators/IRBagUnpackOperatorNode.cs b/libraries/KustoLoco.Core/InternalRepresentation/Nodes/Expressions/QueryOperators/IRBagUnpackOperatorNode.cs
