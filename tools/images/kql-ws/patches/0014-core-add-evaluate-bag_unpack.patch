diff --git a/libraries/KustoLoco.Core/Evaluation/TreeEvaluator.QueryOperators.BagUnpack.cs b/libraries/KustoLoco.Core/Evaluation/TreeEvaluator.QueryOperators.BagUnpack.cs
new file mode 100644
