diff --git a/libraries/lokql-engine/lokql-engine.csproj b/libraries/lokql-engine/lokql-engine.csproj
index 8722b955..aaaedb2a 100644
--- a/libraries/lokql-engine/lokql-engine.csproj
+++ b/libraries/lokql-engine/lokql-engine.csproj
@@ -21,7 +21,7 @@
 
   <ItemGroup>
     <PackageReference Include="Avalonia" />
-    <ProjectReference Include="..\AppInsightsSupport\AppInsightsSupport.csproj" />
+    <ProjectReference Include="..\AppInsightsSupport\AppInsightsSupport.csproj" Condition="'$(LokqlAzureConnectors)' != 'false'" />
     <ProjectReference Include="..\CopilotSupport\CopilotSupport.csproj" />
     <ProjectReference Include="..\FileFormats\FileFormats.csproj" />
     <ProjectReference Include="..\KustoLoco.Geo\KustoLoco.Geo.csproj" />
@@ -30,4 +30,15 @@
     <ProjectReference Include="..\Rendering\Rendering.csproj" />
   </ItemGroup>
 
+  <!-- LokqlAzureConnectors=false leaves out the commands that query Azure services (.adx,
+       .loganalytics, .appinsights, .arg, .defender) and with them AppInsightsSupport and the
+       Microsoft.Azure.Kusto.Data / Kusto.Cloud.Platform packages, for builds that must not
+       redistribute those packages. -->
+  <PropertyGroup Condition="'$(LokqlAzureConnectors)' == 'false'">
+    <DefineConstants>$(DefineConstants);NO_AZURE_CONNECTORS</DefineConstants>
+  </PropertyGroup>
+  <ItemGroup Condition="'$(LokqlAzureConnectors)' == 'false'">
+    <Compile Remove="Commands\AdxCommand.cs;Commands\AppInsightsCommand.cs;Commands\ArgCommand.cs;Commands\LogAnalyticsCommand.cs;Commands\DefenderCommand.cs" />
+  </ItemGroup>
+
 </Project>
