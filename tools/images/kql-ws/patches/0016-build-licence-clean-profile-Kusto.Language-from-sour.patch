 libraries/KustoLoco.Core/KustoLoco.Core.csproj      |  6 +++++-
 libraries/lokql-engine/Commands/CommandProcessor.cs |  6 ++++++
 libraries/lokql-engine/Commands/LoadGeoCommand.cs   |  3 +--
 .../lokql-engine/Commands/LoadUserAgentCommand.cs   |  3 +--
 libraries/lokql-engine/lokql-engine.csproj          | 13 ++++++++++++-
 test/LokqlEngineTests/BlockInterpolationTests.cs    |  1 -
 6 files changed, 25 insertions(+), 7 deletions(-)

diff --git a/libraries/KustoLoco.Core/KustoLoco.Core.csproj b/libraries/KustoLoco.Core/KustoLoco.Core.csproj
index 1a919b55..3f139ccb 100644
--- a/libraries/KustoLoco.Core/KustoLoco.Core.csproj
+++ b/libraries/KustoLoco.Core/KustoLoco.Core.csproj
@@ -34,7 +34,11 @@
     <PackageReference Include="CommunityToolkit.HighPerformance" />
     <PackageReference Include="Fastenshtein" />
     <PackageReference Include="geohash-dotnet" />
-    <PackageReference Include="Microsoft.Azure.Kusto.Language" />
+    <!-- KustoLanguageProject=<path to Kusto.Language.csproj>: build against Kusto.Language
+         compiled from source (github.com/microsoft/Kusto-Query-Language, Apache-2.0) instead
+         of the Microsoft.Azure.Kusto.Language package (Azure Data Explorer SDK licence terms) -->
+    <PackageReference Include="Microsoft.Azure.Kusto.Language" Condition="'$(KustoLanguageProject)' == ''" />
+    <ProjectReference Include="$(KustoLanguageProject)" Condition="'$(KustoLanguageProject)' != ''" />
     <PackageReference Include="NotNullStrings" />
     <PackageReference Include="System.Linq.Async" />
     <PackageReference Include="T-Digest.NET" />
