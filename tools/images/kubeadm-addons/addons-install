#!/bin/bash
# /opt/cloudtrain/bin/addons-install <addon>[,<addon>...] [--wait] [--pool <first-last>]
#
# Runtime contract (kubeadm driver, post-init hook): run on the control plane after
# `kubeadm init` and cni-install. Applies add-ons baked into this image from
# /opt/cloudtrain/addons/<name>/ (sha256 recorded at build time and checked here); every
# image they use is preloaded in containerd, so no registry is needed.
#
#   metrics-server  metrics-server (--kubelet-insecure-tls: lab kubelets use self-signed certs)
#   gateway-api     Gateway API standard CRDs
#   traefik         Traefik: IngressClass "traefik" (default) + GatewayClass "traefik"
#                   (implies gateway-api); entry points :80/:443, Service LoadBalancer with
#                   NodePorts 30080/30443 (works without a load balancer too)
#   metallb         MetalLB (L2) with IPAddressPool "lab" = --pool (default
#                   192.168.100.200-192.168.100.220, in the lab VPC subnet)
#   local-path      local-path-provisioner, StorageClass "local-path" (default class)
#   falco           Falco DaemonSet (modern eBPF), alerts in `kubectl -n falco logs ds/falco`
#   csi-hostpath    CSI hostpath driver hostpath.csi.k8s.io (volume expansion, capacity
#                   tracking; single node: volumes live on the node running the plugin),
#                   StorageClass "csi-hostpath" (allowVolumeExpansion, not the default)
# Aliases: ingress, gateway -> traefik; lb -> metallb; storage -> local-path; all = every
# add-on except falco and csi-hostpath. Idempotent (kubectl apply). Waits for the cluster
# network on every node before it applies an add-on with pods; --wait on metrics-server also
# waits for the metrics API (APIService v1beta1.metrics.k8s.io Available).
set -euo pipefail
ROOT=/opt/cloudtrain/addons
export KUBECONFIG=${KUBECONFIG:-/etc/kubernetes/admin.conf}
usage() { sed -n '2,24p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2; }
[[ $# -ge 1 ]] || usage
list=$1; shift
wait=0; pool=192.168.100.200-192.168.100.220
while [[ $# -gt 0 ]]; do
  case $1 in --wait) wait=1 ;; --pool) pool=${2:?}; shift ;; *) usage ;; esac; shift
done
want=()
for a in ${list//,/ }; do
  case $a in
    ingress|gateway) a=traefik ;; lb) a=metallb ;; storage) a=local-path ;;
    all) want+=(metrics-server gateway-api traefik metallb local-path); continue ;;
  esac
  [[ -d $ROOT/$a ]] || { echo "addons-install: unknown add-on '$a' (have: $(ls $ROOT | tr '\n' ' '))" >&2; exit 2; }
  [[ $a == traefik ]] && want+=(gateway-api)
  want+=("$a")
done
(cd "$ROOT" && sha256sum --quiet -c SHA256SUMS) || { echo "addons-install: add-on manifests do not match SHA256SUMS" >&2; exit 1; }
# cni_ready: wait (up to 4 min) until the cluster network runs on every node, so add-on pods
# get pod-network addresses. With Calico (cni-install): one Ready calico-node pod per node;
# with another CNI: every node Ready.
cni_ready() {
  local n r
  for _ in $(seq 120); do
    n=$(kubectl get nodes --no-headers 2>/dev/null | wc -l)
    if kubectl -n kube-system get ds calico-node >/dev/null 2>&1; then
      r=$(kubectl -n kube-system get pods -l k8s-app=calico-node \
        -o jsonpath='{range .items[*]}{.status.conditions[?(@.type=="Ready")].status}{"\n"}{end}' 2>/dev/null | grep -c '^True$' || true)
    else
      r=$(kubectl get nodes -o jsonpath='{range .items[*]}{.status.conditions[?(@.type=="Ready")].status}{"\n"}{end}' 2>/dev/null | grep -c '^True$' || true)
    fi
    ((n > 0 && r >= n)) && return 0
    sleep 2
  done
  echo "addons-install: the cluster network is not ready on all nodes ($r/$n)" >&2
  return 1
}
# metrics_api: the metrics API is served (APIService Available: the API server reaches
# metrics-server through its Service), not just a Ready pod. A pod that started off the pod
# network is Ready but unreachable, so it is recreated once.
metrics_api() {
  local api=apiservice/v1beta1.metrics.k8s.io
  kubectl wait --for=condition=Available "$api" --timeout=300s >/dev/null && return 0
  echo "addons-install: $api not Available, recreating the metrics-server pod" >&2
  kubectl -n kube-system get pods -l k8s-app=metrics-server -o wide >&2 || true
  kubectl -n kube-system delete pod -l k8s-app=metrics-server --wait=false >/dev/null
  kubectl -n kube-system rollout status deploy/metrics-server --timeout=180s
  kubectl wait --for=condition=Available "$api" --timeout=180s >/dev/null
}
for a in "${want[@]}"; do
  [[ $a == gateway-api ]] && continue   # CRDs only, no pods
  cni_ready; break
done
done_list=" "
for a in "${want[@]}"; do
  [[ $done_list == *" $a "* ]] && continue; done_list+="$a "
  case $a in
    gateway-api) kubectl apply --server-side -f "$ROOT/gateway-api/standard-install.yaml" >/dev/null
                 kubectl wait --for=condition=Established crd/gateways.gateway.networking.k8s.io crd/httproutes.gateway.networking.k8s.io --timeout=60s >/dev/null ;;
    traefik)     kubectl create namespace traefik --dry-run=client -o yaml | kubectl apply -f - >/dev/null
                 kubectl apply --server-side -f "$ROOT/traefik/traefik-crds.yaml" >/dev/null
                 kubectl apply -f "$ROOT/traefik/traefik.yaml" >/dev/null ;;
    metallb)     kubectl apply -f "$ROOT/metallb/metallb-native.yaml" >/dev/null
                 kubectl -n metallb-system rollout status deploy/controller --timeout=180s >/dev/null
                 for i in $(seq 30); do
                   kubectl apply -f - >/dev/null 2>&1 <<Y && break
apiVersion: metallb.io/v1beta1
kind: IPAddressPool
metadata: { name: lab, namespace: metallb-system }
spec: { addresses: ["$pool"] }
---
apiVersion: metallb.io/v1beta1
kind: L2Advertisement
metadata: { name: lab, namespace: metallb-system }
spec: { ipAddressPools: [lab] }
Y
                   sleep 3   # the webhook needs a moment after the controller is up
                 done ;;
    *)           kubectl apply -f "$ROOT/$a/" >/dev/null ;;
  esac
  echo "addons-install: $a applied"
done
if ((wait)); then
  for a in "${want[@]}"; do
    case $a in
      metrics-server) kubectl -n kube-system rollout status deploy/metrics-server --timeout=300s
                      metrics_api ;;
      traefik)        kubectl -n traefik rollout status deploy/traefik --timeout=300s ;;
      metallb)        kubectl -n metallb-system rollout status ds/speaker --timeout=300s ;;
      local-path)     kubectl -n local-path-storage rollout status deploy/local-path-provisioner --timeout=300s ;;
      falco)          kubectl -n falco rollout status ds/falco --timeout=300s ;;
      csi-hostpath)   kubectl -n kube-system rollout status sts/csi-hostpathplugin --timeout=300s
                      # registered with the kubelet (CSINode) before anyone provisions
                      for _ in $(seq 60); do
                        kubectl get csinode -o jsonpath='{.items[*].spec.drivers[*].name}' | grep -qw hostpath.csi.k8s.io && break
                        sleep 2
                      done ;;
    esac
  done
fi
