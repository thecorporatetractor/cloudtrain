# CloudTrain sample AppArmor profile for CKS labs: deny all file writes.
# Load:   apparmor_parser -r /opt/cloudtrain/security/apparmor/k8s-deny-write
# Use:    spec.securityContext.appArmorProfile: { type: Localhost, localhostProfile: k8s-deny-write }
#include <tunables/global>
profile k8s-deny-write flags=(attach_disconnected) {
  #include <abstractions/base>
  file,
  deny /** w,
}
