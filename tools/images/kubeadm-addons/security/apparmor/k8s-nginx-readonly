# CloudTrain sample AppArmor profile: a web server that may read its content and write
# only its pid/cache/log paths; no raw network, no mount, no ptrace.
#include <tunables/global>
profile k8s-nginx-readonly flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>
  #include <abstractions/nameservice>
  network inet tcp,
  network inet6 tcp,
  deny network raw,
  deny mount,
  deny ptrace,
  capability chown, capability dac_override, capability setgid, capability setuid, capability net_bind_service,
  /** r,
  /usr/sbin/nginx ix,
  /usr/local/apache2/bin/httpd ix,
  /bin/** ix, /usr/bin/** ix, /usr/local/bin/** ix,
  /var/cache/** rw, /var/run/** rw, /run/** rw, /tmp/** rw, /var/log/** w,
  /usr/local/apache2/logs/** rw,
  deny /etc/** w, deny /usr/share/** w,
}
