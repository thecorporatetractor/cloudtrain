#!/bin/sh
# PID 1 child of tini in the tier-A learner pods. Runs lab hooks, then waits.
#   /etc/cloudtrain/init.d/*   executable hooks a lab's setup can drop (run at every start)
# sshd is not started here: labs that need it run `/usr/sbin/sshd` themselves
# (ssh-keygen -A first). There is no systemd in a tier-A pod.
for h in /etc/cloudtrain/init.d/*; do [ -x "$h" ] && "$h"; done
exec sleep infinity
