#!/bin/sh
# PID 1 entry of the tier-B systemd pod images (deb-sys, el-sys; docs/kata-spike.md 4.2).
# They run only in a Kata sandbox: the orchestrator refuses them without a sandbox
# RuntimeClass (internal/drivers/sandbox.go), so "privileged" is the guest VM's.
#
# 1. An empty leaf cgroup "init" next to the cgroups systemd creates. On cgroup v2 a cgroup
#    that delegates controllers to children cannot hold processes; systemd delegates below the
#    container's cgroup, so kata-agent could not place exec'd processes (kubectl exec, the
#    orchestrator's setup and checks, the readiness probe) and every exec failed with EBUSY.
#    kata-agent puts them into <container>/init/ when it exists (kata PR 10845, the dind
#    convention). systemd names its own cgroup init.scope, so this one is free.
# 2. The guest's loop and device-mapper nodes: with privileged_without_host_devices the
#    container gets its own /dev, without them (losetup, LVM, mdadm on loop files).
if [ -f /sys/fs/cgroup/cgroup.controllers ]; then mkdir -p /sys/fs/cgroup/init 2>/dev/null || true; fi
for i in 0 1 2 3 4 5 6 7; do [ -e /dev/loop$i ] || mknod /dev/loop$i b 7 $i 2>/dev/null; done
[ -e /dev/loop-control ] || mknod /dev/loop-control c 10 237 2>/dev/null
mkdir -p /dev/mapper; [ -e /dev/mapper/control ] || mknod /dev/mapper/control c 10 236 2>/dev/null
[ -e /dev/md0 ] || mknod /dev/md0 b 9 0 2>/dev/null
exec /sbin/init "$@"
