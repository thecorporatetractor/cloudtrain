# ct-batch.sh settings. Slot limits and PAR_VM/PAR_POD are re-read before every dispatch
# (ct-autoscale.sh moves the slot limits; on the r8i.8xlarge it went 4 -> 20 heavy and 12 -> 40
# pod); the rest at cycle start.
CT_SLOTS_HEAVY=4
CT_SLOTS_POD=12
PAR_VM=3
PAR_POD=3
READY_TIMEOUT=45m
CYCLE_SLEEP=900
RECONCILES=64
# Image refresh: when a sync changes image inputs, rebuild just the affected images through the build
# slot, load them into kind and requeue their labs (read at cycle start). 0 = only record the change in
# state/images-stale.txt. A failed build is retried after IMG_FAIL_BASE s, doubling to IMG_FAIL_MAX, and
# dropped after IMG_MAX_TRIES failures (ct-batch.sh images <target> retries by hand).
AUTO_IMAGE_REFRESH=1
IMG_FAIL_BASE=900
IMG_FAIL_MAX=21600
IMG_MAX_TRIES=5
IMG_BUILD_TIMEOUT=3h
IMG_REQUEUE=1
IMG_MIN_FREE_GB=100
