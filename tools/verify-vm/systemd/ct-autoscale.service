[Unit]
Description=CloudTrain batch verifier adaptive slot limits
After=ct-batch.service
RequiresMountsFor=/srv/ct-work

[Service]
User=ubuntu
Environment=HOME=/home/ubuntu
Environment=PATH=/home/ubuntu/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/srv/ct-work/vm-config/ct-autoscale.sh
Restart=always
RestartSec=60

[Install]
WantedBy=multi-user.target
