[Unit]
Description=CloudTrain batch verifier (labctl verify + exam runs, resumable)
After=docker.service network-online.target ct-metrics.service
Wants=network-online.target
RequiresMountsFor=/srv/ct-work /var/lib/containerd

[Service]
User=ubuntu
Environment=HOME=/home/ubuntu
Environment=PATH=/home/ubuntu/.local/bin:/usr/local/go/bin:/usr/local/bin:/usr/bin:/bin
Environment=GOTOOLCHAIN=go1.27.3
ExecStart=/srv/ct-work/vm-config/ct-batch.sh loop
Restart=always
RestartSec=60
KillMode=process
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
