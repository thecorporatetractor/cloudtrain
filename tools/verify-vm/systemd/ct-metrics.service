[Unit]
Description=CloudTrain verify VM host metrics sampler
After=docker.service
RequiresMountsFor=/srv/ct-work
[Service]
User=ubuntu
Environment=PATH=/home/ubuntu/.local/bin:/usr/local/go/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/srv/ct-work/vm-config/ct-metrics.sh 10
Restart=always
[Install]
WantedBy=multi-user.target
