[Unit]
Description=CloudTrain verify VM status.json writer
After=ct-metrics.service
RequiresMountsFor=/srv/ct-work

[Service]
User=ubuntu
Environment=HOME=/home/ubuntu
Environment=PATH=/home/ubuntu/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/srv/ct-work/vm-config/ct-status.sh 60
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
